<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.GridItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/padding_p3"
    android:paddingVertical="?attr/templateGridItemViewPadding">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/grid_item_image_container"
        android:layout_width="?attr/templateGridItemImageSizeSmall"
        android:layout_height="?attr/templateGridItemImageSizeSmall">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_gravity="center"
            android:id="@+id/grid_item_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
        <FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/grid_item_image_frame_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:id="@+id/grid_item_image"
                android:layout_width="?attr/templateGridItemImageSizeSmall"
                android:layout_height="?attr/templateGridItemImageSizeSmall"
                android:scaleType="fitCenter"
                app:strokeColor="@null"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/notification_badge"
                android:background="@drawable/grid_item_notification_badge"
                android:visibility="gone"
                android:layout_width="?attr/templateGridItemNotificationBadgeSizeSmall"
                android:layout_height="?attr/templateGridItemNotificationBadgeSizeSmall"
                android:layout_marginTop="?attr/templateGridItemNotificationBadgeMarginSmall"
                android:layout_marginRight="?attr/templateGridItemNotificationBadgeMarginSmall"
                app:layout_constraintEnd_toEndOf="@+id/grid_item_image"
                app:layout_constraintTop_toTopOf="@+id/grid_item_image"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/grid_item_icon_badge"
                android:visibility="invisible"
                android:layout_width="?attr/templateGridItemIconBadgeSizeSmall"
                android:layout_height="?attr/templateGridItemIconBadgeSizeSmall"
                app:strokeColor="@null"
                style="?attr/templateGridItemIconBadgeStyle"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/grid_item_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/grid_item_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_0"
            android:maxWidth="?attr/templateGridItemTextContainerMaxWidth"
            style="?attr/templateGridItemTitleStyle"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/grid_item_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/templateGridItemTextStyle"/>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.GridItemView>
