<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.sdk.ui.MaxWidthLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rail_background"
    android:background="0x7f0800fe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:carMaxWidth="@dimen/rail_max_width">
    <com.google.android.projection.gearhead.rail.ui.SlidableLinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/rail"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.projection.gearhead.rail.ui.ImageButtonWithAlphaFade
            android:id="@+id/maps_icon"
            android:background="@drawable/rail_icon_background"
            android:focusable="true"
            android:layout_width="@dimen/rail_icon_width"
            android:layout_height="match_parent"
            android:src="0x7f0804f7"
            android:scaleType="center"
            app:alphaNormal="@dimen/rail_icon_alpha_normal"
            app:alphaSelected="@dimen/rail_icon_alpha_selected"
            app:fadeColor="@color/rail_icon_color"
            app:fadeDuration="@dimen/rail_icon_fade_duration_ms"
            app:foregroundColor="@color/rail_icon_color"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"/>
        <com.google.android.projection.gearhead.rail.ui.ImageButtonWithAlphaFade
            android:id="@+id/phone_icon"
            android:background="@drawable/rail_icon_background"
            android:padding="@dimen/rail_icon_inset"
            android:focusable="true"
            android:layout_width="@dimen/rail_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/ic_phone_vector"
            android:scaleType="fitCenter"
            app:alphaNormal="@dimen/rail_icon_alpha_normal"
            app:alphaSelected="@dimen/rail_icon_alpha_selected"
            app:fadeColor="@color/rail_icon_color"
            app:fadeDuration="@dimen/rail_icon_fade_duration_ms"
            app:foregroundColor="@color/rail_icon_color"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"/>
        <com.google.android.projection.gearhead.rail.ui.ImageButtonWithAlphaFade
            android:id="@+id/overview_icon"
            android:background="@drawable/rail_icon_background"
            android:padding="@dimen/rail_icon_inset"
            android:focusable="true"
            android:layout_width="@dimen/rail_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/ic_overview"
            android:scaleType="fitCenter"
            app:alphaNormal="@dimen/rail_icon_alpha_normal"
            app:alphaSelected="@dimen/rail_icon_alpha_selected"
            app:fadeColor="@color/overview_icon_color"
            app:fadeDuration="@dimen/rail_icon_fade_duration_ms"
            app:foregroundColor="@color/overview_icon_color"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"/>
        <com.google.android.projection.gearhead.rail.ui.ImageButtonWithAlphaFade
            android:id="@+id/music_icon"
            android:background="@drawable/rail_icon_background"
            android:focusable="true"
            android:layout_width="@dimen/rail_icon_width"
            android:layout_height="match_parent"
            android:src="0x7f0805fa"
            android:scaleType="center"
            app:alphaNormal="@dimen/rail_icon_alpha_normal"
            app:alphaSelected="@dimen/rail_icon_alpha_selected"
            app:fadeColor="@color/rail_icon_color"
            app:fadeDuration="@dimen/rail_icon_fade_duration_ms"
            app:foregroundColor="@color/rail_icon_color"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"/>
        <com.google.android.projection.gearhead.rail.ui.ImageButtonWithAlphaFade
            android:id="@+id/paw_icon"
            android:background="@drawable/rail_icon_background"
            android:focusable="true"
            android:layout_width="@dimen/rail_icon_width"
            android:layout_height="match_parent"
            android:src="0x7f0804bc"
            android:scaleType="center"
            app:alphaNormal="@dimen/rail_icon_alpha_normal"
            app:alphaSelected="@dimen/rail_icon_alpha_selected"
            app:fadeColor="@color/rail_icon_color"
            app:fadeDuration="@dimen/rail_icon_fade_duration_ms"
            app:foregroundColor="@color/rail_icon_color"/>
    </com.google.android.projection.gearhead.rail.ui.SlidableLinearLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.Body"
        android:textColor="@android:color/white"
        android:layout_gravity="center"
        android:id="@+id/watermark"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:alpha="0.5"/>
</com.google.android.apps.auto.sdk.ui.MaxWidthLayout>
