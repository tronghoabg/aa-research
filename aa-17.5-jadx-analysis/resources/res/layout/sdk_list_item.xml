<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:background="@drawable/gearhead_sdk_masked_ripple_background"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gearhead_sdk_list_item_height">
    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="@dimen/gearhead_sdk_list_item_icon_size"
        android:layout_height="@dimen/gearhead_sdk_list_item_icon_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/gearhead_sdk_list_item_icon_right_margin">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/text_container"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_centerVertical="true">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_sdk_text_vertical_margin"
            android:singleLine="true"
            android:layout_alignParentStart="true"
            style="@style/GearheadSdkBody1"/>
        <FrameLayout
            android:id="@+id/remoteviews"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_below="@+id/title"
            android:layout_toEndOf="@+id/remoteviews"
            style="@style/GearheadSdkBody2"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/right_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/gearhead_sdk_list_item_right_icon_margin"
        android:layout_alignParentEnd="true"/>
</LinearLayout>
