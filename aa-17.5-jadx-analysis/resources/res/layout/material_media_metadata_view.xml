<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.metadataview.MetadataView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/metadata"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/content_image"
        android:layout_width="@dimen/material_metadata_media_image_size"
        android:layout_height="@dimen/material_metadata_media_image_size"
        android:layout_marginBottom="@dimen/metadata_port_image_margin_end"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/metadata_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="@integer/title_max_lines"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metadata_text_container_margin">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/icon_holder"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/metadata_icon_margin"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/metadata_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/tertiary_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/icon_tertiary_holder"
            android:paddingTop="@dimen/metadata_tertiary_icon_padding"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/metadata_icon_margin"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/metadata_tertiary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/metadata_time_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metadata_text_container_margin">
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="end"
            android:id="@+id/metadata_elapsed_time"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/metadata_time_divider"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metadata_time_divider_margin"
            android:layout_marginRight="@dimen/metadata_time_divider_margin"
            android:maxLines="1"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="start"
            android:id="@+id/metadata_total_time"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/media_seekbar"
        android:background="@color/transparent_black"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/metadata_extra_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metadata_secondary_text_container_margin"
        android:maxLines="1"
        android:layout_marginStart="@dimen/common_keyline_1"
        android:layout_marginEnd="@dimen/common_keyline_1"/>
</com.google.android.apps.auto.components.metadataview.MetadataView>
