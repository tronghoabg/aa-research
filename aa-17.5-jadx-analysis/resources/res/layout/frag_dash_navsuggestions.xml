<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navsuggestions_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.Guideline
        android:orientation="horizontal"
        android:id="@+id/vertical_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <android.support.constraint.Guideline
        android:orientation="horizontal"
        android:id="@+id/suggestion_1_focus_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/navsuggestions_focus_ring_inset"/>
    <android.support.constraint.Guideline
        android:orientation="horizontal"
        android:id="@+id/suggestion_2_focus_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/navsuggestions_focus_ring_inset"/>
    <ImageView
        android:id="@+id/suggestion_1_icon"
        android:background="@drawable/navsuggestions_icon_background"
        android:padding="@dimen/navsuggestions_icon_padding"
        android:layout_width="@dimen/navsuggestions_icon_size"
        android:layout_height="@dimen/navsuggestions_icon_size"
        android:layout_margin="@dimen/navsuggestions_icon_margin"
        android:tint="?attr/colorOnSecondaryContainer"/>
    <Space
        android:id="@+id/suggestion_1_name_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_name_line_height"/>
    <Space
        android:id="@+id/suggestion_1_subtext_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_subtext_line_height"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/suggestion_1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="@dimen/dashboard_card_padding"
        android:layout_marginStart="@dimen/gearhead_padding_2"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Gearhead.Coolwalk.Body3.Dashboard"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/suggestion_1_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="@dimen/dashboard_card_padding"
        android:layout_marginStart="@dimen/gearhead_padding_2"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/suggestion_1_tap_target_container"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <com.google.android.apps.auto.components.coolwalk.focusring.TappableRegion
            android:id="@+id/suggestion_1_tap_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:focusRingInsetBottom="0dp"
            app:focusRingInsetLeft="@dimen/navsuggestions_focus_ring_inset"
            app:focusRingInsetRight="@dimen/navsuggestions_focus_ring_inset"
            app:focusRingInsetTop="@dimen/navsuggestions_focus_ring_inset"
            style="@style/Widget.Dashboard.PrimaryTarget"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <View
        android:id="@+id/suggestion_divider"
        android:background="?attr/colorOutline"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="@dimen/navsuggestions_divider_alpha"/>
    <ImageView
        android:id="@+id/suggestion_2_icon"
        android:background="@drawable/navsuggestions_icon_background"
        android:padding="@dimen/navsuggestions_icon_padding"
        android:layout_width="@dimen/navsuggestions_icon_size"
        android:layout_height="@dimen/navsuggestions_icon_size"
        android:layout_margin="@dimen/navsuggestions_icon_margin"
        android:tint="?attr/colorOnSecondaryContainer"/>
    <Space
        android:id="@+id/suggestion_2_name_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_name_line_height"/>
    <Space
        android:id="@+id/suggestion_2_subtext_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_subtext_line_height"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/suggestion_2_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="@dimen/dashboard_card_padding"
        android:layout_marginStart="@dimen/gearhead_padding_2"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Gearhead.Coolwalk.Body3.Dashboard"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/suggestion_2_subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="@dimen/dashboard_card_padding"
        android:layout_marginStart="@dimen/gearhead_padding_2"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/suggestion_2_tap_target_container"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <com.google.android.apps.auto.components.coolwalk.focusring.TappableRegion
            android:id="@+id/suggestion_2_tap_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:focusRingInsetBottom="@dimen/navsuggestions_focus_ring_inset"
            app:focusRingInsetLeft="@dimen/navsuggestions_focus_ring_inset"
            app:focusRingInsetRight="@dimen/navsuggestions_focus_ring_inset"
            app:focusRingInsetTop="0dp"
            style="@style/Widget.Dashboard.PrimaryTarget"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
</com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView>
