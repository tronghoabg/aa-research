<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
        <TextView
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="5dp"
            android:text="@string/preflight_error_title_generic"
            android:drawableTop="@drawable/android_auto_gm3_logo"
            android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
        <TextView
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_horizontal"
            android:id="@+id/dialog_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="5dp"
            android:text="@string/preflight_error_body_usb"
            android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_illustration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/phone_frx_usb_disconnect"
            android:adjustViewBounds="true"
            android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
