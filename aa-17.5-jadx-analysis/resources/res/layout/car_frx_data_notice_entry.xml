<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cakewalk_text_block_margin">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/data_notice_entry_icon"
            android:layout_width="@dimen/car_frx_permission_icon_size"
            android:layout_height="@dimen/car_frx_permission_icon_size"
            android:tint="@android:color/white"
            android:alpha="@dimen/cakewalk_secondary_font_alpha"
            android:layout_marginEnd="@dimen/car_frx_text_separation_margin"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/data_notice_title_body_padding">
                <TextView
                    android:gravity="start"
                    android:id="@+id/data_notice_entry_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
                <ImageView
                    android:id="@+id/data_notice_entry_arrow"
                    android:layout_width="@dimen/data_notice_arrow_size"
                    android:layout_height="@dimen/data_notice_arrow_size"
                    android:layout_marginStart="@dimen/data_notice_arrow_start_padding"/>
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/data_notice_entry_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="@dimen/cakewalk_secondary_font_alpha"
                style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_break_height"
        android:layout_marginTop="@dimen/cakewalk_text_block_margin"
        android:alpha="@dimen/cakewalk_line_break_alpha"/>
</LinearLayout>
