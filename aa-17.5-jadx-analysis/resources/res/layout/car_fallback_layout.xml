<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/fallback_root"
    android:background="@drawable/fallback_activity_background"
    android:padding="72dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/fallback_image"
        android:paddingTop="8dp"
        android:layout_width="42dp"
        android:layout_height="50dp"
        android:tint="@color/error_icon_tint"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:gravity="center"
        android:id="@+id/fallback_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/car_fallback_message_gh"
        android:layout_below="@+id/fallback_image"
        style="@style/TextAppearance.FallbackErrorTitle"/>
</RelativeLayout>
