<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_error"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:overScrollMode="ifContentScrolls">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bs_icon"
            android:background="@color/bottom_sheet_illustration_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/preflight_botttom_sheet_top_margin"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_3x"
            android:scaleType="center"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>
        <TextView
            android:gravity="center"
            android:id="@+id/bs_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_1x"
            android:layout_marginStart="@dimen/bottom_sheet_side_margin"
            android:layout_marginEnd="@dimen/bottom_sheet_side_margin"
            style="@style/TextAppearance.FrxTitle.Cakewalk.Phone"/>
        <TextView
            android:gravity="center"
            android:id="@+id/bs_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_3x"
            android:layout_marginStart="@dimen/bottom_sheet_side_margin"
            android:layout_marginEnd="@dimen/bottom_sheet_side_margin"
            style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="@style/TextAppearance.GoogleMaterial.Subtitle1"
            android:textColor="@color/bottom_sheet_decline_button_text"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/bs_allow_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_1x"
            android:minHeight="@dimen/bottom_sheet_apps_layout_button_height"
            android:layout_marginStart="@dimen/bottom_sheet_side_margin"
            android:layout_marginEnd="@dimen/bottom_sheet_side_margin"
            style="@style/Widget.GoogleMaterial.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="@style/TextAppearance.GoogleMaterial.Subtitle1"
            android:textColor="@color/bottom_sheet_decline_button_text"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/bs_deny_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_1x"
            android:minHeight="@dimen/bottom_sheet_apps_layout_button_height"
            android:layout_marginStart="@dimen/bottom_sheet_side_margin"
            android:layout_marginEnd="@dimen/bottom_sheet_side_margin"
            style="@style/Widget.GoogleMaterial.Button.TextButton"/>
    </LinearLayout>
</ScrollView>
