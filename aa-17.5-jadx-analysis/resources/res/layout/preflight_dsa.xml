<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/preflight_dsa_icon"
        android:layout_width="@dimen/preflight_lock_icon_size"
        android:layout_height="@dimen/preflight_lock_icon_size"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/preflight_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/transparent_black"
        android:gravity="center"
        android:id="@+id/preflight_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_3x"
        android:text="@string/preflight_dsa_title_text_2"
        app:layout_constraintBottom_toTopOf="@+id/preflight_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_dsa_icon"
        style="@style/TextAppearance.Gearhead.Coolwalk.Body1"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/transparent_black"
        android:gravity="center"
        android:id="@+id/preflight_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_2x"
        android:text="@string/preflight_dsa_body_text_2"
        app:layout_constraintBottom_toTopOf="@+id/preflight_never_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_title"
        style="@style/TextAppearance.Gearhead.Coolwalk.Body3"/>
    <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
        android:label="@string/preflight_dsa_maybe_later_2"
        android:id="@+id/preflight_later_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_2x"
        app:carButtonType="tonal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/preflight_never_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_body"/>
    <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
        android:label="@string/preflight_dsa_reject_car_2"
        android:id="@+id/preflight_never_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        app:carButtonType="outlined"
        app:layout_constraintBottom_toBottomOf="@+id/preflight_later_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preflight_later_button"
        app:layout_constraintTop_toTopOf="@+id/preflight_later_button"/>
</android.support.constraint.ConstraintLayout>
