<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/suggestion_1_icon"
        android:layout_width="@dimen/navsuggestions_icon_size"
        android:layout_height="@dimen/navsuggestions_icon_size"
        android:layout_margin="@dimen/navsuggestions_icon_margin"
        app:layout_constraintBottom_toTopOf="@+id/vertical_center"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toTopOf="@+id/suggestion_1_focus_top"/>
    <Space
        android:id="@+id/suggestion_1_name_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_name_line_height"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_1_subtext_area"
        app:layout_constraintStart_toEndOf="@+id/suggestion_1_icon"
        app:layout_constraintTop_toTopOf="@+id/suggestion_1_focus_top"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/suggestion_1_subtext_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_subtext_line_height"
        app:layout_constraintBottom_toTopOf="@+id/vertical_center"
        app:layout_constraintStart_toEndOf="@+id/suggestion_1_icon"
        app:layout_constraintTop_toBottomOf="@+id/suggestion_1_name_area"/>
    <TextView
        android:id="@+id/suggestion_1_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gearhead_padding_2"
        app:layout_constraintBottom_toBottomOf="@+id/suggestion_1_name_area"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toEndOf="@+id/suggestion_1_icon"
        app:layout_constraintTop_toTopOf="@+id/suggestion_1_name_area"/>
    <TextView
        android:id="@+id/suggestion_1_subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gearhead_padding_2"
        app:layout_constraintBottom_toBottomOf="@+id/suggestion_1_subtext_area"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toEndOf="@+id/suggestion_1_icon"
        app:layout_constraintTop_toTopOf="@+id/suggestion_1_subtext_area"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/suggestion_1_tap_target_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/vertical_center"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/suggestion_divider"
        android:background="?attr/colorOutline"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="@dimen/navsuggestions_divider_alpha"
        app:layout_constraintBottom_toBottomOf="@+id/vertical_center"
        app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toTopOf="@+id/vertical_center"/>
    <ImageView
        android:id="@+id/suggestion_2_icon"
        android:layout_width="@dimen/navsuggestions_icon_size"
        android:layout_height="@dimen/navsuggestions_icon_size"
        android:layout_margin="@dimen/navsuggestions_icon_margin"
        app:layout_constraintBottom_toBottomOf="@+id/suggestion_2_focus_bottom"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toBottomOf="@+id/vertical_center"/>
    <Space
        android:id="@+id/suggestion_2_name_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_name_line_height"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_2_subtext_area"
        app:layout_constraintStart_toEndOf="@+id/suggestion_2_icon"
        app:layout_constraintTop_toBottomOf="@+id/vertical_center"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/suggestion_2_subtext_area"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_subtext_line_height"
        app:layout_constraintBottom_toBottomOf="@+id/suggestion_2_focus_bottom"
        app:layout_constraintStart_toEndOf="@+id/suggestion_2_icon"
        app:layout_constraintTop_toBottomOf="@+id/suggestion_2_name_area"/>
    <TextView
        android:id="@+id/suggestion_2_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gearhead_padding_2"
        app:layout_constraintBottom_toBottomOf="@+id/suggestion_2_name_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/suggestion_2_icon"
        app:layout_constraintTop_toTopOf="@+id/suggestion_2_name_area"/>
    <TextView
        android:id="@+id/suggestion_2_subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gearhead_padding_2"
        app:layout_constraintBottom_toBottomOf="@+id/suggestion_2_subtext_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/suggestion_2_icon"
        app:layout_constraintTop_toTopOf="@+id/suggestion_2_subtext_area"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/suggestion_2_tap_target_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vertical_center"/>
</android.support.constraint.ConstraintLayout>
