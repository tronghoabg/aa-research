<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/close_button"
        android:background="@drawable/gearhead_oval_focus_background"
        android:focusable="true"
        android:layout_width="@dimen/gearhead_hun_button_size"
        android:layout_height="@dimen/gearhead_hun_button_size">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/close_button_image"
            android:layout_width="@dimen/gearhead_hun_button_image_size"
            android:layout_height="@dimen/gearhead_hun_button_image_size"
            android:src="@drawable/ic_close_white"
            android:scaleType="center"
            android:tint="?attr/colorOnSurface"/>
    </FrameLayout>
</merge>
