<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/feedback_page_margin"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/feedback_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feedback_spacer"
            android:text="@string/feedback_editor_description_label"
            style="@android:style/TextAppearance.Material.Large"/>
        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:inputType="textMultiLine"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feedback_spacer">
            <Button
                android:id="@+id/delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/feedback_editor_delete"
                android:layout_weight="1"/>
            <Button
                android:enabled="false"
                android:id="@+id/submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/feedback_editor_submit"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/datetime_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feedback_spacer">
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_editor_datetime_label"
                style="@android:style/TextAppearance.Material.Large"/>
            <TextView
                android:id="@+id/report_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/feedback_spacer"
                style="@android:style/TextAppearance.Material.Medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/screenshot_elements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_spacer"
                android:text="@string/feedback_editor_screenshot_label"
                style="@android:style/TextAppearance.Material.Large"/>
            <ImageView
                android:id="@+id/screenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <Button
                android:id="@+id/share_screenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_editor_share_screenshot"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
