<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/gearhead_baseline_grid_2x">
    <ImageView
        android:id="@+id/preflight_apps_image_0"
        android:padding="@dimen/preflight_app_icon_padding_gm3"
        android:layout_width="@dimen/preflight_app_icons_size_gm3"
        android:layout_height="@dimen/preflight_app_icons_size_gm3"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/preflight_title"
        app:layout_constraintEnd_toStartOf="@+id/preflight_apps_image_1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/preflight_apps_image_1"
        android:padding="@dimen/preflight_app_icon_padding_gm3"
        android:layout_width="@dimen/preflight_app_icons_size_gm3"
        android:layout_height="@dimen/preflight_app_icons_size_gm3"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_1x"
        app:layout_constraintBottom_toBottomOf="@+id/preflight_apps_image_0"
        app:layout_constraintEnd_toStartOf="@+id/preflight_apps_image_2"
        app:layout_constraintStart_toEndOf="@+id/preflight_apps_image_0"
        app:layout_constraintTop_toTopOf="@+id/preflight_apps_image_0"/>
    <ImageView
        android:id="@+id/preflight_apps_image_2"
        android:padding="@dimen/preflight_app_icon_padding_gm3"
        android:layout_width="@dimen/preflight_app_icons_size_gm3"
        android:layout_height="@dimen/preflight_app_icons_size_gm3"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_1x"
        app:layout_constraintBottom_toBottomOf="@+id/preflight_apps_image_0"
        app:layout_constraintEnd_toStartOf="@+id/preflight_apps_image_3"
        app:layout_constraintStart_toEndOf="@+id/preflight_apps_image_1"
        app:layout_constraintTop_toTopOf="@+id/preflight_apps_image_0"/>
    <ImageView
        android:id="@+id/preflight_apps_image_3"
        android:padding="@dimen/preflight_app_icon_padding_gm3"
        android:layout_width="@dimen/preflight_app_icons_size_gm3"
        android:layout_height="@dimen/preflight_app_icons_size_gm3"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_1x"
        app:layout_constraintBottom_toBottomOf="@+id/preflight_apps_image_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preflight_apps_image_2"
        app:layout_constraintTop_toTopOf="@+id/preflight_apps_image_0"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/transparent_black"
        android:gravity="center"
        android:id="@+id/preflight_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_4x"
        app:layout_constraintBottom_toTopOf="@+id/preflight_content_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_apps_image_0"
        style="@style/TextAppearance.Gearhead.Coolwalk.Body1"/>
    <FrameLayout
        android:id="@+id/preflight_content_container"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_4x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_title">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="@color/transparent_black"
            android:gravity="center"
            android:id="@+id/preflight_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.Gearhead.Coolwalk.Body3"/>
        <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
            android:label="@string/preflight_intro_finish_setup_on_phone"
            android:layout_gravity="center"
            android:id="@+id/show_authorization_dialog_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:carButtonSize="medium"
            app:carButtonType="tonal"/>
    </FrameLayout>
</android.support.constraint.ConstraintLayout>
