<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/google_grey50"
        android:paddingLeft="@dimen/companion_feature_announce_padding_perimeter"
        android:paddingTop="@dimen/companion_feature_announce_padding_perimeter"
        android:paddingRight="@dimen/companion_feature_announce_padding_perimeter"
        android:paddingBottom="@dimen/companion_feature_announce_padding_perimeter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/feature_announce_icon"
                android:layout_width="@dimen/companion_feature_announce_icon_width"
                android:layout_height="@dimen/companion_feature_announce_icon_height"
                android:layout_marginRight="@dimen/companion_feature_announce_icon_padding_right"/>
            <TextView
                android:textSize="@dimen/companion_feature_announce_description_text_size"
                android:textColor="@color/google_grey800"
                android:id="@+id/feature_announce_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/titleLegacySansSerifFontFamily"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="right"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/google_blue600"
                android:id="@+id/feature_announce_decline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/companion_feature_announce_button_separation_margin"
                android:minHeight="@dimen/companion_feature_announce_button_min_height"
                android:insetLeft="@dimen/companion_feature_announce_decline_button_inset"
                android:insetRight="@dimen/companion_feature_announce_decline_button_inset"
                app:fontFamily="?attr/buttonFontFamily"
                style="@style/Widget.GoogleMaterial.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:id="@+id/feature_announce_accept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/companion_feature_announce_button_min_height"
                app:backgroundTint="@color/google_blue600"
                app:fontFamily="?attr/buttonFontFamily"
                style="@style/Widget.GoogleMaterial.Button"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
