<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.layout.KeyEventDispatchingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.apps.auto.components.coolwalk.clip.ShapeClipLayout
            android:id="@+id/top_card_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dashboard_top_card_height"
            android:layout_weight="@integer/dashboard_top_card_weight"
            app:cornerSize="@dimen/coolwalk_dashboard_card_radius">
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <android.support.v4.app.FragmentContainerView
                    android:id="@+id/dashboard_top_second"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:name="com.google.android.apps.auto.components.system.dashboard.DashboardPlaceholderCard"
                    android:id="@+id/dashboard_top"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </com.google.android.apps.auto.components.coolwalk.clip.ShapeClipLayout>
        <Space
            android:id="@+id/card_spacer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dashboard_padding"/>
        <com.google.android.apps.auto.components.coolwalk.clip.ShapeClipLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cornerSize="@dimen/coolwalk_dashboard_card_radius">
            <android.support.v4.app.FragmentContainerView
                android:name="com.google.android.apps.auto.components.system.dashboard.DashboardPlaceholderCard"
                android:id="@+id/dashboard_bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.google.android.apps.auto.components.coolwalk.clip.ShapeClipLayout>
    </LinearLayout>
</com.google.android.apps.auto.components.system.layout.KeyEventDispatchingFrameLayout>
