<?xml version="1.0" encoding="utf-8"?>
<com.google.android.projection.gearhead.companion.ParallaxHeader xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/gearhead_sdk_light_blue_700"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="1dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.125"/>
        <ImageView
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="0x7f08045d"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_weight="0.75"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.125"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/play_button"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080161"
        android:contentDescription="@string/companion_play_intro_video"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:alpha="0"/>
</com.google.android.projection.gearhead.companion.ParallaxHeader>
