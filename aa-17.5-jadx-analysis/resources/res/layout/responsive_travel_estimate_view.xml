<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.navigation.ResponsiveTravelEstimateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/responsive_travel_estimate_view"
    android:focusable="false"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginBottom="@dimen/template_padding_1"
    app:cardWidthFraction="0"
    app:isCarBorderBlendColor="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHeight_default="wrap"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="1"
    app:layout_constraintWidth_default="wrap"
    app:layout_constraintWidth_max="?attr/templateRoutingResponsiveStepsCardMaxWidth"
    app:layout_constraintWidth_min="?attr/templateRoutingResponsiveStepsCardMinWidth"
    style="?attr/templateCardRoutingContentContainerStyle">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/template_padding_2">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/stop_nav_action_container"
            android:paddingTop="1dp"
            android:focusable="true"
            android:clickable="true"
            android:addStatesFromChildren="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/template_padding_1">
            <ImageView
                android:id="@+id/stop_nav_action_icon"
                android:layout_width="?attr/templateActionIconSize"
                android:layout_height="?attr/templateActionIconSize"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/template_padding_1"
            android:paddingEnd="@dimen/template_padding_2"
            android:paddingVertical="@dimen/template_padding_2">
            <TextView
                android:id="@+id/responsive_travel_estimate_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Template.Text.Body3"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.navigation.ResponsiveTravelEstimateView>
