<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/large_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:orientation="horizontal"
        android:id="@+id/icon_guideline"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/large_icon"
        app:layout_constraintTop_toTopOf="@+id/large_icon"
        app:layout_constraintVertical_bias="0.5714"/>
    <ImageView
        android:id="@+id/small_icon"
        android:background="@drawable/notification_small_icon_bg"
        android:padding="@dimen/notification_new_small_icon_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/large_icon"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/large_icon"
        app:layout_constraintTop_toTopOf="@+id/icon_guideline"/>
</android.support.constraint.ConstraintLayout>
