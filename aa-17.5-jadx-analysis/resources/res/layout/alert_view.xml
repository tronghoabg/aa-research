<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.AlertView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start|center_vertical"
    android:orientation="vertical"
    android:paddingTop="@dimen/template_padding_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/alert_icon"
            android:visibility="gone"
            android:layout_width="@dimen/template_alert_image_size"
            android:layout_height="@dimen/template_alert_image_size"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/template_padding_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/alert_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:singleLine="false"
            android:fontFamily="?attr/titleLegacyGoogleSansFontFamily"
            android:layout_marginStart="@dimen/template_padding_2"
            android:layout_marginEnd="@dimen/template_padding_2"
            android:letterSpacing="0"
            app:layout_constraintBottom_toTopOf="@+id/alert_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/alert_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="@dimen/template_padding_2"
            style="?attr/templateRowTitleStyle"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/alert_subtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_1"
            android:maxLines="2"
            android:singleLine="false"
            android:fontFamily="?attr/titleLegacyGoogleSansFontFamily"
            android:layout_marginStart="@dimen/template_padding_2"
            android:layout_marginEnd="@dimen/template_padding_2"
            android:letterSpacing="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/alert_icon"
            app:layout_constraintTop_toBottomOf="@+id/alert_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="@dimen/template_padding_2"
            style="?attr/templateRowSecondaryTextStyle"/>
    </android.support.constraint.ConstraintLayout>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_padding_2"
        android:max="100"
        android:progress="0"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/template_padding_2"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.google.android.apps.auto.components.apphost.view.widgets.common.ActionButtonListView
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/action_button_list_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/template_padding_2"
        android:layout_marginVertical="@dimen/template_padding_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress"
        app:shouldStackButtons="true"/>
</com.google.android.apps.auto.components.apphost.view.widgets.common.AlertView>
