<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:layout_width="0dp"
    android:layout_height="@dimen/launcher_app_settings_icon_container_diameter"
    android:layout_weight="1"
    android:contentDescription="@null">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="center"
        android:id="@+id/icon_circular_crop_container"
        android:clipToPadding="false"
        android:layout_width="@dimen/launcher_app_settings_icon_diameter"
        android:layout_height="@dimen/launcher_app_settings_icon_diameter"
        app:cardCornerRadius="@dimen/launcher_app_settings_icon_radius"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/launcher_app_settings_outline"
        app:strokeWidth="1dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/badge_background"
        android:layout_width="@dimen/launcher_app_settings_badge_background_diameter"
        android:layout_height="@dimen/launcher_app_settings_badge_background_diameter"
        android:layout_marginLeft="@dimen/launcher_app_settings_badge_background_margin"
        android:layout_marginTop="@dimen/launcher_app_settings_badge_background_margin"
        android:contentDescription="@null"
        app:layout_constraintLeft_toLeftOf="@+id/icon_circular_crop_container"
        app:layout_constraintTop_toTopOf="@+id/icon_circular_crop_container"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/badge"
        android:layout_width="@dimen/launcher_app_settings_badge_diameter"
        android:layout_height="@dimen/launcher_app_settings_badge_diameter"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/badge_background"
        app:layout_constraintLeft_toLeftOf="@+id/badge_background"
        app:layout_constraintRight_toRightOf="@+id/badge_background"
        app:layout_constraintTop_toTopOf="@+id/badge_background"
        app:shapeAppearanceOverlay="@style/LauncherAppIconBadgeShape"/>
    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:alpha="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_circular_crop_container"/>
</android.support.constraint.ConstraintLayout>
