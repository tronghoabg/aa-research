<?xml version="1.0" encoding="utf-8"?>
<ViewSwitcher xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/companion_settings_row_height"
        android:text="@string/cars_none"
        android:layout_marginStart="@dimen/companion_settings_car_text_margin"
        android:layout_marginEnd="@dimen/companion_settings_car_text_margin"
        style="@style/TextAppearance.CompanionSettings"/>
</ViewSwitcher>
