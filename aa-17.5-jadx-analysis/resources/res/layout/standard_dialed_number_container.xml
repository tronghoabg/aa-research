<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/number"
        android:layout_width="@dimen/dialpad_dialed_number_width"
        android:layout_height="wrap_content"
        android:hint="@string/dial_a_number"
        android:maxLines="2"
        android:layout_centerInParent="true"
        style="@style/TextAppearance.Boardwalk.Dialpad"/>
    <ImageButton
        android:id="@+id/delete"
        android:background="@drawable/gearhead_dialer_button_focus_background"
        android:padding="@dimen/dialpad_action_button_padding"
        android:layout_width="@dimen/dialpad_action_button_size"
        android:layout_height="@dimen/dialpad_action_button_size"
        android:src="@drawable/ic_backspace"
        android:scaleType="fitCenter"
        android:tint="?attr/gearheadDialerDialpadActionPanelButtonTint"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/number"/>
</RelativeLayout>
