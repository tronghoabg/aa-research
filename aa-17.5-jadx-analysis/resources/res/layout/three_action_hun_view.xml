<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/hun_view"
    android:background="@drawable/coolwalk_hun_background"
    android:paddingBottom="@dimen/hun_content_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hun_height"
    android:layout_marginTop="@dimen/coolwalk_gearhead_hun_margin_top"
    android:paddingStart="0dp"
    android:paddingEnd="@dimen/hun_content_padding"
    android:layout_marginStart="@dimen/coolwalk_gearhead_hun_margin"
    android:layout_marginEnd="@dimen/coolwalk_gearhead_hun_margin">
    <FrameLayout
        android:id="@+id/card_content_selector"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/gearhead_baseline_grid_0.5x"
        android:foreground="@drawable/coolwalk_rectangle_round_corner_focus_background"
        app:layout_constraintBottom_toTopOf="@+id/primary_action_button_container"
        app:layout_constraintEnd_toStartOf="@+id/notification_close_button_holder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/notification_close_button_holder"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_icon">
        <include layout="@layout/hun_close_button_legacy"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gearhead_padding_2"
        android:paddingEnd="0dp"
        android:layout_marginStart="@dimen/hun_text_margin_start"
        app:layout_constraintEnd_toStartOf="@+id/item_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_icon">
        <TextView
            android:textAppearance="@style/TextAppearance.Coolwalk.Body1.Hun.Deprecated"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/work_profile_badge"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/work_profile_badge"
            android:layout_width="@dimen/gearhead_hun_icon_size"
            android:layout_height="@dimen/gearhead_hun_icon_size"
            android:layout_marginTop="@dimen/gearhead_baseline_grid_1x"
            android:src="0x7f080990"
            android:tint="@color/gearhead_coolwalk_work_profile_icon_color"
            android:layout_marginStart="@dimen/gearhead_padding_2"
            android:layout_marginEnd="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.Boardwalk.Body3.Hun2"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="@dimen/gearhead_padding_2"
        android:paddingEnd="0dp"
        app:layout_constraintEnd_toEndOf="@+id/title_container"
        app:layout_constraintStart_toStartOf="@+id/title_container"
        app:layout_constraintTop_toBottomOf="@+id/title_container"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/primary_action_button_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/hun_button_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/secondary_action_button_container"
        app:layout_constraintStart_toStartOf="@+id/profile_icon">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/primary_action_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:backgroundTint="@color/gearhead_hun_message_background_color"
            style="@style/Widget.Notification.Button.Tonal"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/secondary_action_button_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/hun_button_height"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/third_action_button_container"
        app:layout_constraintStart_toEndOf="@+id/primary_action_button_container">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/secondary_action_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:backgroundTint="@color/gearhead_hun_message_background_color"
            style="@style/Widget.Notification.Button.Tonal"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/third_action_button_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/hun_button_height"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondary_action_button_container">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/third_action_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:backgroundTint="@color/gearhead_hun_message_background_color"
            style="@style/Widget.Notification.Button.Tonal"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <com.google.android.apps.auto.components.ui.text.CountIndicatorTextView
        android:textAppearance="@style/TextAppearance.Boardwalk.Body3"
        android:gravity="center"
        android:id="@+id/item_count"
        android:background="@drawable/message_count_background"
        android:visibility="gone"
        android:layout_width="@dimen/count_indicator_view_single_digit_width"
        android:layout_height="@dimen/count_indicator_view_height"
        android:maxLines="1"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_1x"
        android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
        app:layout_constraintBottom_toBottomOf="@+id/text"
        app:layout_constraintEnd_toStartOf="@+id/notification_close_button_holder"
        app:layout_constraintStart_toEndOf="@+id/title_container"
        app:layout_constraintTop_toTopOf="@+id/title_container"/>
    <include
        android:id="@+id/profile_icon"
        android:layout_width="@dimen/gearhead_hun_badged_icon_size"
        android:layout_height="@dimen/gearhead_hun_badged_icon_size"
        android:layout_marginTop="@dimen/hun_content_padding"
        android:layout_marginStart="@dimen/hun_content_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/hun_badged_icon"/>
</android.support.constraint.ConstraintLayout>
