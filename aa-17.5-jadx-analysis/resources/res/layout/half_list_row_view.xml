<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.RowView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_view_root"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/row_radio_button_container"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/templateRowSelectionContainerHeight"
        android:layout_marginEnd="@dimen/template_padding_3">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/row_radio_button"
            android:layout_width="?attr/templateRadioButtonSize"
            android:layout_height="?attr/templateRadioButtonSize"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="top"
        android:id="@+id/row_image"
        android:visibility="gone"
        android:layout_width="?attr/templateRowIconSize"
        android:layout_height="?attr/templateRowIconSize"
        android:scaleType="fitCenter"
        android:layout_marginEnd="@dimen/template_padding_2"
        app:strokeColor="@null"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/row_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="?attr/templateRowTextHorizontalPadding"
        android:paddingEnd="?attr/templateRowTextHorizontalPadding">
        <include
            android:id="@+id/row_view_title"
            layout="@layout/row_view_title"/>
    </LinearLayout>
    <include layout="@layout/row_view_secondary_action_half_list"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/row_toggle_container"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/templateRowSelectionContainerHeight"
        android:layout_marginStart="@dimen/template_padding_1">
        <Switch
            android:layout_gravity="center"
            android:id="@+id/row_toggle"
            android:focusable="false"
            android:layout_width="?attr/templateToggleWidth"
            android:layout_height="?attr/templateToggleHeight"
            android:thumbTint="?attr/templateSwitchThumbColor"
            android:trackTint="?attr/templateSwitchTrackColor"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/row_caret"
        android:visibility="gone"
        android:layout_width="?attr/templateRowIconSize"
        android:layout_height="?attr/templateRowIconSize"
        android:src="@drawable/quantum_ic_navigate_next_vd_theme_24"
        android:scaleType="fitXY"
        android:tint="?attr/templateRowCaretIconTint"
        android:layout_marginEnd="@dimen/template_padding_1"
        android:tintMode="src_in"/>
</com.google.android.apps.auto.components.apphost.view.widgets.common.RowView>
