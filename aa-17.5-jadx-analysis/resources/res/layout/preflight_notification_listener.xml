<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/preflight_notification_listener_graphic"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/preflight_notification_access_icon_height"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/preflight_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="@color/preflight_title"
        android:gravity="center"
        android:id="@+id/preflight_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_3x"
        app:layout_constraintBottom_toTopOf="@+id/preflight_continue_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_notification_listener_graphic"
        style="@style/TextAppearance.Boardwalk.Body1"/>
    <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
        android:label="@string/notification_listener_car_screen_button"
        android:id="@+id/preflight_continue_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_4x"
        android:layout_marginBottom="@dimen/gearhead_baseline_grid_4x"
        app:carButtonType="tonal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preflight_title"/>
</android.support.constraint.ConstraintLayout>
