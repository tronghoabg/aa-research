<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/manage_cars"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/car_margin_small"
            android:paddingBottom="@dimen/car_margin_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_margin_small"
                android:layout_marginRight="@dimen/car_margin_small"
                android:text="@string/accepted_cars"
                style="@style/TextAppearance.CompanionSettingsLabel"/>
            <include
                android:id="@+id/accepted_cars_view_switcher"
                layout="@layout/material3_settings_car_view_switcher"/>
            <TextView
                android:id="@+id/rejected_cars_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_margin_small"
                android:layout_marginTop="@dimen/car_margin_small"
                android:layout_marginRight="@dimen/car_margin_small"
                android:text="@string/rejected_cars"
                style="@style/TextAppearance.CompanionSettingsLabel"/>
            <include
                android:id="@+id/rejected_cars_view_switcher"
                layout="@layout/material3_settings_car_view_switcher"/>
            <View
                android:layout_margin="@dimen/car_margin_small"
                style="@style/CompanionAppSeparator"/>
            <RelativeLayout
                android:id="@+id/add_new_cars_relative_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_margin_small"
                android:layout_marginTop="@dimen/companion_settings_known_cars_vertical_margin"
                android:layout_marginRight="@dimen/car_margin_small"
                android:layout_marginBottom="@dimen/companion_settings_known_cars_vertical_margin">
                <TextView
                    android:id="@+id/add_new_cars_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_new_cars"
                    android:layout_toStartOf="@+id/add_new_cars_switch"
                    style="@style/TextAppearance.CompanionSettingsLabel"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/add_new_cars_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/add_new_cars"
                    android:paddingStart="@dimen/car_margin_small"
                    android:paddingEnd="@dimen/car_margin_small"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:id="@+id/add_new_cars_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_new_cars_description_on"
                    android:layout_below="@+id/add_new_cars_label"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_toStartOf="@+id/add_new_cars_switch"
                    style="@style/TextAppearance.M3.Body"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</merge>
