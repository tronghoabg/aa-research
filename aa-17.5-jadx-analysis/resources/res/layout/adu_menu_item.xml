<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/row_container"
    android:background="?attr/gearheadMenuItemBackground"
    android:paddingLeft="@dimen/gearhead_sdk_list_item_padding"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gearhead_sdk_list_item_height">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/gearhead_sdk_list_item_icon_size"
        android:layout_height="@dimen/gearhead_sdk_list_item_icon_size"
        android:scaleType="centerCrop"
        android:layout_marginEnd="@dimen/gearhead_sdk_list_item_icon_right_margin"/>
    <LinearLayout
        android:orientation="vertical"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_sdk_text_vertical_margin"
            android:singleLine="true"
            style="@style/GearheadSdkBody1"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/GearheadSdkBody2"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/gearhead_sdk_list_item_right_icon_margin"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/end_bouncer"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</LinearLayout>
