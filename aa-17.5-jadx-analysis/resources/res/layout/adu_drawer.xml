<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom"
        android:id="@+id/truncated_list_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_browse_notification_height"
        android:layout_marginLeft="@dimen/content_browse_notification_margin"
        android:layout_marginRight="@dimen/content_browse_notification_margin"
        android:layout_marginBottom="@dimen/content_browse_notification_margin"
        app:cardBackgroundColor="@color/gearhead_sdk_blue_grey_800"
        app:cardCornerRadius="@dimen/gearhead_sdk_card_view_corner_radius"
        app:cardElevation="@dimen/gearhead_sdk_card_view_elevation">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/truncated_list_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/content_browse_notification_text_padding"
            android:paddingEnd="@dimen/content_browse_notification_text_padding"
            style="@style/GearheadSdkContentBrowseNotification"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp">
        <View
            android:id="@+id/top_focus_dummy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="7dp"/>
        <View
            android:id="@+id/lockout_scrim"
            android:background="@color/speedbump_drawer_scrim"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="32dp"
            android:elevation="7dp"/>
        <View
            android:id="@+id/bottom_focus_dummy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="7dp"/>
    </LinearLayout>
    <com.google.android.apps.auto.sdk.ui.PagedListView
        android:id="@+id/menu_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/gearhead_sdk_drawer_header_height"
        android:paddingEnd="32dp"
        app:listMaxWidth="0dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/appdecor_menu_empty"
        style="@style/GearheadSdkBody1"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"/>
    <FrameLayout
        android:id="@+id/drawer_shadow"
        android:background="@color/gearhead_sdk_card_background"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"/>
    <com.google.android.apps.auto.components.drawer.AlphaJumpFab
        android:layout_gravity="end|top"
        android:id="@+id/alpha_jump_fab"
        android:visibility="gone"
        android:layout_width="@dimen/alpha_jump_fab_width_height"
        android:layout_height="@dimen/alpha_jump_fab_width_height"
        android:layout_marginTop="@dimen/alpha_jump_fab_margin_top"
        android:layout_marginEnd="@dimen/alpha_jump_fab_margin_end"
        android:elevation="@dimen/fab_elevation"/>
    <com.google.android.apps.auto.components.drawer.AlphaJumpKeyboard
        android:id="@+id/alpha_jump_keyboard"
        android:background="@color/gearhead_sdk_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/alpha_jump_keyboard_margin_top"
        app:mode="fixed"
        app:use_appdecor_drawer_keyboard="true"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/fundip_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="1500dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fundip_drawable"
            android:layout_width="wrap_content"
            android:layout_height="96dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/speedbump_animation_big_day"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="26dp"
            android:gravity="center"
            android:id="@+id/lockout_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speedbump_lockout_message"
            android:layout_alignTop="@+id/fundip_drawable"
            android:layout_alignBottom="@+id/fundip_drawable"
            android:layout_alignStart="@+id/fundip_drawable"
            android:layout_alignEnd="@+id/fundip_drawable"
            style="@style/GearheadSdkBody1"/>
    </RelativeLayout>
</merge>
