<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/carFrxBackgroundColor"
    android:paddingBottom="@dimen/car_frx_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/car_frx_margin_edge"
    android:paddingEnd="@dimen/car_frx_margin_edge">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/header_icon"
        android:layout_width="@dimen/car_frx_small_icon_size"
        android:layout_height="@dimen/car_frx_small_icon_size"
        android:layout_marginTop="@dimen/car_frx_cakewalk_top_margin_icon_no_padding"
        android:layout_marginBottom="@dimen/car_frx_app_icon_margin"
        android:src="@drawable/ic_car_24"
        android:layout_centerHorizontal="true"
        style="@style/CarFrxCarIconStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/frx_preinstalled_apps_permissions_title"
        android:layout_below="@+id/header_icon"
        style="@style/TextAppearance.FrxTitle.Cakewalk.Phone"/>
    <TextView
        android:id="@+id/header_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/frx_title_body_separation_margin_auto_launch"
        android:text="@string/frx_preinstalled_apps_permissions_header_body"
        android:layout_below="@+id/title"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/microphone_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080abe"
        android:adjustViewBounds="true"
        android:layout_below="@+id/header_body"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/microphone_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_microphone_name"
        android:layout_alignTop="@+id/microphone_icon"
        android:layout_toEndOf="@+id/microphone_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/microphone_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_microphone_description"
        android:layout_below="@+id/microphone_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/microphone_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/location_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080aa6"
        android:adjustViewBounds="true"
        android:layout_below="@+id/microphone_body"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/location_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_location_name"
        android:layout_alignTop="@+id/location_icon"
        android:layout_toEndOf="@+id/location_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/location_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_location_description"
        android:layout_below="@+id/location_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/location_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <Switch
        android:theme="@style/ThemeOverlay.Frx.Switch"
        android:gravity="start"
        android:id="@+id/location_allow_weather"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:minHeight="48dp"
        android:text="@string/permission_location_weather_switch_description"
        android:layout_below="@+id/location_body"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/location_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/phone_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080af1"
        android:adjustViewBounds="true"
        android:layout_below="@+id/location_allow_weather"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/phone_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_phone_name"
        android:layout_alignTop="@+id/phone_icon"
        android:layout_toEndOf="@+id/phone_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/phone_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_phone_description"
        android:layout_below="@+id/phone_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/phone_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/call_log_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="@drawable/ic_call_log_white_24"
        android:adjustViewBounds="true"
        android:layout_below="@+id/phone_body"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/call_log_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_call_log_name"
        android:layout_alignTop="@+id/call_log_icon"
        android:layout_toEndOf="@+id/call_log_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/call_log_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_call_log_description"
        android:layout_below="@+id/call_log_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/call_log_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/sms_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080b4d"
        android:adjustViewBounds="true"
        android:layout_below="@+id/call_log_body"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/sms_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_sms_name"
        android:layout_alignTop="@+id/sms_icon"
        android:layout_toEndOf="@+id/sms_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/sms_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_sms_description"
        android:layout_below="@+id/sms_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/sms_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/contact_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080a04"
        android:adjustViewBounds="true"
        android:layout_below="@+id/sms_body"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/contact_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_contacts_name"
        android:layout_alignTop="@+id/contact_icon"
        android:layout_toEndOf="@+id/contact_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/contact_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_contacts_description"
        android:layout_below="@+id/contact_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/contact_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/calendar_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080a3f"
        android:adjustViewBounds="true"
        android:layout_below="@+id/contact_body"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/calendar_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_calendar_name"
        android:layout_alignTop="@+id/calendar_icon"
        android:layout_toEndOf="@+id/calendar_icon"
        style="@style/TextAppearance.Subtitle.Cakewalk.Phone"/>
    <TextView
        android:gravity="start"
        android:id="@+id/calendar_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_calendar_description"
        android:layout_below="@+id/calendar_header"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        android:layout_alignStart="@+id/calendar_header"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
    <ImageView
        android:id="@+id/footer_icon"
        android:paddingTop="6dp"
        android:layout_width="@dimen/car_frx_permission_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_permission_item_spacer"
        android:src="0x7f080a81"
        android:adjustViewBounds="true"
        android:layout_below="@+id/calendar_body"
        android:alpha="@dimen/cakewalk_permission_description_alpha"
        style="@style/CarCakewalkFrxPermissionIconStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/footer_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/footer_icon"
        android:layout_toEndOf="@+id/footer_icon"
        style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
</RelativeLayout>
