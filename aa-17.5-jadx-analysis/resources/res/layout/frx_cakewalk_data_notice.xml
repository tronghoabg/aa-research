<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/carFrxBackgroundColor"
    android:paddingLeft="@dimen/cakewalk_ToS_side_spacing"
    android:paddingRight="@dimen/cakewalk_ToS_side_spacing"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tos_icon"
        android:layout_width="@dimen/car_frx_small_icon_size"
        android:layout_height="@dimen/car_frx_small_icon_size"
        android:layout_marginTop="@dimen/car_frx_cakewalk_top_margin_icon_no_padding"
        android:layout_marginBottom="@dimen/car_frx_app_icon_margin"
        style="@style/CarFrxCarIconStyle"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tos_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cakewalk_main_icon_ToS_bottom_margin"
        android:text="@string/data_notice_title"
        style="@style/TextAppearance.FrxTitle.Cakewalk.Phone"/>
    <View
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_break_height"
        android:layout_marginBottom="@dimen/cakewalk_text_block_margin"
        android:alpha="@dimen/cakewalk_line_break_alpha"/>
    <include
        android:id="@+id/data_charges"
        layout="@layout/car_frx_data_notice_entry"/>
    <include
        android:id="@+id/phone_to_car"
        layout="@layout/car_frx_data_notice_entry"/>
    <include
        android:id="@+id/car_to_phone"
        layout="@layout/car_frx_data_notice_entry"/>
</LinearLayout>
