<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/bottom_sheet_layout_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:paddingTop="@dimen/bottom_sheet_parent_layout_padding"
        android:paddingBottom="@dimen/authorization_element_extra_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/car_setup_cakewalk_authorizing_car_connection_title"
        android:drawableTop="@drawable/android_auto_gm3_logo"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"
        android:paddingStart="@dimen/bottom_sheet_parent_layout_padding"
        android:paddingEnd="@dimen/bottom_sheet_parent_layout_padding"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="start"
        android:id="@+id/bluetooth"
        android:paddingTop="@dimen/authorization_element_padding_vertical"
        android:paddingBottom="@dimen/authorization_element_padding_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/car_setup_authorizing_car_connection_message_1"
        android:drawablePadding="@dimen/authorization_icon_padding_end"
        android:drawableStart="@drawable/gs_bluetooth_vd_theme_24"
        android:paddingStart="@dimen/authorization_element_padding_start"
        android:paddingEnd="@dimen/authorization_element_padding_end"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"
        style="?attr/textAppearanceTitleSmall"/>
    <TextView
        android:gravity="start"
        android:id="@+id/notification"
        android:paddingTop="@dimen/authorization_element_padding_vertical"
        android:paddingBottom="@dimen/authorization_element_padding_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/car_setup_authorizing_car_connection_message_1"
        android:drawablePadding="@dimen/authorization_icon_padding_end"
        android:drawableStart="@drawable/gs_notifications_vd_theme_24"
        android:paddingStart="@dimen/authorization_element_padding_start"
        android:paddingEnd="@dimen/authorization_element_padding_end"
        app:layout_constraintTop_toBottomOf="@+id/bluetooth"
        style="?attr/textAppearanceTitleSmall"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:id="@+id/cancel_button"
        android:paddingLeft="@dimen/button_paddingHorizontal"
        android:paddingRight="@dimen/button_paddingHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/authorization_element_extra_margin"
        android:text="@string/frx_common_exit"
        android:layout_marginStart="@dimen/button_paddingHorizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification"
        style="?attr/materialButtonOutlinedStyle"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:id="@+id/accept_button"
        android:paddingLeft="@dimen/button_paddingHorizontal"
        android:paddingRight="@dimen/button_paddingHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/authorization_element_extra_margin"
        android:text="@string/frx_common_next"
        android:layout_marginEnd="@dimen/button_paddingHorizontal"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification"
        style="?attr/materialIconButtonFilledStyle"/>
</android.support.constraint.ConstraintLayout>
