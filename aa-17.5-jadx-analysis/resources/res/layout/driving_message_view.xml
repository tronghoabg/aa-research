<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/driving_message_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/driving_message_icon"
        android:layout_width="?attr/templateMessageIconSize"
        android:layout_height="?attr/templateMessageIconSize"
        android:src="@drawable/ic_error"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/driving_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_padding_4"
        android:foreground="@drawable/no_content_view_focus_ring_legacy"
        style="?attr/templateMessageTitleTextStyle"/>
</LinearLayout>
