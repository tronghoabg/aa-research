<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/contentInset_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/contentInset_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/contentInset_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/contentInset_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <View
        android:id="@+id/map"
        android:background="#00ffff"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <tag
            android:value="true"
            android:id="@+id/rounded_corners_regular_display_only"/>
        <tag
            android:value="@integer/activity_group_maps_main"
            android:id="@+id/grouped_unless_irregular"/>
        <tag
            android:value="true"
            android:id="@+id/accepts_casted_window_insets"/>
        <tag
            android:value="true"
            android:id="@+id/show_outlines_only_when_inset"/>
    </View>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stable_content_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/contentInset_bottom"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"
        app:layout_constraintTop_toTopOf="@+id/contentInset_top">
        <View
            android:id="@+id/map_compat"
            android:background="#00274b"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer"
            app:layout_constraintTop_toTopOf="parent">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="@integer/activity_group_maps_main"
                android:id="@+id/grouped"/>
        </View>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dashboard_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/dashboard_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/dashboard_rhd_guideline_location"/>
            <Space
                android:id="@+id/dashboard_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="@+id/dashboard_guideline"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_min="@dimen/dashboard_width"/>
            <View
                android:id="@+id/dashboard"
                android:background="#202930"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/dashboard_spacer"
                app:layout_constraintLeft_toLeftOf="@+id/dashboard_spacer"
                app:layout_constraintRight_toRightOf="@+id/dashboard_spacer"
                app:layout_constraintTop_toTopOf="@+id/dashboard_spacer">
                <tag
                    android:value="true"
                    android:id="@+id/casts_window_insets"/>
                <tag
                    android:value="true"
                    android:id="@+id/casts_left_window_inset"/>
            </View>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/cielo_dashboard"
            android:background="#202930"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/casts_window_insets"/>
            <tag
                android:value="true"
                android:id="@+id/casts_left_window_inset"/>
        </View>
        <View
            android:id="@+id/immersive"
            android:background="#ffa500"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="true"
                android:id="@+id/accepts_casted_window_insets"/>
            <tag
                android:value="@integer/activity_group_maps_main"
                android:id="@+id/grouped"/>
        </View>
        <View
            android:id="@+id/immersive_toolbar"
            android:background="#613baf"
            android:layout_width="0dp"
            android:layout_height="@dimen/immersive_toolbar_height"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/immersive_toolbar_bottom_scrim"
            android:background="#613baf"
            android:layout_width="0dp"
            android:layout_height="@dimen/immersive_toolbar_bottom_scrim_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/activity"
            android:background="#ffff4444"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="@integer/activity_group_maps_main"
                android:id="@+id/grouped_primary"/>
            <tag
                android:value="true"
                android:id="@+id/accepts_casted_window_insets"/>
        </View>
        <View
            android:id="@+id/activity_compat"
            android:background="#00274b"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rail"
            app:layout_constraintTop_toTopOf="parent">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="@integer/activity_group_maps_main"
                android:id="@+id/grouped"/>
        </View>
        <View
            android:id="@+id/notification_center"
            android:background="#ffff9900"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toRightOf="@+id/activity"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="true"
                android:id="@+id/accepts_casted_window_insets"/>
        </View>
        <View
            android:id="@+id/demand"
            android:background="#ff44ff44"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/assistant_immersive_partial_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rail"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/immersive_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/dashboard_lhd_guideline_location"/>
            <View
                android:id="@+id/assistant_immersive_partial"
                android:background="#ff28b7d4"
                android:paddingLeft="@dimen/coolwalk_gutter_padding"
                android:paddingTop="@dimen/coolwalk_gutter_padding"
                android:paddingBottom="@dimen/coolwalk_gutter_padding"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintLeft_toLeftOf="@+id/immersive_guideline"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_min="@dimen/dashboard_driver_aligned_width_vertical_rail">
                <tag
                    android:value="true"
                    android:id="@+id/rounded_corners"/>
                <tag
                    android:value="true"
                    android:id="@+id/casts_window_insets"/>
                <tag
                    android:value="true"
                    android:id="@+id/casts_right_window_inset"/>
                <tag
                    android:value="@integer/immersive_group"
                    android:id="@+id/grouped"/>
            </View>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/assistant_immersive_fullscreen"
            android:background="#ffffb7d4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toRightOf="@+id/activity"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="@integer/immersive_group"
                android:id="@+id/grouped"/>
            <tag
                android:value="true"
                android:id="@+id/accepts_casted_window_insets"/>
        </View>
        <View
            android:id="@+id/notification"
            android:background="#99ff44ff"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer"
            app:layout_constraintTop_toTopOf="parent">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
        <Space
            android:id="@+id/rail_spacer"
            android:layout_width="@dimen/floating_vertical_rail_space_width"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/rail"
            android:background="#55111111"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/rail_spacer"
            app:layout_constraintRight_toRightOf="@+id/rail_spacer"
            app:layout_constraintTop_toTopOf="parent">
            <tag
                android:value="true"
                android:id="@+id/casts_window_insets"/>
            <tag
                android:value="true"
                android:id="@+id/casts_right_window_inset"/>
        </View>
        <View
            android:id="@+id/demand_rail"
            android:background="#ff999d8e"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/rail"
            app:layout_constraintLeft_toLeftOf="@+id/rail"
            app:layout_constraintRight_toRightOf="@+id/rail"
            app:layout_constraintTop_toTopOf="@+id/rail"/>
        <View
            android:id="@+id/ime"
            android:background="#ff383b3a"
            android:layout_width="0dp"
            android:layout_height="@dimen/car_ime_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
        <View
            android:id="@+id/map_ime"
            android:background="#ffe0b0ff"
            android:layout_width="0dp"
            android:layout_height="@dimen/car_ime_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rail_spacer">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
        <View
            android:id="@+id/frx"
            android:background="#aa987654"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/integrated_overlay"
            android:background="#ffff4444"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toRightOf="@+id/activity"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/fullscreen"
        android:background="#aa123456"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/rounded_corner_mask"
        android:background="#7f55b1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
