<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/CsatPostdriveDialog.Title.Panel">
    <TextView
        android:id="@+id/csat_dialog_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/csat_prompt_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CsatPostdriveDialog.Title.Text"/>
    <TextView
        android:id="@+id/csat_dialog_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/csat_title_to_question_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csat_dialog_headline"
        style="@style/CsatPostdriveDialog.Title.Text.Question"/>
</android.support.constraint.ConstraintLayout>
