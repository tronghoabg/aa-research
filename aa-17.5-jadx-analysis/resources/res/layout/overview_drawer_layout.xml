<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/gearhead_sdk_dark_blue_grey_800"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/list_view"
            layout="@layout/paged_list"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/drawer_button"
        android:background="@drawable/gearhead_sdk_header_button_background"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:scaleType="center"
        android:elevation="@dimen/appdecor_status_bar_elevation"/>
    <RelativeLayout
        android:id="@+id/user_switch_loading_holder"
        android:background="@color/gearhead_sdk_dark_blue_grey_900"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.9">
        <ImageView
            android:id="@+id/arrow_image"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_arrow_right_alt_white"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/phone_android_image"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_phone_android"
            android:tint="#ffffff"
            android:layout_toLeftOf="@+id/arrow_image"
            android:layout_alignTop="@+id/arrow_image"/>
        <ImageView
            android:id="@+id/smart_phone_image"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_smartphone_white"
            android:layout_toRightOf="@+id/arrow_image"
            android:layout_alignTop="@+id/arrow_image"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_connected_phone"
            android:layout_below="@+id/arrow_image"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</FrameLayout>
