<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/close_button"
        android:background="?attr/gearheadNotificationIconButtonBackground"
        android:focusable="true"
        android:layout_width="@dimen/notification_close_button_size"
        android:layout_height="@dimen/notification_close_button_size"
        android:contentDescription="@string/notification_close_button_content_desc">
        <ImageView
            android:id="@+id/close_button_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f080505"
            android:scaleType="center"
            android:contentDescription="@null"/>
    </FrameLayout>
</merge>
