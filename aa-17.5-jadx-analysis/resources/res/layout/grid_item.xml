<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <android.support.constraint.ConstraintLayout
        android:layout_gravity="start"
        android:id="@+id/click_container"
        android:background="?attr/gearheadGridItemBackground"
        android:padding="@dimen/grid_item_focus_radius"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/grid_item_max_width">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:visibility="visible"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/grid_icon_bottom_margin"
            android:foreground="@drawable/grid_image_foreground_rounded"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@+id/text_icon_container"
            app:layout_constraintDimensionRatio="h,1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/text_icon_container"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image">
            <RelativeLayout
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/grid_text_row_top_margin"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"
                    style="@style/TextAppearance.Boardwalk.Body3"/>
                <android.support.constraint.ConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/remote_views"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/subtitle"
                    android:layout_alignBottom="@+id/subtitle"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:id="@+id/browse_icon_first"
                        android:layout_width="@dimen/metadata_icon_size"
                        android:layout_height="@dimen/metadata_icon_size"
                        android:tint="@color/gearhead_sdk_body2_light"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/browse_icon_second"
                        android:layout_width="@dimen/metadata_icon_size"
                        android:layout_height="@dimen/metadata_icon_size"
                        android:tint="@color/gearhead_sdk_body2_light"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/browse_icon_first"
                        app:layout_constraintTop_toTopOf="parent"/>
                </android.support.constraint.ConstraintLayout>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/subtitle"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/grid_text_row_top_margin"
                    android:maxLines="1"
                    android:layout_below="@+id/title"
                    android:layout_toEndOf="@+id/remote_views"
                    style="@style/TextAppearance.Boardwalk.Body3.Subtitle"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/browse_icon_new_tri_state"
                android:layout_width="@dimen/metadata_new_icon_tri_state_size"
                android:layout_height="@dimen/metadata_new_icon_tri_state_size"
                android:scaleType="fitXY"
                android:tint="@color/gearhead_sdk_tint_light"/>
        </LinearLayout>
    </android.support.constraint.ConstraintLayout>
</FrameLayout>
