<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.ui.widget.navigation.DetailedNavigationStepView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/turn_container"
        android:paddingTop="@dimen/gearhead_padding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gearhead_padding_2"
        android:paddingEnd="@dimen/gearhead_padding_2">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_padding_1">
            <ImageView
                android:id="@+id/turn_symbol"
                android:layout_width="@dimen/navigation_step_routing_turn_icon_size"
                android:layout_height="@dimen/navigation_step_routing_turn_icon_size"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <TextView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/distance_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gearhead_padding_2"
                style="@style/Widget.Navigation.Text.Display1.Medium"/>
        </LinearLayout>
        <TextView
            android:id="@+id/description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/Widget.Navigation.Text.Body1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/lanes_image_container"
        android:background="@color/boardwalk_gradient_white_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/navigation_step_routing_lanes_image_container_height">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/lanes_image"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/navigation_step_routing_lanes_image_width"
            android:layout_height="@dimen/navigation_step_routing_lanes_image_height"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
    </FrameLayout>
</com.google.android.apps.auto.components.ui.widget.navigation.DetailedNavigationStepView>
