<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.RowListView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/progress_container"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="?attr/templateRowMinHeight">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/templateLoadingSpinnerStyle"/>
    </FrameLayout>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/list_no_items_text"
        android:background="@drawable/no_content_view_focus_ring"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/templateNoContentPaddingHorizontal"
        android:paddingVertical="?attr/templateNoContentPaddingVertical"
        style="?attr/templateRowListEmptyTextStyle"/>
    <com.google.android.apps.auto.components.apphost.view.widgets.common.RowPagedListView
        android:id="@+id/list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:inertialScrollingEnabled="true"
        style="?attr/templateRowListStyle"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/large_image_container"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/large_image"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
    </FrameLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.RowListView>
