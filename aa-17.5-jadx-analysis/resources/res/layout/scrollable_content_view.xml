<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.ScrollableContentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.apps.auto.sdk.ui.PagedScrollBarView
        android:id="@+id/paged_scroll_bar_view"
        android:layout_width="?attr/templateScrollbarWidth"
        android:layout_height="match_parent"/>
    <com.google.android.apps.auto.components.apphost.view.widgets.common.ObservableScrollView
        android:id="@+id/scroll_view"
        android:focusable="false"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/content_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.apps.auto.components.apphost.view.widgets.common.ObservableScrollView>
</com.google.android.apps.auto.components.apphost.view.widgets.common.ScrollableContentView>
