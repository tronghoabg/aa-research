<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.RowContainerViewActionListImpl xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:markerAppearance="?attr/templateListMarkerAppearance">
    <View
        android:layout_gravity="top"
        android:id="@+id/row_divider"
        android:background="?attr/templateDividerColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateDividerThickness"
        android:paddingStart="?attr/templateRowHorizontalHalfPadding"
        android:paddingEnd="?attr/templateRowHorizontalHalfPadding"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:paddingTop="@dimen/template_padding_2"
        android:paddingBottom="@dimen/template_padding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/templateRowMinHeight"
        android:paddingStart="?attr/templateRowHorizontalPadding"
        android:paddingEnd="?attr/templateRowHorizontalPadding">
        <androidx.cardview.widget.CardView
            android:layout_gravity="top"
            android:id="@+id/marker_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="?attr/templateRowMarkerMinSize"
            android:minHeight="?attr/templateRowMarkerMinSize"
            android:layout_marginEnd="@dimen/template_padding_1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/row_divider">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/marker_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"/>
        </androidx.cardview.widget.CardView>
        <FrameLayout
            android:gravity="start"
            android:id="@+id/container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.RowContainerViewActionListImpl>
