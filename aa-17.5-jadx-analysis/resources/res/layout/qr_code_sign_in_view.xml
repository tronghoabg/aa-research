<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.QRCodeSignInView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        app:cardBackgroundColor="@color/template_gray_928"
        app:cardCornerRadius="?attr/templateSignInQRCodeImageCornerRadius">
        <ImageView
            android:id="@+id/qr_code"
            android:layout_width="?attr/templateSignInQRCodeImageWidth"
            android:layout_height="?attr/templateSignInQRCodeImageHeight"
            android:foreground="@drawable/qr_code_background"
            android:tint="?android:attr/textColorPrimary"/>
    </androidx.cardview.widget.CardView>
</com.google.android.apps.auto.components.apphost.view.widgets.common.QRCodeSignInView>
