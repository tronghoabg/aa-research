<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end"
    android:id="@+id/rail_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.constraint.ConstraintLayout
            android:id="@+id/icon_ripple_container"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/facet_bar_widget_touch_target_size"
            android:layout_height="@dimen/facet_bar_widget_touch_target_size"
            android:elevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.apps.auto.components.system.facetbar.widget.SafeShapeableImageView
                android:id="@+id/large_icon"
                android:layout_width="@dimen/rail_widget_primary_icon_width"
                android:layout_height="@dimen/rail_widget_primary_icon_height"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/Widget.Gearhead.Coolwalk.Rail.Largeicon.SquareShapeAppearance"/>
            <com.google.android.apps.auto.components.system.facetbar.widget.SafeShapeableImageView
                android:id="@+id/badge"
                android:layout_width="@dimen/coolwalk_rail_widget_badge_size"
                android:layout_height="@dimen/coolwalk_rail_widget_badge_size"
                app:layout_constraintBottom_toBottomOf="@+id/badge_spacer"
                app:layout_constraintEnd_toEndOf="@+id/badge_spacer"
                style="@style/Widget.Gearhead.Coolwalk.Rail.Largeicon.Badge"/>
            <Space
                android:id="@+id/badge_spacer"
                android:layout_width="@dimen/coolwalk_rail_widget_badge_offset"
                android:layout_height="@dimen/coolwalk_rail_widget_badge_offset"
                app:layout_constraintStart_toEndOf="@+id/large_icon"
                app:layout_constraintTop_toBottomOf="@+id/large_icon"/>
        </android.support.constraint.ConstraintLayout>
        <FrameLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_action_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/background_pill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/rail_coolwalk_item_margin"
                android:layout_marginEnd="@dimen/coolwalk_rail_widget_background_pill_margin_start"
                android:backgroundTint="?attr/colorSurface"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/widget_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/actions_end_margin"
                    android:layout_width="@dimen/rail_coolwalk_item_margin"
                    android:layout_height="match_parent"/>
                <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
                    android:id="@+id/left_action_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                        android:id="@+id/left_action"
                        android:layout_width="@dimen/facet_bar_widget_touch_target_size"
                        android:layout_height="@dimen/facet_bar_widget_touch_target_size"
                        android:layout_marginStart="@dimen/rail_coolwalk_item_margin"
                        style="@style/Widget.Gearhead.Coolwalk.Rail.IconButton"/>
                </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
                <View
                    android:id="@+id/actions_end_center_margin"
                    android:layout_width="@dimen/rail_coolwalk_item_margin"
                    android:layout_height="match_parent"/>
                <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
                    android:id="@+id/center_action_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                        android:id="@+id/center_action"
                        android:layout_width="@dimen/facet_bar_widget_touch_target_size"
                        android:layout_height="@dimen/facet_bar_widget_touch_target_size"
                        android:layout_marginStart="@dimen/rail_coolwalk_item_margin"
                        style="@style/Widget.Gearhead.Coolwalk.Rail.IconButton"/>
                </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
                <View
                    android:id="@+id/actions_start_center_margin"
                    android:layout_width="@dimen/rail_coolwalk_item_margin"
                    android:layout_height="match_parent"/>
                <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
                    android:id="@+id/right_action_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                        android:id="@+id/right_action"
                        android:layout_width="@dimen/facet_bar_widget_touch_target_size"
                        android:layout_height="@dimen/facet_bar_widget_touch_target_size"
                        android:layout_marginStart="@dimen/rail_coolwalk_item_margin"
                        style="@style/Widget.Gearhead.Coolwalk.Rail.IconButton"/>
                </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
                <View
                    android:id="@+id/actions_start_margin"
                    android:layout_width="@dimen/rail_coolwalk_item_margin"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/content_text_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/rail_widget_text_size"
                        android:textColor="?android:attr/textColorPrimary"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/first_line_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        style="?style/TextAppearance.Gearhead.Coolwalk.Body3.Medium"/>
                    <TextView
                        android:textSize="@dimen/rail_widget_small_text_size"
                        android:textColor="?android:attr/textColorSecondary"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/second_line_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        style="?style/TextAppearance.Gearhead.Coolwalk.Body3.Medium"/>
                </LinearLayout>
                <Space
                    android:id="@+id/icon_spacer"
                    android:layout_width="@dimen/facet_bar_widget_touch_target_size"
                    android:layout_height="@dimen/facet_bar_widget_touch_target_size"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </FrameLayout>
    </android.support.constraint.ConstraintLayout>
</FrameLayout>
