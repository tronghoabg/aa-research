<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:layout_width="?attr/templateRoutingStepsCardContentContainerDefaultWidth"
    android:layout_height="0dp"
    android:layout_marginBottom="?attr/templateCardContentContainerBottomMargin"
    android:layout_marginStart="?attr/templateCardContentContainerStartMargin"
    app:isCarBorderBlendColor="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintHeight_default="wrap"
    app:layout_constraintHeight_min="?attr/templateRoutingStepsCardContentContainerMinHeight"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0"
    style="?attr/templateCardRoutingContentContainerStyle">
    <include
        android:id="@+id/message_view"
        android:visibility="gone"
        layout="@layout/message_view"/>
    <include
        android:id="@+id/progress_view"
        android:visibility="gone"
        layout="@layout/progress_view"/>
    <include
        android:id="@+id/floating_nav_bar_view"
        android:visibility="gone"
        layout="@layout/floating_nav_bar_view"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/steps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/detailed_step_view"
            layout="@layout/detailed_step_view"/>
        <include
            android:id="@+id/compact_step_view"
            layout="@layout/compact_step_view"/>
        <FrameLayout
            android:id="@+id/junction_image_container"
            android:background="?attr/templateRoutingJunctionImageBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/junction_image"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
        </FrameLayout>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView>
