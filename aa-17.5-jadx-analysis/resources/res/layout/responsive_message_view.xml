<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/responsive_message_view_tall"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/template_padding_2"
    android:layout_marginBottom="@dimen/template_padding_2"
    android:layout_marginStart="@dimen/template_padding_2"
    android:layout_marginEnd="@dimen/template_padding_2">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/message_image"
        android:visibility="gone"
        android:layout_width="?attr/templateResponsiveNavCardImageSizeSmall"
        android:layout_height="?attr/templateResponsiveNavCardImageSizeSmall"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/template_padding_2">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/message_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Template.Text.Body2"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_1"
            android:alpha="@dimen/template_responsive_card_body3_alpha"
            style="@style/Widget.Template.Text.Body3"/>
    </LinearLayout>
</LinearLayout>
