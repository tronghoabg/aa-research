<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSecondaryContainer"
    app:cardCornerRadius="@dimen/csat_dialog_card_corner_radius"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/padding_p1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/csat_dialog_choice_button_min_height">
        <FrameLayout
            android:id="@+id/csat_dialog_choice_icon_container"
            android:layout_width="@dimen/csat_dialog_choice_icon_container_size"
            android:layout_height="@dimen/csat_dialog_choice_icon_container_size"
            android:layout_marginStart="@dimen/padding_p0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/csat_dialog_choice_icon"
                android:layout_width="@dimen/csat_dialog_choice_icon_size"
                android:layout_height="@dimen/csat_dialog_choice_icon_size"
                android:src="@android:color/transparent"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSecondaryContainer"
                android:tintMode="src_in"/>
        </FrameLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:gravity="start|center_vertical"
            android:id="@+id/csat_dialog_choice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_p1"
            android:layout_marginEnd="@dimen/padding_p1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csat_dialog_choice_icon_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
