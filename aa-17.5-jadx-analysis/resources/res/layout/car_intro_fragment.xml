<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/CarIntroTheme"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/start_auto_prompt"
        android:paddingBottom="56dp"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:text="@string/car_select_android_auto_icon_title"
        android:layout_above="@+id/start_auto_logo"
        android:layout_centerHorizontal="true"
        android:fontFamily="?attr/titleLegacySansSerifMediumFontFamily"/>
    <ImageView
        android:id="@+id/start_auto_logo"
        android:layout_width="248dp"
        android:layout_height="248dp"
        android:layout_centerInParent="true"
        app:srcCompat="@drawable/ic_android_auto_intro_logo"/>
    <TextView
        android:id="@+id/dismiss"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/car_intro_screen_dismiss"
        android:layout_alignParentBottom="true"
        android:paddingEnd="24dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
