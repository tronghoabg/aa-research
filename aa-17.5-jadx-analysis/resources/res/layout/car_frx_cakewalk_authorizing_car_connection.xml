<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:background="?attr/carFrxBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:paddingLeft="@dimen/car_frx_margin_edge"
            android:paddingTop="@dimen/car_frx_cakewalk_top_margin"
            android:paddingRight="@dimen/car_frx_margin_edge"
            android:paddingBottom="@dimen/car_frx_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/illustration"
                android:layout_width="@dimen/car_frx_small_icon_size"
                android:layout_height="@dimen/car_frx_small_icon_size"
                android:layout_marginBottom="@dimen/car_frx_app_icon_margin"
                style="@style/CarFrxAndroidAutoIconStyle"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/car_frx_auth_car_title_bottom_margin"
                style="@style/TextAppearance.FrxTitle.Cakewalk.Phone"/>
            <TextView
                android:textColorLink="@color/frx_link_color"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/car_frx_auth_car_title_bottom_margin"
                android:drawablePadding="@dimen/car_frx_margin"
                style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
            <TextView
                android:textColorLink="?attr/carFrxTextColorLink"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/notifications"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/car_frx_margin"
                style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
