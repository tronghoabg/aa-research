<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rail_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rail"
        android:background="?android:attr/windowBackground"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:id="@+id/launcher_and_dashboard_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/coolwalk_launcher_dashboard_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/launcher_and_dashboard_icon"
                android:layout_width="@dimen/facet_bar_touch_target_size"
                android:layout_height="@dimen/facet_bar_touch_target_size"
                android:checkable="false"
                app:icon="@drawable/ic_dashboard_icon_lhd"
                style="@style/Widget.Gearhead.Coolwalk.Rail.Button"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
        <FrameLayout
            android:id="@+id/assistant_icon_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/facet_bar_touch_target_size"
            android:layout_height="@dimen/facet_bar_touch_target_size"
            app:layout_constraintBottom_toTopOf="@+id/launcher_and_dashboard_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <android.support.v4.app.FragmentContainerView
                android:layout_gravity="center"
                android:id="@+id/live_fragment"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="@dimen/coolwalk_rail_hotseat_button_icon_size"
                android:layout_height="@dimen/coolwalk_rail_hotseat_button_icon_size"/>
            <com.google.android.apps.auto.components.system.facetbar.CircleOverlayView
                android:layout_gravity="center"
                android:id="@+id/circle_overlay"
                android:visibility="gone"
                android:layout_width="@dimen/coolwalk_rail_hotseat_button_icon_size"
                android:layout_height="@dimen/coolwalk_rail_hotseat_button_icon_size"/>
            <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                    android:id="@+id/assistant_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/facet_bar_touch_target_size"
                    android:layout_height="@dimen/facet_bar_touch_target_size"
                    android:checkable="false"
                    app:icon="@drawable/gs_mic_fill1_vd_theme_24"
                    style="@style/Widget.Gearhead.Coolwalk.Rail.Button"/>
            </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ongoing_widget_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/assistant_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="@dimen/rail_widget_max_width">
            <com.google.android.apps.auto.components.system.facetbar.widget.RailWidgetView
                android:id="@+id/ongoing_widget"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:collapsed="true"/>
        </FrameLayout>
        <FrameLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dock_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rail_coolwalk_rail_margin"
            android:layout_marginEnd="@dimen/rail_coolwalk_rail_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5">
            <include
                android:visibility="invisible"
                layout="@layout/sys_ui_rail_hotseat_vertical"/>
            <com.google.android.apps.auto.components.system.facetbar.widget.RailWidgetView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/rail_ongoing_widget"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="@dimen/rail_widget_max_width"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/etc_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_gearhead_etc_rail_icon"
            android:tint="?attr/colorOnSurface"
            android:alpha="@dimen/coolwalk_etc_icon_opacity"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/status_bar"/>
        <View
            android:id="@+id/rail_invisible_scrim"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <android.support.v4.app.FragmentContainerView
            android:name="com.google.android.apps.auto.components.system.statusbar.RailStatusBarFragment"
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edge_barrier"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/edge_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="false"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="resize_button_ghost, edge_spacer"/>
        <Space
            android:id="@+id/resize_button_ghost"
            android:visibility="gone"
            android:layout_width="@dimen/resize_button_long_side_size"
            android:layout_height="@dimen/resize_button_short_side_size"
            android:layout_marginTop="@dimen/coolwalk_gutter_padding"
            app:layout_constraintTop_toTopOf="parent"/>
        <Space
            android:id="@+id/edge_spacer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rail_edge_margin"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/resize_button_tap_target"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/resize_tap_target_size"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.apps.auto.components.system.facetbar.ResizeButton
                android:id="@+id/resize_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coolwalk_gutter_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:orientation="horizontal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/native_rail"
        android:background="?android:attr/windowBackground"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/coolwalk_launcher_dashboard_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/native_app_exit_icon"
                android:layout_width="@dimen/facet_bar_touch_target_size"
                android:layout_height="@dimen/facet_bar_touch_target_size"
                android:checkable="false"
                app:icon="0x7f08093a"
                style="@style/Widget.Gearhead.Coolwalk.Rail.Button"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coolwalk_launcher_dashboard_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/native_app_back_icon"
                android:layout_width="@dimen/facet_bar_touch_target_size"
                android:layout_height="@dimen/facet_bar_touch_target_size"
                android:checkable="false"
                app:icon="@drawable/gs_arrow_back_vd_theme_48"
                style="@style/Widget.Gearhead.Coolwalk.Rail.Button"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <android.support.v4.app.FragmentContainerView
        android:layout_gravity="bottom"
        android:id="@+id/voice_plate"
        android:background="?android:attr/windowBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
