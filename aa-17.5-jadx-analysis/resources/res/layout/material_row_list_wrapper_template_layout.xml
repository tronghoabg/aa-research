<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <com.google.android.apps.auto.components.apphost.view.widgets.common.MaterialTitleHeaderView
        android:id="@+id/header_view"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateHeaderHeight"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/row_header_divider"
        android:background="?attr/templateDividerColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateDividerThickness"/>
    <com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout
        android:id="@+id/park_only_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/content_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                layout="@layout/content_view"/>
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/row_action_list_divider"
                android:background="?attr/templateDividerColor"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/templateDividerThickness"/>
            <com.google.android.apps.auto.components.apphost.basewidgets.action.ui.ContentActionsViewShim
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/row_actions_view_shim"
                android:paddingTop="@dimen/padding_p3"
                android:paddingBottom="?attr/templateRowActionsBottomMargin"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="?attr/templateRowActionPaddingHorizontal"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="end|bottom"
            android:orientation="vertical"
            android:id="@+id/floating_action_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/padding_p3"
            android:layout_marginBottom="@dimen/padding_p3"
            android:baselineAligned="false">
            <include
                android:id="@+id/top_floating_action_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_p4"
                layout="@layout/material_action_button"/>
            <include
                android:id="@+id/bottom_floating_action_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/material_action_button"/>
        </LinearLayout>
    </com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout>
</LinearLayout>
