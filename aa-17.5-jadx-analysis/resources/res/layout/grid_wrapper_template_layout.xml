<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <ImageView
        android:id="@+id/grid_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="@dimen/grid_wallpaper_alpha"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <include
                android:layout_width="0dp"
                android:layout_height="?attr/templateHeaderHeight"
                android:layout_weight="1"
                layout="@layout/full_screen_header_layout"/>
            <include
                android:id="@+id/action_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/template_edge_column_margin"
                layout="@layout/action_strip_view_full_template"/>
        </LinearLayout>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout
            android:id="@+id/park_only_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/grid_content_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/content_view"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/template_padding_1"
                android:layout_marginBottom="@dimen/template_padding_2"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/floating_action_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true">
                    <include
                        android:id="@+id/floating_action_button2"
                        android:visibility="gone"
                        layout="@layout/floating_action_button_view"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/template_padding_1"/>
                    <include
                        android:id="@+id/floating_action_button"
                        layout="@layout/floating_action_button_view"/>
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout>
    </LinearLayout>
</FrameLayout>
