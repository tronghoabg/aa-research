<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="@dimen/gearhead_baseline_grid_8x"
        android:layout_height="@dimen/gearhead_baseline_grid_8x"
        android:layout_marginBottom="@dimen/gearhead_baseline_grid_3.5x"
        android:src="@drawable/quantum_gm_ic_warning_amber_vd_theme_24"
        android:tint="?android:attr/textColorPrimary"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/map_issue_text"
        android:maxLines="2"
        style="@style/Widget.Gearhead.Coolwalk.TextView.Subtitle"/>
    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
        android:textSize="@dimen/retry_text_size"
        android:layout_gravity="center"
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/gearhead_baseline_grid_8x"
        android:layout_marginTop="@dimen/retry_button_top_margin"
        android:minWidth="@dimen/retry_min_width"
        android:text="@string/retry_button_text"
        android:checkable="false"
        android:paddingHorizontal="@dimen/gearhead_baseline_grid_2x"
        style="@style/Widget.Gearhead.Coolwalk.TextView.Title"/>
</LinearLayout>
