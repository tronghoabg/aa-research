<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@android:color/transparent"
    android:paddingLeft="@dimen/car_margin_small"
    android:paddingRight="@dimen/car_margin_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/companion_settings_row_height">
    <ImageView
        android:id="@+id/car_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?android:attr/textColorSecondary"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/car_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="30dp"
        android:layout_alignParentStart="true"
        style="@style/TextAppearance.M3.CompanionSettings"/>
</RelativeLayout>
