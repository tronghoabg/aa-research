<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
    android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
    android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
    <ImageView
        android:id="@+id/data_notice_entry_icon"
        android:layout_width="@dimen/gm3_scrolling_element_icon_size"
        android:layout_height="@dimen/gm3_scrolling_element_icon_size"
        android:adjustViewBounds="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
        android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
        android:layout_toEndOf="@+id/data_notice_entry_icon"
        android:layout_alignParentEnd="true">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start"
                android:id="@+id/data_notice_entry_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/data_notice_entry_arrow"
                android:layout_alignParentStart="true"
                style="?attr/textAppearanceTitleLarge"/>
            <ImageView
                android:id="@+id/data_notice_entry_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_centerHorizontal="true"
                android:paddingStart="@dimen/gm3_data_notice_expand_icon_padding_start"
                android:paddingEnd="@dimen/gm3_data_notice_expand_icon_padding_end"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/data_notice_entry_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textAppearanceTitleSmall"/>
    </LinearLayout>
</RelativeLayout>
