<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.navigation.DetailedStepView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/turn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_padding_3"
        android:layout_marginStart="@dimen/template_padding_3"
        android:layout_marginEnd="@dimen/template_padding_3">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/turn_symbol"
                android:layout_width="?attr/templateRoutingTurnIconSize"
                android:layout_height="?attr/templateRoutingTurnIconSize"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/template_padding_2"/>
            <TextView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/distance_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Template.Text.Display2.Medium"/>
        </LinearLayout>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_0"
            android:maxLines="2"
            style="@style/Widget.Template.Text.Body2"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/lanes_image_container"
        android:background="?attr/templateRoutingLanesImageBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateRoutingLanesImageContainerHeight"
        android:layout_marginTop="@dimen/template_padding_1"
        android:paddingHorizontal="?attr/templateRoutingLanesImageContainerHorizontalPadding"
        android:paddingVertical="?attr/templateRoutingLanesImageContainerVerticalPadding">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/lanes_image"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
    </FrameLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.navigation.DetailedStepView>
