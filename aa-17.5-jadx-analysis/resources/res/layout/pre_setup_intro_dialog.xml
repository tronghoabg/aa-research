<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
    android:filterTouchesWhenObscured="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="@dimen/dialog_margin_bottom"
        android:text="@string/car_setup_bottom_sheet_welcome_download_title"
        android:drawableTop="@drawable/android_auto_gm3_logo"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"
        android:layout_marginStart="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginEnd="@dimen/bottom_sheet_parent_layout_margin"/>
    <TextView
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_margin_top"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
        android:text="@string/car_setup_bottom_sheet_welcome_download_body"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_illustration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_margin_top"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
        android:src="@drawable/phone_frx_default"
        android:adjustViewBounds="true"/>
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
        <com.google.android.material.button.MaterialButton
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:id="@+id/dialog_decline_button"
            android:paddingLeft="@dimen/button_padding_horizontal"
            android:paddingRight="@dimen/button_padding_horizontal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_dont_show_again"
            android:layout_marginStart="@dimen/button_padding_horizontal"
            android:layout_marginEnd="@dimen/button_padding_horizontal"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/dialog_accept_button"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/materialButtonOutlinedStyle"/>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:id="@+id/dialog_accept_button"
            android:paddingLeft="@dimen/button_padding_horizontal"
            android:paddingRight="@dimen/button_padding_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/button_padding_horizontal"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/dialog_decline_button"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginLeft="@dimen/button_padding_horizontal"
            style="?attr/materialIconButtonFilledStyle"/>
    </android.support.constraint.ConstraintLayout>
</LinearLayout>
