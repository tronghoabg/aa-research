<?xml version="1.0" encoding="utf-8"?>
<ViewAnimator xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.apps.auto.components.system.cluster.media.InsetConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:id="@+id/content_start_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/cluster_content_start_end_margin"
            app:layout_constraintEnd_toStartOf="@+id/insetConstraint_systemWindow_left"
            app:layout_constraintStart_toStartOf="@+id/insetConstraint_systemWindow_left"/>
        <Space
            android:id="@+id/content_end_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/cluster_content_start_end_margin"
            app:layout_constraintEnd_toStartOf="@+id/insetConstraint_systemWindow_right"
            app:layout_constraintStart_toStartOf="@+id/insetConstraint_systemWindow_right"/>
        <Space
            android:id="@+id/content_top_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/insetConstraint_systemWindow_top"
            app:layout_constraintTop_toTopOf="@+id/insetConstraint_systemWindow_top"/>
        <Space
            android:id="@+id/content_bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/insetConstraint_systemWindow_bottom"
            app:layout_constraintTop_toTopOf="@+id/insetConstraint_systemWindow_bottom"/>
        <Space
            android:id="@+id/centered_content_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="@+id/content_end_spacer"
            app:layout_constraintStart_toStartOf="@+id/content_start_spacer"
            app:layout_constraintWidth_max="@dimen/gearhead_secondary_media_content_max_width"/>
        <com.google.android.apps.auto.components.ui.image.CrossfadeImageView
            android:id="@+id/background_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/playback_scrim"
            android:background="@color/boardwalk_gradient_black_64"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/background_image"
            app:layout_constraintEnd_toEndOf="@+id/background_image"
            app:layout_constraintStart_toStartOf="@+id/background_image"
            app:layout_constraintTop_toTopOf="@+id/background_image"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/album_art_thumbnail"
            android:layout_width="@dimen/cluster_media_album_art_size"
            android:layout_height="@dimen/cluster_media_album_art_size"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/centered_content_spacer"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:layout_constraintVertical_chainStyle="packed"
            app:shapeAppearanceOverlay="@style/ClusterAlbumArtShapeAppearance"/>
        <Space
            android:id="@+id/source_badge_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cluster_media_badge_spacer_margin"
            android:layout_marginStart="@dimen/cluster_media_badge_spacer_margin"
            app:layout_constraintStart_toEndOf="@+id/album_art_thumbnail"
            app:layout_constraintTop_toBottomOf="@+id/album_art_thumbnail"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/source_badge"
            android:layout_width="@dimen/cluster_media_badge_size"
            android:layout_height="@dimen/cluster_media_badge_size"
            app:layout_constraintBottom_toBottomOf="@+id/source_badge_spacer"
            app:layout_constraintEnd_toEndOf="@+id/source_badge_spacer"
            app:shapeAppearanceOverlay="@style/CircleShapeAppearance"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="@dimen/cluster_media_text_view_size"
            android:layout_marginTop="@dimen/gearhead_padding_2"
            android:layout_marginStart="@dimen/gearhead_padding_2"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintEnd_toEndOf="@+id/centered_content_spacer"
            app:layout_constraintStart_toEndOf="@+id/album_art_thumbnail"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Widget.Gearhead.Coolwalk.TextView.Title"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="@dimen/cluster_media_text_view_size"
            android:layout_marginStart="@dimen/gearhead_padding_2"
            android:layout_marginEnd="@dimen/gearhead_padding_1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/progress"
            app:layout_constraintEnd_toStartOf="@+id/explicit_logo"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/album_art_thumbnail"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintWidth_default="wrap"
            style="@style/Widget.Gearhead.Coolwalk.TextView.Subtitle"/>
        <ImageView
            android:id="@+id/explicit_logo"
            android:layout_width="@dimen/cluster_explicit_content_logo_size"
            android:layout_height="@dimen/cluster_explicit_content_logo_size"
            android:src="0x7f080a49"
            android:tint="@color/boardwalk_white"
            app:layout_constraintBottom_toBottomOf="@+id/subtitle"
            app:layout_constraintEnd_toStartOf="@+id/hd_radio_logo"
            app:layout_constraintStart_toEndOf="@+id/subtitle"
            app:layout_constraintTop_toTopOf="@+id/subtitle"/>
        <ImageView
            android:id="@+id/hd_radio_logo"
            android:layout_width="@dimen/cluster_hd_radio_logo_size"
            android:layout_height="@dimen/cluster_hd_radio_logo_size"
            android:tint="@color/boardwalk_white"
            app:layout_constraintBottom_toBottomOf="@+id/subtitle"
            app:layout_constraintEnd_toEndOf="@+id/centered_content_spacer"
            app:layout_constraintStart_toEndOf="@+id/explicit_logo"
            app:layout_constraintTop_toTopOf="@+id/subtitle"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="0dp"
            android:layout_height="@dimen/cluster_media_progress_height"
            android:layout_marginTop="@dimen/gearhead_padding_2"
            app:indicatorColor="@color/boardwalk_white"
            app:layout_constraintBottom_toTopOf="@+id/elapsed_time"
            app:layout_constraintEnd_toEndOf="@+id/centered_content_spacer"
            app:layout_constraintStart_toStartOf="@+id/centered_content_spacer"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            app:trackColor="@color/cluster_coolwalk_legacy_progress_surface"
            app:trackCornerRadius="@fraction/cluster_media_progress_radius_fraction"
            app:trackThickness="@dimen/cluster_media_progress_height"/>
        <TextView
            android:id="@+id/elapsed_time"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cluster_elapsed_time_height"
            android:layout_marginTop="@dimen/gearhead_padding_2"
            app:layout_constraintBottom_toBottomOf="@+id/content_bottom_spacer"
            app:layout_constraintStart_toStartOf="@+id/centered_content_spacer"
            app:layout_constraintTop_toBottomOf="@+id/progress"
            style="@style/Widget.Gearhead.Coolwalk.TextView.Subtitle"/>
    </com.google.android.apps.auto.components.system.cluster.media.InsetConstraintLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/app_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</ViewAnimator>
