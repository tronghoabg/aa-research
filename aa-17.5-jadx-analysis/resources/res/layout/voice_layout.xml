<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/card_header_layout"/>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/button_with_description"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/voice_button"
                android:layout_width="?attr/templateMessageIconSize"
                android:layout_height="?attr/templateMessageIconSize"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/state_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/template_padding_4"
                style="?attr/templateMessageTitleTextStyle"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
