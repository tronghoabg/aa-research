<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        android:id="@+id/number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/dial_a_number"
        android:maxLines="2"
        android:layout_weight="1"
        android:paddingVertical="@dimen/material_dialpad_number_padding"/>
    <RelativeLayout
        android:id="@+id/delete"
        android:visibility="gone"
        android:layout_width="@dimen/material_dialpad_action_button_size"
        android:layout_height="@dimen/material_dialpad_action_button_size"
        android:layout_marginLeft="@dimen/padding_p4">
        <ImageButton
            android:id="@+id/imageButton"
            android:background="@drawable/gearhead_oval_focus_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gs_backspace_vd_theme_24"
            android:scaleType="center"
            android:tint="@color/material_dialpad_delete_button_color_selector"
            android:layout_alignTop="@+id/imageButton"
            android:layout_alignBottom="@+id/imageButton"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:layout_alignStart="@+id/imageButton"
            android:layout_alignEnd="@+id/imageButton"/>
    </RelativeLayout>
</LinearLayout>
