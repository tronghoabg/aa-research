<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wifi_start_notification"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/wifi_start_notification_content"
        android:background="@color/wifi_start_notification_background"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="@drawable/gearhead_sdk_masked_ripple_background"
        android:layout_weight="2">
        <ImageView
            android:id="@+id/wifi_start_notification_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_android_auto"
            android:scaleType="fitCenter"
            android:tint="@color/wifi_start_notification_text"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/wifi_start_notification_text"
            android:id="@+id/wifi_start_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wireless_capable_car_found_notification_title"/>
    </LinearLayout>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/wifi_start_notification_actions_container"
        android:background="@color/wifi_start_notification_background_dark"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <Button
            android:textColor="@color/wifi_start_notification_text"
            android:ellipsize="end"
            android:id="@+id/start_button"
            android:background="@color/wifi_start_notification_background_dark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/gearhead_sdk_masked_ripple_background"
            android:text="@string/wireless_capable_car_found_notification_action"
            android:textAllCaps="true"/>
    </FrameLayout>
</LinearLayout>
