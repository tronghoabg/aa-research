<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/carFrxBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/illustration_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_frx_margin"
                android:layout_marginRight="@dimen/car_frx_margin"
                android:layout_marginBottom="@dimen/car_frx_illustration_wrapper_margin_bottom">
                <ImageView
                    android:id="@+id/illustration"
                    android:background="@android:color/transparent"
                    android:layout_width="@dimen/car_frx_illustration_size"
                    android:layout_height="@dimen/car_frx_illustration_size"
                    android:layout_marginLeft="@dimen/car_frx_illustration_margin"
                    android:layout_marginTop="@dimen/car_frx_illustration_margin"
                    android:layout_marginRight="@dimen/car_frx_illustration_margin"
                    android:layout_marginBottom="@dimen/car_frx_illustration_margin"
                    android:src="0x7f08018d"
                    android:scaleType="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/text_container"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_frx_margin_edge"
                android:layout_marginRight="@dimen/car_frx_margin_edge"
                android:layout_marginBottom="@dimen/car_frx_margin"
                android:layout_below="@+id/illustration_wrapper">
                <TextView
                    android:gravity="center"
                    android:id="@+id/title"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/car_frx_title_margin_bottom"
                    android:text="@string/car_frx_device_incompatible_no_vanagon_title"
                    style="@style/TextAppearance.FrxTitle"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/button_bar"
                android:paddingTop="@dimen/car_frx_button_space"
                android:paddingBottom="@dimen/car_frx_button_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/cancel_button"
                    android:visibility="visible"
                    android:layout_width="@dimen/car_frx_button_width"
                    android:layout_height="wrap_content"
                    android:maxHeight="@dimen/car_frx_button_maxHeight"
                    android:minHeight="@dimen/car_frx_button_height"
                    android:text="@string/car_setup_exit"
                    style="@style/CarFrxButton.Continue"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
