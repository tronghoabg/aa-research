<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet_error"
    android:paddingLeft="@dimen/bottom_sheet_side_margin"
    android:paddingTop="@dimen/bottom_sheet_error_illustration_top_padding"
    android:paddingRight="@dimen/bottom_sheet_side_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bs_illustration"
        android:background="@color/bottom_sheet_illustration_background"
        android:layout_width="@dimen/bottom_sheet_error_illustration_size"
        android:layout_height="@dimen/bottom_sheet_error_illustration_size"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textColor="@color/bottom_sheet_text_color"
        android:gravity="center"
        android:id="@+id/bs_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bottom_sheet_illustration_top_margin"
        android:layout_marginBottom="@dimen/bottom_sheet_title_bottom_margin"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="@color/bottom_sheet_text_color"
        android:gravity="center"
        android:id="@+id/bs_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_error_body_text_bottom_margin"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceSubtitle2"
        android:textColor="@color/bottom_sheet_decline_button_text"
        android:gravity="center"
        android:id="@+id/bs_accept_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_text_button_text_bottom_margin"
        android:minHeight="@dimen/bottom_sheet_apps_layout_button_height"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>
