<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/content"
    android:background="@drawable/quality_tester_report_row_background"
    android:paddingTop="@dimen/app_quality_test_report_row_top_padding"
    android:paddingBottom="@dimen/app_quality_test_report_row_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/app_quality_test_report_row_top_margin"
    android:paddingStart="@dimen/app_quality_test_report_row_start_padding"
    android:paddingEnd="@dimen/app_quality_test_report_row_end_padding">
    <ImageView
        android:id="@+id/report_icon"
        android:layout_width="@dimen/app_quality_test_report_icon_width"
        android:layout_height="@dimen/app_quality_test_report_icon_height"
        android:layout_marginEnd="@dimen/app_quality_test_report_icon_end_margin"/>
    <android.support.v7.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/summary_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/app_quality_test_report_text_inner_padding"
            style="@style/TextAppearance.AppCompat.Body1"/>
        <TextView
            android:id="@+id/metadata_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/app_quality_test_report_text_inner_padding"
            style="@style/TextAppearance.AppCompat.Small"/>
        <TextView
            android:autoLink="web"
            android:id="@+id/recommendation_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/app_quality_test_report_text_inner_padding"
            style="@style/TextAppearance.AppCompat.Small"/>
    </android.support.v7.widget.LinearLayoutCompat>
</LinearLayout>
