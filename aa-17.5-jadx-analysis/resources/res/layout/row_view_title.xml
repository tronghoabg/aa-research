<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
        android:id="@+id/row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/row_title_secondary_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/templateRowTitleStyle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/row_title_secondary_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/row_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/row_title"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:id="@+id/row_secondary_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constrainedWidth="true"
            style="?attr/templateRowTitleStyle"/>
        <FrameLayout
            android:id="@+id/row_decoration_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="?attr/templateRowTextHorizontalPadding"
            android:paddingEnd="0dp">
            <TextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/row_decoration_text"
                android:background="@drawable/row_decoration_background"
                android:paddingLeft="?attr/templateRowDecorationPadding"
                android:paddingRight="?attr/templateRowDecorationPadding"
                android:layout_width="wrap_content"
                android:layout_height="?attr/templateRowDecorationHeight"
                android:minWidth="?attr/templateRowDecorationWidth"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:backgroundTint="?attr/templateRowDecorationDefaultBackgroundColor"
                style="?attr/templateRowDecorationTextStyle"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
