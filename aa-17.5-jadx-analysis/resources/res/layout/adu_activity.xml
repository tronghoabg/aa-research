<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.apps.auto.components.drawer.MotionFilteringDrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.gearhead.appdecor.TopDownInsetDispatchFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.gearhead.appdecor.AppContentLayout
                android:id="@+id/content_view_container"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/car_app_bar_background"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
                android:alpha="0"
                android:elevation="@dimen/appdecor_status_bar_elevation"/>
        </com.google.android.gearhead.appdecor.TopDownInsetDispatchFrameLayout>
        <com.google.android.gearhead.appdecor.DrawerContentLayout
            android:layout_gravity="start"
            android:id="@+id/drawer_content"
            android:background="@color/drawer_background"
            android:fitsSystemWindows="true"
            android:layout_width="@dimen/gearhead_sdk_drawer_standard_width"
            android:layout_height="match_parent"/>
    </com.google.android.apps.auto.components.drawer.MotionFilteringDrawerLayout>
    <FrameLayout
        android:id="@+id/system_layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/status_bar_container"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.gearhead.appdecor.StatusBarView
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gearhead_sdk_drawer_header_height"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/unlimited_browsing_exit_header"
        android:visibility="gone"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_cardview_overlay_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_browse_notification_margin"
        android:layout_marginStart="@dimen/content_browse_notification_margin"
        android:layout_marginEnd="@dimen/content_browse_notification_margin_end"
        app:cardBackgroundColor="@color/gearhead_sdk_blue_grey_800"
        app:cardCornerRadius="@dimen/gearhead_sdk_card_view_corner_radius"
        app:cardElevation="@dimen/gearhead_sdk_card_view_elevation">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/content_browse_notification_height">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/unlimited_browsing_exit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/content_browse_park_to_continue"
                android:layout_weight="1"
                android:paddingStart="@dimen/content_browse_notification_text_padding"
                style="@style/GearheadSdkContentBrowseNotification"/>
            <TextView
                android:textColor="@color/unlimited_browsing_exit_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/unlimited_browsing_exit_button"
                android:background="?attr/gearheadLockoutExitButtonBackground"
                android:paddingTop="@dimen/unlimited_browsing_exit_vertical_padding"
                android:paddingBottom="@dimen/unlimited_browsing_exit_vertical_padding"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/content_browse_unlimited_browsing_exit"
                android:textAllCaps="true"
                android:paddingStart="@dimen/unlimited_browsing_exit_horizontal_padding"
                android:paddingEnd="@dimen/unlimited_browsing_exit_horizontal_padding"
                android:layout_marginStart="@dimen/unlimited_browsing_exit_margin_start"
                android:layout_marginEnd="@dimen/unlimited_browsing_exit_margin_end"
                style="@style/GearheadSdkContentBrowseNotification"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
