<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Template.Card"
    android:focusable="false"
    android:layout_width="?attr/templateCardContentContainerDefaultWidth"
    android:layout_height="0dp"
    android:layout_marginStart="?attr/templateCardContentContainerStartMargin"
    app:cardBorderWidth="0dp"
    app:isCarBorderBlendColor="true"
    app:layout_constraintHeight_default="wrap"
    app:layout_constraintHeight_min="?attr/templateCardContentContainerMinHeight"
    app:layout_constraintVertical_bias="0"
    style="?attr/templateCardContentContainerStyle">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/header_container"
            layout="@layout/card_header_layout"/>
        <View
            android:background="?attr/templateDividerColor"
            android:layout_width="match_parent"
            android:layout_height="?attr/templateDividerThickness"/>
        <include
            android:id="@+id/action_strip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/template_edge_column_margin"
            layout="@layout/action_strip_view_full_template"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout
            android:id="@+id/park_only_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="2dp">
                <include
                    android:id="@+id/content_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    layout="@layout/content_view"/>
                <View
                    android:id="@+id/row_action_list_divider"
                    android:background="?attr/templateDividerColor"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/templateDividerThickness"/>
                <include
                    android:layout_gravity="center"
                    android:id="@+id/action_button_list_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/template_padding_1"
                    layout="@layout/action_button_list_view"/>
                <include
                    android:id="@+id/action_button_list_view_stacked"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/template_padding_1"
                    layout="@layout/action_button_list_view_stacked"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="end|bottom"
                android:visibility="gone"
                android:layout_width="?attr/templateFloatingActionHeight"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/template_padding_2"
                android:layout_marginEnd="@dimen/template_floating_action_button_end_margin">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/floating_action_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true">
                    <include
                        android:id="@+id/floating_action_button2"
                        android:visibility="gone"
                        layout="@layout/floating_action_button_view"/>
                    <include
                        android:id="@+id/floating_action_button"
                        android:visibility="gone"
                        layout="@layout/floating_action_button_view"/>
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView>
