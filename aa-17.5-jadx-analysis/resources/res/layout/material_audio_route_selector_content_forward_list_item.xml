<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@android:color/transparent">
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="@dimen/list_item_min_height">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="@dimen/list_item_material_focus_ring_horizontal_padding"
                android:paddingRight="@dimen/list_item_material_focus_ring_horizontal_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false">
                <FrameLayout
                    android:id="@+id/primary_action_tap_target"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <FrameLayout
                    android:id="@+id/secondary_tap_target_gap_left_half"
                    android:background="?attr/gearheadCfListItemBackground"
                    android:layout_width="@dimen/list_item_divider_padding"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/foreground_constraint"
                    android:paddingTop="@dimen/padding_p3"
                    android:paddingBottom="@dimen/padding_p3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:layout_width="@dimen/material_audio_selector_icon_container_width"
                        android:layout_height="@dimen/material_audio_selector_icon_container_height"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_gravity="center"
                            android:id="@+id/icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/list_item_icon_size"
                            android:layout_height="@dimen/list_item_icon_size"/>
                        <FrameLayout
                            android:layout_gravity="center"
                            android:id="@+id/large_icon_container"
                            android:visibility="gone"
                            android:layout_width="@dimen/material_audio_selector_icon_container_width"
                            android:layout_height="@dimen/material_audio_selector_icon_container_height">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/large_icon"
                                android:visibility="gone"
                                android:layout_width="@dimen/material_audio_selector_icon_container_width"
                                android:layout_height="@dimen/material_audio_selector_icon_container_height"/>
                            <ImageView
                                android:layout_gravity="end|bottom"
                                android:id="@+id/large_icon_badge"
                                android:background="@drawable/large_icon_badge_background"
                                android:padding="@dimen/list_item_large_icon_badge_padding"
                                android:visibility="gone"
                                android:layout_width="@dimen/list_item_large_icon_badge_size"
                                android:layout_height="@dimen/list_item_large_icon_badge_size"/>
                        </FrameLayout>
                    </FrameLayout>
                    <RelativeLayout
                        android:id="@+id/text_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/padding_p4"
                        android:layout_marginEnd="?attr/gearheadListItemIconTextMargin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/browse_icon_new_container"
                        app:layout_constraintStart_toEndOf="@+id/icon_container"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_goneMarginStart="@dimen/common_keyline_1">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:orientation="horizontal"
                            android:id="@+id/title_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:ellipsize="end"
                                android:id="@+id/title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/browse_icon_new_numbered"
                                app:layout_constraintHorizontal_bias="0"
                                app:layout_constraintHorizontal_chainStyle="packed"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textColor="@color/boardwalk_white"
                                android:gravity="center"
                                android:id="@+id/browse_icon_new_numbered"
                                android:background="@drawable/metadata_icon_new_numbered"
                                android:paddingLeft="@dimen/metadata_new_icon_numbered_padding"
                                android:paddingRight="@dimen/metadata_new_icon_numbered_padding"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tint="@color/gearhead_sdk_tint_light"
                                android:maxLines="1"
                                android:includeFontPadding="false"
                                android:layout_marginStart="@dimen/list_item_text_margin"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/title"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextAppearance.Boardwalk.Body3"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:gravity="center_vertical"
                            android:id="@+id/pre_text_icons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/subtitle"
                            android:layout_alignBottom="@+id/subtitle"
                            android:layout_alignParentStart="true">
                            <ImageView
                                android:id="@+id/color_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/list_item_color_indicator_margin"
                                android:layout_marginBottom="@dimen/list_item_color_indicator_margin"
                                android:src="@drawable/color_indicator"
                                android:layout_marginEnd="@dimen/list_item_color_indicator_margin"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/browse_icon_first"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:id="@+id/browse_icon_first"
                                android:layout_width="@dimen/metadata_icon_size"
                                android:layout_height="@dimen/metadata_icon_size"
                                android:tint="@color/gearhead_sdk_body2_light"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/browse_icon_second"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_goneMarginEnd="@dimen/list_item_remote_views_margin_end"/>
                            <ImageView
                                android:id="@+id/browse_icon_second"
                                android:layout_width="@dimen/metadata_icon_size"
                                android:layout_height="@dimen/metadata_icon_size"
                                android:tint="@color/gearhead_sdk_body2_light"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/browse_icon_third"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_goneMarginEnd="@dimen/list_item_remote_views_margin_end"/>
                            <ImageView
                                android:id="@+id/browse_icon_third"
                                android:layout_width="@dimen/metadata_icon_size"
                                android:layout_height="@dimen/metadata_icon_size"
                                android:tint="@color/gearhead_sdk_body2_light"
                                android:layout_marginEnd="@dimen/list_item_remote_views_margin_end"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <TextView
                            android:ellipsize="end"
                            android:id="@+id/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_below="@+id/title_container"
                            android:layout_toEndOf="@+id/pre_text_icons"
                            style="@style/TextAppearance.Boardwalk.Body3.Subtitle"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/progress_bar_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/pre_text_icons"
                            android:layout_marginEnd="@dimen/list_item_progress_bar_end_padding">
                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/list_item_progress_bar_top_padding_fixed"
                                android:layout_marginBottom="@dimen/list_item_progress_bar_top_padding_adaptive"/>
                            <ProgressBar
                                android:id="@+id/progress_bar"
                                android:background="@drawable/browse_view_progress_background"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/list_item_progress_bar_height"
                                android:progressDrawable="@drawable/browse_view_progress_bar"
                                android:progressTintMode="src_atop"
                                style="?android:attr/progressBarStyleHorizontal"/>
                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/list_item_progress_bar_bottom_padding_fixed"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <FrameLayout
                        android:id="@+id/browse_icon_new_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/text_row_margin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/right_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_goneMarginEnd="@dimen/gearhead_width_keyline_2">
                        <ImageView
                            android:id="@+id/browse_icon_new_tri_state"
                            android:layout_width="@dimen/metadata_new_icon_tri_state_size"
                            android:layout_height="@dimen/metadata_new_icon_tri_state_size"
                            android:src="@drawable/metadata_icon_new_circle"
                            android:scaleType="fitXY"
                            android:tint="@color/gearhead_sdk_tint_light"/>
                    </FrameLayout>
                    <ImageView
                        android:id="@+id/right_icon"
                        android:layout_width="@dimen/material_audio_selector_right_icon_size"
                        android:layout_height="@dimen/material_audio_selector_right_icon_size"
                        android:scaleType="fitXY"
                        android:tint="@color/gearhead_sdk_tint_light"
                        android:layout_marginEnd="@dimen/common_keyline_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/secondary_action_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false">
                <FrameLayout
                    android:id="@+id/secondary_tap_target_gap_right_half"
                    android:background="?attr/gearheadCfListItemBackground"
                    android:layout_width="@dimen/list_item_divider_padding"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/secondary_action_tap_target"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <FrameLayout
                    android:id="@+id/tertiary_tap_target_gap_left_half"
                    android:background="?attr/gearheadCfListItemBackground"
                    android:layout_width="@dimen/list_item_divider_padding"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_vertical_padding_adaptive"
                    android:layout_marginTop="@dimen/list_item_vertical_padding_fixed"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:id="@+id/secondary_action_divider"
                        android:background="@color/boardwalk_white"
                        android:layout_width="@dimen/list_item_divider_thickness"
                        android:layout_height="match_parent"
                        android:alpha="@dimen/list_item_divider_alpha"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/secondary_action_pill"
                        android:background="@drawable/secondary_action_background"
                        android:layout_width="@dimen/list_item_secondary_action_button_width"
                        android:layout_height="@dimen/list_item_secondary_action_button_height"
                        android:paddingStart="@dimen/list_item_secondary_action_button_margin"
                        android:paddingEnd="@dimen/list_item_secondary_action_button_margin"
                        android:layout_marginStart="@dimen/list_item_secondary_action_button_margin"
                        android:layout_marginEnd="?attr/gearheadSecondaryActionPillMarginEnd">
                        <ImageView
                            android:id="@+id/secondary_action_pill_icon"
                            android:layout_width="@dimen/list_item_additional_action_icon_size"
                            android:layout_height="@dimen/list_item_additional_action_icon_size"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/secondary_action_icon_text"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="24sp"
                            android:textColor="@color/boardwalk_white"
                            android:layout_gravity="center"
                            android:id="@+id/secondary_action_icon_text"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_item_margin_medium"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/secondary_action_pill_icon"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/secondary_action_circle"
                        android:background="@drawable/secondary_action_circle_background"
                        android:layout_width="@dimen/list_item_secondary_action_button_height"
                        android:layout_height="@dimen/list_item_secondary_action_button_height"
                        android:layout_marginStart="@dimen/list_item_divider_padding">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/secondary_action_circle_icon"
                            android:layout_width="@dimen/list_item_additional_action_icon_size"
                            android:layout_height="@dimen/list_item_additional_action_icon_size"/>
                    </FrameLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/secondary_action_icon"
                        android:layout_width="@dimen/list_item_additional_action_icon_size"
                        android:layout_height="@dimen/list_item_additional_action_icon_size"
                        android:layout_marginStart="@dimen/common_keyline_1"
                        android:layout_marginEnd="@dimen/common_keyline_1"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_vertical_padding_adaptive"
                    android:layout_marginBottom="@dimen/list_item_vertical_padding_fixed"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/tertiary_action_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false">
                <FrameLayout
                    android:id="@+id/tertiary_tap_target_gap_right_half"
                    android:background="?attr/gearheadCfListItemBackground"
                    android:layout_width="@dimen/list_item_divider_padding"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/tertiary_action_tap_target"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_vertical_padding_adaptive"
                    android:layout_marginTop="@dimen/list_item_vertical_padding_fixed"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:id="@+id/tertiary_action_divider"
                        android:background="@color/boardwalk_white"
                        android:visibility="gone"
                        android:layout_width="@dimen/list_item_divider_thickness"
                        android:layout_height="match_parent"
                        android:alpha="@dimen/list_item_divider_alpha"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/tertiary_action_icon"
                        android:layout_width="@dimen/list_item_additional_action_icon_size"
                        android:layout_height="@dimen/list_item_additional_action_icon_size"
                        android:layout_marginStart="@dimen/common_keyline_1"
                        android:layout_marginEnd="@dimen/common_keyline_1"/>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/tertiary_action_circle"
                        android:background="@drawable/secondary_action_circle_background"
                        android:layout_width="@dimen/list_item_secondary_action_button_height"
                        android:layout_height="@dimen/list_item_secondary_action_button_height"
                        android:layout_marginStart="@dimen/list_item_margin_large"
                        android:layout_marginEnd="@dimen/list_item_divider_padding">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/tertiary_action_circle_icon"
                            android:layout_width="@dimen/list_item_additional_action_icon_size"
                            android:layout_height="@dimen/list_item_additional_action_icon_size"/>
                    </FrameLayout>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_vertical_padding_adaptive"
                    android:layout_marginBottom="@dimen/list_item_vertical_padding_fixed"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/divider"
        android:background="?attr/colorOutlineVariant"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_divider_thickness"/>
    <Space
        android:id="@+id/group_bottom_margin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_group_bottom_margin_fixed"
        android:layout_marginBottom="@dimen/list_item_group_bottom_margin_adaptive"/>
</LinearLayout>
