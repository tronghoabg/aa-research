<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.ui.touch.TouchStealingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/app_bar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/app_bar_container_foreground">
    <FrameLayout
        android:id="@+id/background_app_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/app_bar_inset"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/app_bar_horizontal_margin"
        android:layout_marginEnd="@dimen/app_bar_horizontal_margin">
        <ImageView
            android:id="@+id/transition_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/widget_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_bar_height"
            android:baselineAligned="false">
            <FrameLayout
                android:id="@+id/header_button_frame"
                android:visibility="gone"
                android:layout_width="@dimen/gearhead_edge_column_width"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/header_button_tap_target"
                    android:background="@drawable/gearhead_oval_focus_background"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/app_bar_header_button_size"
                    android:layout_height="@dimen/app_bar_header_button_size">
                    <ImageView
                        android:id="@+id/header_button_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="center"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/header_icon_container"
                android:visibility="gone"
                android:layout_width="@dimen/gearhead_edge_column_width"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/header_icon_image"
                    android:layout_width="@dimen/app_bar_header_icon_size"
                    android:layout_height="@dimen/app_bar_header_icon_size"
                    android:scaleType="fitCenter"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/app_bar_title"
                    android:focusable="false"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/app_bar_title_horizontal_margin"
                    android:layout_marginEnd="@dimen/app_bar_title_horizontal_margin"
                    style="@style/TextAppearance.Boardwalk.Body3"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tab_strip"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/auxiliary_buttons_strip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </FrameLayout>
</com.google.android.apps.auto.components.ui.touch.TouchStealingFrameLayout>
