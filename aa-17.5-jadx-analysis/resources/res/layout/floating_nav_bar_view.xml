<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.navigation.FloatingNavBarView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/template_padding_2">
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/turn_symbol"
        android:layout_width="?attr/templateResponsiveNavCardImageSizeSmall"
        android:layout_height="?attr/templateResponsiveNavCardImageSizeSmall"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/template_padding_2">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/distance_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Template.Text.Body3.Medium"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_0"
            style="@style/Widget.Template.Text.Body3"/>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.navigation.FloatingNavBarView>
