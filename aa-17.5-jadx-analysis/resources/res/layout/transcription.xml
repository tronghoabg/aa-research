<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/transcription_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/transcription_view_margin">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/transcription_bubble"
        android:background="@drawable/assistant_floating_transcription_background"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/transcription_bubble_padding_start_end"
        android:paddingEnd="@dimen/transcription_bubble_padding_start_end">
        <ImageView
            android:id="@+id/greeting_logo"
            android:visibility="gone"
            android:layout_width="@dimen/voiceplate_static_logo_size"
            android:layout_height="@dimen/voiceplate_static_logo_size"
            android:layout_margin="@dimen/greeting_logo_margin_end"
            android:src="0x7f0808f5"
            android:scaleType="centerInside"
            android:tint="@color/google_white"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/status_logo"
            android:visibility="gone"
            android:layout_width="@dimen/voiceplate_static_logo_size"
            android:layout_height="@dimen/voiceplate_static_logo_size"
            android:layout_margin="@dimen/greeting_logo_margin_end"
            android:src="0x7f0808f5"
            android:scaleType="centerInside"
            android:contentDescription="@null"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/status_logo_with_shadow_card_view"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="@dimen/voiceplate_static_logo_size"
            android:layout_height="@dimen/voiceplate_static_logo_size"
            android:layout_margin="@dimen/greeting_logo_margin_end"
            android:alpha="1"
            android:elevation="@dimen/greeting_logo_margin_end"
            app:cardCornerRadius="@dimen/voiceplate_static_logo_size_shadow_radius">
            <ImageView
                android:id="@+id/status_logo_with_shadow"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f0808f5"
                android:scaleType="centerInside"
                android:contentDescription="@null"/>
        </androidx.cardview.widget.CardView>
        <com.google.android.apps.auto.components.system.transcription.TranscriptionTextView
            android:textColor="#ffffff"
            android:ellipsize="none"
            android:gravity="start|center_vertical"
            android:id="@+id/transcription_text_view"
            android:paddingTop="@dimen/gearhead_toast_padding_top_bottom"
            android:paddingBottom="@dimen/gearhead_toast_padding_top_bottom"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/transcription_height"
            android:singleLine="true"
            android:paddingStart="@dimen/transcription_text_padding_start_end"
            android:paddingEnd="@dimen/transcription_text_padding_start_end"
            style="@style/TextAppearance.Gearhead.Coolwalk.TranscriptionBubble"/>
    </LinearLayout>
</LinearLayout>
