<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/frx_gutter_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/preflight_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <android.support.constraint.Guideline
        android:orientation="vertical"
        android:id="@+id/content_left_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.1"/>
    <android.support.constraint.Guideline
        android:orientation="vertical"
        android:id="@+id/content_right_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.9"/>
    <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
        android:label="@string/gearhead_oem_exit"
        android:id="@+id/preflight_exit_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_3x"
        android:layout_marginEnd="@dimen/gearhead_baseline_grid_3x"
        app:carButtonSize="small"
        app:carButtonType="outlined"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
        android:icon="@drawable/ic_arrow_back_white"
        android:id="@+id/preflight_back_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_baseline_grid_2x"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        app:carButtonType="icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/preflight_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/content_right_guideline"
        app:layout_constraintStart_toStartOf="@+id/content_left_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width"/>
    <FrameLayout
        android:id="@+id/preflight_toast_container"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/preflight_toast_bottom_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/content_right_guideline"
        app:layout_constraintStart_toStartOf="@+id/content_left_guideline"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="@dimen/content_max_width"/>
</android.support.constraint.ConstraintLayout>
