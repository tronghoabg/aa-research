<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.contentforward.CfView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_forward_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/transitionable_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.apps.auto.sdk.ui.FocusClusterLayout
            android:layout_gravity="center"
            android:id="@+id/list_view_focus_cluster"
            android:focusable="true"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:forceFieldType="multimoveModal">
            <com.google.android.apps.auto.components.ui.listview.UnListView
                android:id="@+id/list_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.google.android.apps.auto.sdk.ui.FocusClusterLayout>
        <com.google.android.apps.auto.components.nocontentview.NoContentView
            android:id="@+id/no_content_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.google.android.apps.auto.components.drawer.AlphaJumpKeyboard
            android:id="@+id/alpha_jump_keyboard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/app_bar_height"
            app:mode="autodetect"
            app:reset_background_on_configuration_change="false"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/transition_image_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.apps.auto.components.ui.speedbump.SpeedbumpView
        android:id="@+id/speedbump_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.apps.auto.sdk.ui.FloatingActionButton
        android:layout_gravity="bottom|right"
        android:id="@+id/fab"
        android:focusable="true"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_marginRight="@dimen/fab_right_margin"
        android:layout_marginBottom="@dimen/fab_bottom_margin"
        android:foreground="?attr/gearheadPanelFabFocusBackground"
        android:src="@drawable/quantum_ic_equalizer_vd_theme_24"
        android:tint="@color/black"
        style="@style/FabStyle.Large"/>
</com.google.android.apps.auto.components.contentforward.CfView>
