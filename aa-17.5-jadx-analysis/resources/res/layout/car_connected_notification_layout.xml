<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/car_exit_notification"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:baselineAligned="false">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/car_exit_notification_content"
        android:background="@color/car_exit_notification_background"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="@drawable/car_masked_ripple_background"
        android:layout_weight="2">
        <ImageView
            android:id="@+id/car_exit_notification_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="16dp"
            android:src="0x7f080192"
            android:scaleType="fitCenter"
            android:tint="@color/car_exit_notification_text"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/car_exit_notification_text"
            android:id="@+id/car_exit_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_notification_message"/>
    </LinearLayout>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/car_exit_notification_actions_container"
        android:background="@color/car_exit_notification_background_dark"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <Button
            android:textColor="@color/car_exit_notification_text"
            android:ellipsize="end"
            android:id="@+id/car_exit_button"
            android:background="@color/car_exit_notification_background_dark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/car_masked_ripple_background"
            android:text="@string/common_exit"
            android:textAllCaps="true"/>
    </FrameLayout>
</LinearLayout>
