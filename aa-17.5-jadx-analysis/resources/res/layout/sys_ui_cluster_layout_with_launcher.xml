<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/contentInset_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/contentInset_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <View
        android:id="@+id/activity"
        android:background="#ff4444"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/cluster_sliver_insets_spacer"
        android:layout_width="@dimen/cluster_sliver_insets_size"
        android:layout_height="match_parent"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"/>
    <Space
        android:id="@+id/cluster_sliver_mirror_insets_spacer"
        android:layout_width="@dimen/cluster_sliver_insets_size"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"/>
    <View
        android:id="@+id/dashboard"
        android:background="#aa0000ff"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/cluster_sliver_mirror_insets_spacer">
        <tag
            android:value="true"
            android:id="@+id/casts_persistent_insets_not_displacing_decoration"/>
    </View>
    <View
        android:id="@+id/sliver_insets"
        android:background="#aa0000ff"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="@+id/cluster_sliver_insets_spacer"
        app:layout_constraintRight_toRightOf="parent">
        <tag
            android:value="none"
            android:id="@+id/chrome"/>
        <tag
            android:value="true"
            android:id="@+id/casts_persistent_insets_not_displacing_decoration"/>
    </View>
    <View
        android:id="@+id/sliver"
        android:background="#aa666666"
        android:layout_width="@dimen/cluster_sliver_window_size"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="@+id/cluster_sliver_insets_spacer"
        app:layout_constraintRight_toRightOf="@+id/cluster_sliver_insets_spacer"/>
    <View
        android:id="@+id/fullscreen"
        android:background="#aa123456"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
