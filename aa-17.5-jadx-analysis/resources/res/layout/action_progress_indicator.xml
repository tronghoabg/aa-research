<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/indicator"
        android:layout_width="@dimen/demand_space_action_progress_indicator_width_height"
        android:layout_height="@dimen/demand_space_action_progress_indicator_width_height">
        <ProgressBar
            android:id="@+id/indicator_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminateDrawable="@drawable/action_progress_bar_loading"/>
        <View
            android:id="@+id/indicator_circle"
            android:background="@drawable/action_progress_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/indicator_icon"
            android:layout_width="@dimen/demand_space_action_progress_indicator_icon_width_height"
            android:layout_height="@dimen/demand_space_action_progress_indicator_icon_width_height"/>
    </FrameLayout>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/indicator_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/demand_space_action_progress_indicator_text_margin_top"
        android:maxLines="@integer/demand_space_action_progress_indicator_text_max_lines"
        style="@style/CommonCardBody1"/>
</LinearLayout>
