<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textSize="26dp"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/error_title"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navigation_fallback_missing_apps_title"
        android:maxLines="2"
        android:fontFamily="?attr/bodyFontFamily"
        android:paddingHorizontal="16dp"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textSize="16dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/error_subtitle"
        android:paddingTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navigation_fallback_missing_apps_subtitle"
        android:maxLines="4"
        android:fontFamily="?attr/bodyFontFamily"
        android:paddingHorizontal="32dp"/>
    <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
        android:label="@string/navigation_fallback_find_apps_button_text"
        android:layout_gravity="center"
        android:id="@+id/find_apps_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/gearhead_baseline_grid_8x"
        android:layout_marginTop="36dp"
        app:carButtonType="filled"/>
</LinearLayout>
