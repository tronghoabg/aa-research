<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.MaterialComponents.NoActionBar"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <FrameLayout
        android:id="@+id/media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/media_playback_view"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/message_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/progress_container"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="?attr/templateMessageIconSize"
            android:layout_height="?attr/templateMessageIconSize">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/templateLoadingSpinnerStyle"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/error_message_icon"
            android:layout_width="?attr/templateMessageIconSize"
            android:layout_height="?attr/templateMessageIconSize"
            android:layout_marginBottom="@dimen/template_padding_6"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
            android:layout_gravity="center"
            android:id="@+id/playback_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_4"
            android:foreground="@drawable/no_content_view_focus_ring_legacy"
            style="?attr/templateMessageTitleTextStyle"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:paddingStart="@dimen/template_edge_column_margin">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.HeaderView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/back_action_header_view"
            android:focusable="false"
            android:descendantFocusability="afterDescendants"
            android:layout_width="wrap_content"
            android:layout_height="?attr/templateHeaderHeight"
            app:isCard="false"/>
        <include
            android:id="@+id/primary_header_container"
            android:layout_width="0dp"
            android:layout_height="?attr/templateHeaderHeight"
            android:layout_weight="1"
            layout="@layout/full_screen_header_layout"/>
        <include
            android:id="@+id/back_action_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/template_edge_column_margin"
            layout="@layout/action_strip_view_full_template"/>
    </LinearLayout>
</FrameLayout>
