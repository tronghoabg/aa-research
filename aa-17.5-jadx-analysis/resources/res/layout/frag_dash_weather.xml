<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/weather_card"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="180dp">
    <ImageView
        android:id="@+id/weather_icon"
        android:layout_width="@dimen/gearhead_baseline_grid_14x"
        android:layout_height="@dimen/gearhead_baseline_grid_14x"
        app:layout_constraintBottom_toBottomOf="@+id/dashboard_card_bottom"
        app:layout_constraintEnd_toStartOf="@+id/current_temperature"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toTopOf="@+id/dashboard_card_top"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/gearhead_baseline_grid_9x"
        android:gravity="center"
        android:id="@+id/current_temperature"
        android:paddingTop="@dimen/gearhead_padding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="?attr/titleFontFamily"
        android:paddingHorizontal="@dimen/gearhead_padding_3"
        app:layout_constraintBottom_toTopOf="@+id/high_low_temperature_container"
        app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
        app:layout_constraintStart_toEndOf="@+id/weather_icon"
        app:layout_constraintTop_toTopOf="@+id/weather_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/high_low_temperature_container"
        android:paddingBottom="@dimen/gearhead_padding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/weather_icon"
        app:layout_constraintEnd_toEndOf="@+id/current_temperature"
        app:layout_constraintStart_toStartOf="@+id/current_temperature">
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:textSize="@dimen/gearhead_baseline_grid_3x"
            android:gravity="left"
            android:id="@+id/high_temperature"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/gearhead_padding_1"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:textSize="@dimen/gearhead_baseline_grid_3x"
            android:gravity="left"
            android:id="@+id/low_temperature"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="@dimen/low_temperature_opacity"
            android:paddingEnd="@dimen/gearhead_padding_3"/>
    </LinearLayout>
</com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView>
