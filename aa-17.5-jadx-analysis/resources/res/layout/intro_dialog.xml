<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/bottom_sheet_layout_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:paddingTop="@dimen/bottom_sheet_parent_layout_padding"
        android:paddingBottom="@dimen/dialog_paddingBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/car_setup_intro_title"
        android:drawableTop="@drawable/android_auto_gm3_logo"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"
        android:paddingStart="@dimen/bottom_sheet_parent_layout_padding"
        android:paddingEnd="@dimen/bottom_sheet_parent_layout_padding"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_body"
        android:paddingTop="@dimen/dialog_paddingTop"
        android:paddingBottom="@dimen/bottom_sheet_layout_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/car_setup_intro_body_cakewalk"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"
        android:paddingStart="@dimen/bottom_sheet_parent_layout_padding"
        android:paddingEnd="@dimen/bottom_sheet_parent_layout_padding"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_illustration"
        android:paddingBottom="@dimen/bottom_sheet_layout_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/phone_frx_default"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        app:layout_constraintTop_toBottomOf="@+id/dialog_body"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:id="@+id/cancel_button"
        android:paddingLeft="@dimen/button_paddingHorizontal"
        android:paddingRight="@dimen/button_paddingHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/frx_common_exit"
        android:layout_marginStart="@dimen/button_paddingHorizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_illustration"
        style="?attr/materialButtonOutlinedStyle"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:id="@+id/accept_button"
        android:paddingLeft="@dimen/button_paddingHorizontal"
        android:paddingRight="@dimen/button_paddingHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preflight_unlock"
        android:layout_marginEnd="@dimen/button_paddingHorizontal"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_illustration"
        style="?attr/materialIconButtonFilledStyle"/>
</android.support.constraint.ConstraintLayout>
