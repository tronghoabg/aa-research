<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phone_keyboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.search.SearchBar
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/keyboard_activity_search_hint"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/background_android_auto_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/keyboard_activity_android_auto_logo_margin"
            android:layout_marginRight="@dimen/keyboard_activity_android_auto_logo_margin"
            android:src="@drawable/android_auto_logo_gm3"
            android:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/keyboard_activity_aa_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/search_bar"/>
    </android.support.constraint.ConstraintLayout>
    <com.google.android.material.search.SearchView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/keyboard_activity_search_hint"
        app:layout_anchor="@+id/search_bar"
        style="@style/Widget.PhoneKeyboard.SearchView">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/search_view_android_auto_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/keyboard_activity_android_auto_logo_margin"
            android:layout_marginRight="@dimen/keyboard_activity_android_auto_logo_margin"
            android:src="@drawable/android_auto_logo_gm3"
            android:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/keyboard_activity_aa_logo"/>
        <TextView
            android:textSize="@dimen/keyboard_activity_text_size"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/background_text"
            android:layout_width="@dimen/keyboard_activity_background_text_width"
            android:layout_height="wrap_content"
            android:tint="?attr/colorOnSurfaceVariant"
            android:text="@string/keyboard_activity_background_text"
            android:alpha="0"/>
    </com.google.android.material.search.SearchView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
