<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:visibility="gone"
    android:layout_width="?attr/templateCardContentContainerDefaultWidth"
    android:layout_height="0dp"
    android:layout_marginBottom="?attr/templateCardContentContainerBottomMargin"
    android:layout_marginStart="?attr/templateCardContentContainerStartMargin"
    app:cardBorderWidth="0dp"
    app:isCarBorderBlendColor="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintHeight_default="wrap"
    app:layout_constraintHeight_max="?attr/templateCardContentContainerMaxHeight"
    app:layout_constraintHeight_min="?attr/templateCardContentContainerMinHeight"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0"
    style="?attr/templateCardContentContainerStyle">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/header_container"
            layout="@layout/card_header_layout"/>
        <View
            android:background="?attr/templateDividerColor"
            android:layout_width="match_parent"
            android:layout_height="?attr/templateDividerThickness"/>
        <include
            android:id="@+id/content_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            layout="@layout/content_view"/>
        <View
            android:id="@+id/divider_above_sticky_action_button"
            android:background="?attr/templateDividerColor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/templateDividerThickness"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/sticky_action_button_list_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/action_button_list_view"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/sticky_action_button_list_view_stacked"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/template_padding_3"
            layout="@layout/action_button_list_view_stacked"/>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView>
