<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/gearhead_rectangle_round_corner_focus_background"
    android:paddingLeft="@dimen/gearhead_launcher_app_left_right_paddding"
    android:paddingTop="@dimen/gearhead_launcher_app_top_bottom_paddding"
    android:paddingRight="@dimen/gearhead_launcher_app_left_right_paddding"
    android:paddingBottom="@dimen/gearhead_launcher_app_top_bottom_paddding"
    android:focusable="true"
    android:visibility="invisible"
    android:layout_width="0dp"
    android:layout_height="@dimen/gearhead_launcher_app_height"
    android:layout_weight="1">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/icon_circular_crop_container"
        android:layout_width="@dimen/gearhead_launcher_icon_diameter"
        android:layout_height="@dimen/gearhead_launcher_icon_diameter"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/gearhead_launcher_icon_radius"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/notification_badge"
        android:background="@drawable/launcher_notification_badge"
        android:layout_width="@dimen/gearhead_launcher_notification_badge_diameter"
        android:layout_height="@dimen/gearhead_launcher_notification_badge_diameter"
        android:layout_marginTop="@dimen/gearhead_launcher_notification_badge_top_margin"
        android:layout_marginRight="@dimen/gearhead_launcher_notification_badge_right_margin"
        app:layout_constraintRight_toRightOf="@+id/icon_circular_crop_container"
        app:layout_constraintTop_toTopOf="@+id/icon_circular_crop_container"/>
    <ImageView
        android:id="@+id/badge_background"
        android:layout_width="@dimen/gearhead_launcher_badge_background_diameter"
        android:layout_height="@dimen/gearhead_launcher_badge_background_diameter"
        android:layout_marginLeft="@dimen/gearhead_launcher_badge_left_margin"
        android:layout_marginTop="@dimen/gearhead_launcher_badge_left_margin"
        app:layout_constraintLeft_toLeftOf="@+id/icon_circular_crop_container"
        app:layout_constraintTop_toTopOf="@+id/icon_circular_crop_container"/>
    <ImageView
        android:id="@+id/badge"
        android:layout_width="@dimen/gearhead_launcher_badge_diameter"
        android:layout_height="@dimen/gearhead_launcher_badge_diameter"
        app:layout_constraintBottom_toBottomOf="@+id/badge_background"
        app:layout_constraintLeft_toLeftOf="@+id/badge_background"
        app:layout_constraintRight_toRightOf="@+id/badge_background"
        app:layout_constraintTop_toTopOf="@+id/badge_background"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_launcher_label_height"
        android:layout_marginTop="@dimen/gearhead_launcher_label_margin"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_circular_crop_container"
        style="@style/AppLauncherItemText"/>
</android.support.constraint.ConstraintLayout>
