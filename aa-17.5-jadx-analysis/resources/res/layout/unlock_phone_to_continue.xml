<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
        <TextView
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="5dp"
            android:text="@string/unlock_to_start"
            android:drawableTop="@drawable/android_auto_gm3_logo"
            android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_illustration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"/>
    </LinearLayout>
    <android.support.constraint.ConstraintLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
        <com.google.android.material.button.MaterialButton
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:id="@+id/dialog_exit_button"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preflight_exit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/materialButtonOutlinedStyle"/>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:id="@+id/dialog_unlock_button"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preflight_unlock"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/materialIconButtonFilledStyle"/>
    </android.support.constraint.ConstraintLayout>
</LinearLayout>
