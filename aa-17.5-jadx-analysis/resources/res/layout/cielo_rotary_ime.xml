<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keyboard_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_max="@dimen/cielo_ime_max_width">
        <FrameLayout
            android:id="@+id/use_phone_keyboard_label"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/use_phone_keyboard_textbox_width_rotary">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/use_phone_keyboard_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_on_phone"
                style="@style/TextAppearance.Boardwalk.Body2"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/keyboard_parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/use_phone_keyboard_label"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.projection.gearhead.input.RotaryKeyboardLayout
                android:layout_gravity="center"
                android:id="@+id/keyboard"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:fontFamily="?attr/bodyLegacyKeyboardFontFamily"
                app:keyGroupCircleColor="@color/gearhead_sdk_keygroup_circle"
                app:keyGroupCircleRadius="@dimen/keyGroupCircleRadius"
                app:keyGroupSpacing="@dimen/keyGroupSpacing"
                app:ringKeySpacing="@dimen/ringKeySpacing"
                app:ringKeyTextSize="@dimen/ringKeyTextSize"
                app:selectedCircleRadius="@dimen/selectedCircleRadius"
                app:selectedKeyMargin="@dimen/selectedKeyMargin"
                app:selectedKeyTextColor="@color/rotary_ime_foreground_letters"
                app:selectedKeyTextSize="@dimen/selectedKeyTextSize"
                app:selectedKeygroupTextSize="@dimen/selectedKeygroupTextSize">
                <ImageButton
                    android:layout_gravity="center"
                    android:id="@+id/keyboard_btn"
                    android:background="?attr/gearheadRotaryKeyboardSelector"
                    android:layout_width="@dimen/keyboard_fab_size"
                    android:layout_height="@dimen/keyboard_fab_size"/>
            </com.google.android.projection.gearhead.input.RotaryKeyboardLayout>
        </FrameLayout>
        <com.google.android.projection.gearhead.input.HwrView
            android:id="@+id/hwr_ime"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/lockout"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/lockout_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/park_to_use_keyboard"
                style="@style/TextAppearance.Boardwalk.Display3"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/close_keyboard_image"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_rotary_close_ime_area_height"
            android:src="@drawable/ic_keyboard_arrow_down"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
