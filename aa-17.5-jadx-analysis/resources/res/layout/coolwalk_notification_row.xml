<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.focus.NextFocusForwardHandlingLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_content_focus_handler"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notification_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/notification_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/gearhead_padding_3"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/notification_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/gearhead_padding_3"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/notification_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/gearhead_padding_3"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/notification_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/gearhead_padding_3"/>
        <View
            android:id="@+id/card"
            android:background="@drawable/notification_center_row_coolwalk_background"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foreground="@drawable/coolwalk_rectangle_round_corner_focus_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/card_content_selector"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_0.5x"
            android:foreground="@drawable/coolwalk_rectangle_round_corner_focus_background"
            android:nextFocusForward="@+id/cancel_icon"
            app:layout_constraintBottom_toTopOf="@+id/first_action_container"
            app:layout_constraintEnd_toStartOf="@+id/cancel_icon"
            app:layout_constraintStart_toStartOf="@+id/card"
            app:layout_constraintTop_toTopOf="@+id/card"/>
        <ImageView
            android:id="@+id/large_icon"
            android:layout_width="@dimen/gearhead_notification_center_large_icon_diameter"
            android:layout_height="@dimen/gearhead_notification_center_large_icon_diameter"
            android:layout_marginBottom="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toTopOf="@+id/first_action_container"
            app:layout_constraintStart_toStartOf="@+id/notification_start"
            app:layout_constraintTop_toTopOf="@+id/notification_top"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/badge_icon"
            android:layout_width="@dimen/gearhead_notification_center_badge_icon_diameter"
            android:layout_height="@dimen/gearhead_notification_center_badge_icon_diameter"
            android:layout_marginTop="@dimen/gearhead_baseline_grid_2.5x"
            android:layout_marginStart="@dimen/gearhead_baseline_grid_2.5x"
            app:layout_constraintBottom_toBottomOf="@+id/large_icon"
            app:layout_constraintEnd_toEndOf="@+id/large_icon"
            style="@style/Widget.Notification.Badge"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Coolwalk.Body2"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/primary_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="@dimen/gearhead_notification_center_primary_text_opacity"
            android:layout_marginStart="@dimen/gearhead_padding_4"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/item_count"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/badge_icon"
            app:layout_constraintTop_toTopOf="@+id/large_icon"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Coolwalk.Body3"
            android:textColor="@color/gearhead_notification_center_secondary_text_color"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/secondary_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/gearhead_padding_3"
            app:layout_constraintEnd_toStartOf="@+id/item_count"
            app:layout_constraintStart_toStartOf="@+id/primary_message"
            app:layout_constraintTop_toBottomOf="@+id/primary_message"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Coolwalk.Body2"
            android:layout_gravity="start"
            android:id="@+id/time_stamp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toBottomOf="@+id/primary_message"
            app:layout_constraintEnd_toStartOf="@+id/work_profile_badge"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/primary_message"
            app:layout_constraintTop_toTopOf="@+id/primary_message"/>
        <ImageView
            android:id="@+id/work_profile_badge"
            android:layout_width="@dimen/gearhead_notification_center_work_profile_badge_size"
            android:layout_height="@dimen/gearhead_notification_center_work_profile_badge_size"
            android:src="0x7f080990"
            android:tint="@color/gearhead_coolwalk_work_profile_icon_color"
            android:layout_marginStart="@dimen/gearhead_padding_2"
            android:layout_marginEnd="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toBottomOf="@+id/primary_message"
            app:layout_constraintEnd_toStartOf="@+id/item_count"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/time_stamp"
            app:layout_constraintTop_toTopOf="@+id/primary_message"/>
        <com.google.android.apps.auto.components.ui.text.CountIndicatorTextView
            android:textAppearance="@style/TextAppearance.Boardwalk.Body3"
            android:gravity="center"
            android:id="@+id/item_count"
            android:background="@drawable/message_count_background"
            android:visibility="visible"
            android:layout_width="@dimen/count_indicator_view_single_digit_width"
            android:layout_height="@dimen/count_indicator_view_height"
            android:maxLines="1"
            android:layout_marginStart="@dimen/gearhead_padding_3"
            android:layout_marginEnd="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toBottomOf="@+id/large_icon"
            app:layout_constraintEnd_toStartOf="@+id/cancel_icon"
            app:layout_constraintTop_toTopOf="@+id/large_icon"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/prominent_button_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:id="@+id/first_action_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/gearhead_coolwalk_notification_action_button_height"
            app:layout_constraintBottom_toBottomOf="@+id/notification_bottom"
            app:layout_constraintEnd_toStartOf="@+id/prominent_button_guideline"
            app:layout_constraintStart_toStartOf="@+id/notification_start"
            app:layout_constraintTop_toBottomOf="@+id/large_icon"
            app:layout_constraintVertical_bias="1">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/first_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Widget.Notification.Button.Tonal"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:id="@+id/second_action_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/gearhead_coolwalk_notification_action_button_height"
            android:layout_marginStart="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toBottomOf="@+id/notification_bottom"
            app:layout_constraintEnd_toStartOf="@+id/third_action_container"
            app:layout_constraintStart_toEndOf="@+id/first_action_container"
            app:layout_constraintTop_toBottomOf="@+id/large_icon"
            app:layout_constraintVertical_bias="1">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/second_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Widget.Notification.Button.Tonal"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:id="@+id/third_action_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/gearhead_coolwalk_notification_action_button_height"
            android:layout_marginStart="@dimen/gearhead_padding_3"
            app:layout_constraintBottom_toBottomOf="@+id/notification_bottom"
            app:layout_constraintEnd_toEndOf="@+id/notification_end"
            app:layout_constraintStart_toEndOf="@+id/second_action_container"
            app:layout_constraintTop_toBottomOf="@+id/large_icon"
            app:layout_constraintVertical_bias="1">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/third_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Widget.Notification.Button.Tonal"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
        <ImageView
            android:id="@+id/cancel_icon"
            android:padding="@dimen/gearhead_notification_center_cancel_icon_padding"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/gearhead_notification_center_large_icon_diameter"
            android:layout_height="@dimen/gearhead_notification_center_large_icon_diameter"
            android:foreground="@drawable/gearhead_oval_focus_background"
            android:tint="@color/gearhead_notification_center_cancel_icon_color"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="@+id/notification_end"
            app:layout_constraintTop_toTopOf="@+id/large_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.apps.auto.components.system.focus.NextFocusForwardHandlingLayout>
