<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/material3_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/launcher_app_settings_divider_margin">
    <ImageView
        android:id="@+id/icon"
        android:paddingTop="@dimen/launcher_app_settings_list_buttons_padding_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080984"
        android:tint="?android:attr/textColorPrimary"
        android:layout_marginStart="@dimen/launcher_app_settings_row_start_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:paddingTop="@dimen/launcher_app_settings_list_buttons_padding_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_customize_sorting_selection_button_title"
        android:paddingStart="@dimen/launcher_app_settings_ordering_radio_button_text_padding"
        android:paddingEnd="@dimen/launcher_app_settings_row_spacing"
        android:buttonTint="@color/checkbox_blue_grey_theme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/launcher_app_settings_ordering_row_current_ordering_text_size"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/current_ordering"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/launcher_app_settings_ordering_radio_button_text_padding"
        android:paddingEnd="@dimen/launcher_app_settings_row_spacing"
        android:buttonTint="@color/checkbox_blue_grey_theme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/launcher_app_settings_ordering_row_text_to_divider_margin"
        app:layout_constraintStart_toStartOf="@+id/current_ordering"
        app:layout_constraintTop_toBottomOf="@+id/current_ordering"/>
    <View
        android:id="@+id/section_separator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/CompanionAppSeparator"/>
</android.support.constraint.ConstraintLayout>
