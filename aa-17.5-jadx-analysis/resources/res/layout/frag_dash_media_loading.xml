<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dash_media_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:swipeToDismissEnabled="false">
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dashboard_media_text_container_margin_top"
        android:layout_marginBottom="@dimen/dashboard_media_text_container_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/progress"
        app:layout_constraintEnd_toStartOf="@+id/dashboard_media_text_end"
        app:layout_constraintStart_toEndOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/dashboard_media_text_container_bias">
        <ImageView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dashboard_media_text_view_size"
            android:layout_marginTop="@dimen/dashboard_media_text_padding"
            android:src="@drawable/dashboard_media_loading_title_background"
            style="@style/Widget.Gearhead.Coolwalk.TextView.Title"/>
        <ImageView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dashboard_media_text_view_size"
            android:layout_marginBottom="@dimen/dashboard_media_text_padding"
            android:src="@drawable/dashboard_media_loading_subtitle_background"
            style="@style/Widget.Dashboard.TextView.Subtitle"/>
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="@dimen/dashboard_media_progress_height"
        app:indicatorColor="?attr/dashProgressColor"
        app:layout_constraintBottom_toTopOf="@+id/media_button_row"
        app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:trackColor="?attr/dashProgressSurface"
        app:trackCornerRadius="@fraction/dashboard_media_progress_radius_fraction"
        app:trackThickness="@dimen/dashboard_media_progress_height"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/source_badge"
        android:layout_width="@dimen/dashboard_media_badge_size"
        android:layout_height="@dimen/dashboard_media_badge_size"
        app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
        app:layout_constraintHorizontal_bias="@fraction/dashboard_media_sourceBadge_bias"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toTopOf="@+id/dashboard_card_top"
        style="@style/Widget.Dashboard.Badge"/>
    <include
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dashboard_media_button_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        layout="@layout/frag_dash_media_button_row"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.apps.auto.components.coolwalk.focusring.TappableRegion
            android:id="@+id/primary_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:focusRingInset="@dimen/gearhead_padding_0"
            app:shapeAppearanceOverlay="@style/DashPrimaryTappableRegionAlbumArtMatchingShapeAppearance"
            style="@style/Widget.Dashboard.PrimaryTarget"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
</com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView>
