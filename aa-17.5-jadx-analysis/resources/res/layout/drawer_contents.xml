<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/drawer_shadow"
        android:background="@color/gearhead_sdk_card_background"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/unlimited_browsing_exit_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_browse_notification_margin"
        android:layout_marginStart="@dimen/content_browse_notification_margin"
        android:layout_marginEnd="@dimen/content_browse_notification_margin_end"
        app:cardBackgroundColor="@color/gearhead_sdk_blue_grey_800"
        app:cardCornerRadius="@dimen/gearhead_sdk_card_view_corner_radius"
        app:cardElevation="@dimen/gearhead_sdk_card_view_elevation">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/content_browse_notification_height">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/unlimited_browsing_exit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/content_browse_park_to_continue"
                android:layout_weight="1"
                android:paddingStart="@dimen/content_browse_notification_text_padding"
                style="@style/GearheadSdkContentBrowseNotification"/>
            <TextView
                android:textColor="@color/unlimited_browsing_exit_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/unlimited_browsing_exit_button"
                android:background="?attr/gearheadLockoutExitButtonBackground"
                android:paddingTop="@dimen/unlimited_browsing_exit_vertical_padding"
                android:paddingBottom="@dimen/unlimited_browsing_exit_vertical_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/content_browse_unlimited_browsing_exit"
                android:textAllCaps="true"
                android:paddingStart="@dimen/unlimited_browsing_exit_horizontal_padding"
                android:paddingEnd="@dimen/unlimited_browsing_exit_horizontal_padding"
                android:layout_marginStart="@dimen/unlimited_browsing_exit_margin_start"
                android:layout_marginEnd="@dimen/unlimited_browsing_exit_margin_end"
                style="@style/GearheadSdkContentBrowseNotification"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/gearhead_sdk_drawer_header_height">
        <com.google.android.apps.auto.components.support.UnlimitedBrowsePagedListView
            android:id="@+id/drawer_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="32dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom"
        android:id="@+id/truncated_list_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_browse_notification_height"
        android:layout_marginLeft="@dimen/content_browse_notification_margin"
        android:layout_marginRight="@dimen/content_browse_notification_margin"
        android:layout_marginBottom="@dimen/content_browse_notification_margin"
        app:cardBackgroundColor="@color/gearhead_sdk_blue_grey_800"
        app:cardCornerRadius="@dimen/gearhead_sdk_card_view_corner_radius"
        app:cardElevation="@dimen/gearhead_sdk_card_view_elevation">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/truncated_list_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/content_browse_notification_text_padding"
            android:paddingEnd="@dimen/content_browse_notification_text_padding"
            style="@style/GearheadSdkContentBrowseNotification"/>
    </androidx.cardview.widget.CardView>
</FrameLayout>
