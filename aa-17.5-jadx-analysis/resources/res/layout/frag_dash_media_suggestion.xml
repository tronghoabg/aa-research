<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dash_media_suggestion_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:swipeToDismissEnabled="false">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/media_suggestions_section"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/gearhead_padding_2">
        <include layout="@layout/media_suggestion_header"/>
        <ViewAnimator
            android:id="@+id/media_suggestion_rows_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateFirstView="false">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/media_suggestion_loading_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/media_suggestion_loading_1"
                    layout="@layout/media_suggestion_loading_row"/>
                <include
                    android:id="@+id/media_suggestion_loading_2"
                    layout="@layout/media_suggestion_loading_row"/>
                <include
                    android:id="@+id/media_suggestion_loading_3"
                    layout="@layout/media_suggestion_loading_row"/>
                <include
                    android:id="@+id/media_suggestion_loading_4"
                    layout="@layout/media_suggestion_loading_row"/>
                <include
                    android:id="@+id/media_suggestion_loading_5"
                    layout="@layout/media_suggestion_loading_row"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/media_suggestion_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/media_suggestion_1"
                    layout="@layout/media_suggestion_row"/>
                <include
                    android:id="@+id/media_suggestion_2"
                    layout="@layout/media_suggestion_row"/>
                <include
                    android:id="@+id/media_suggestion_3"
                    layout="@layout/media_suggestion_row"/>
                <include
                    android:id="@+id/media_suggestion_4"
                    layout="@layout/media_suggestion_row"/>
                <include
                    android:id="@+id/media_suggestion_5"
                    layout="@layout/media_suggestion_row"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/no_additional_media_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="0px"
                    android:text="@string/no_additional_media_suggestions_text"
                    android:maxLines="2"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    style="@style/Widget.Gearhead.Coolwalk.TextView.Subtitle"/>
            </LinearLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/media_suggestions_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/media_suggestions_empty"
                style="@style/Widget.Gearhead.Coolwalk.TextView.Subtitle"/>
        </ViewAnimator>
    </LinearLayout>
</com.google.android.apps.auto.components.system.dashboard.design.DashboardCardView>
