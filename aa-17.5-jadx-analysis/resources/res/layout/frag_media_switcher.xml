<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.focus.NextFocusForwardHandlingLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_switcher_container_focus_handler"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:layout_gravity="end|top"
        android:id="@+id/page_indicator_interceptor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gearhead_padding_1"
        android:elevation="2dp">
        <com.google.android.apps.auto.components.coolwalk.card.CoolwalkCardView
            android:id="@+id/page_indicator_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            style="@style/Widget.Coolwalk.Card">
            <com.google.android.apps.auto.components.system.dashboard.media.switcher.PageIndicator
                android:layout_gravity="center"
                android:id="@+id/page_indicator"
                android:layout_width="@dimen/dashboard_pager_indicator_width"
                android:layout_height="@dimen/dashboard_pager_indicator_height"
                android:layout_margin="@dimen/gearhead_padding_2"
                android:tint="?attr/colorOnSurface"/>
        </com.google.android.apps.auto.components.coolwalk.card.CoolwalkCardView>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <com.google.android.apps.auto.components.system.dashboard.media.switcher.SlidingViewSwitcher
        android:id="@+id/media_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v4.app.FragmentContainerView
            android:name="com.google.android.apps.auto.components.system.dashboard.media.MediaPlayerFragment"
            android:id="@+id/media_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <android.support.v4.app.FragmentContainerView
            android:name="com.google.android.apps.auto.components.system.dashboard.media.MediaSuggestionFragment"
            android:id="@+id/media_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.apps.auto.components.system.dashboard.media.switcher.SlidingViewSwitcher>
</com.google.android.apps.auto.components.system.focus.NextFocusForwardHandlingLayout>
