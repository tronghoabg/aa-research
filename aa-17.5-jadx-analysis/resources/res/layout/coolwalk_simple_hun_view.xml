<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/hun_view"
    android:background="@drawable/coolwalk_hun_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/coolwalk_gearhead_hun_simple_height"
    android:layout_marginTop="@dimen/coolwalk_gearhead_hun_margin_top"
    android:baselineAligned="false"
    android:paddingEnd="@dimen/hun_content_padding"
    android:layout_marginStart="@dimen/coolwalk_gearhead_hun_margin"
    android:layout_marginEnd="@dimen/coolwalk_gearhead_hun_margin">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/notification_info"
        android:background="@drawable/coolwalk_hun_rounded_left_ripple"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="@dimen/hun_content_padding">
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/coolwalk_gearhead_hun_badged_icon_size"
                android:layout_height="@dimen/coolwalk_gearhead_hun_badged_icon_size"
                layout="@layout/hun_badged_icon"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/medium_icon"
                android:layout_width="@dimen/gearhead_hun_medium_icon_size"
                android:layout_height="@dimen/gearhead_hun_medium_icon_size"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gearhead_baseline_grid_0.5x"
            android:drawablePadding="@dimen/gearhead_padding_2"
            android:layout_marginStart="@dimen/gearhead_baseline_grid_3x"
            android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
            app:layout_constraintBottom_toTopOf="@+id/text"
            app:layout_constraintEnd_toStartOf="@+id/item_count"
            app:layout_constraintStart_toEndOf="@+id/icon_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <TextView
                android:textAppearance="@style/TextAppearance.Coolwalk.Body1.Hun.Deprecated"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/work_profile_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/gearhead_baseline_grid_1x"
                android:src="0x7f080990"
                android:tint="@color/gearhead_coolwalk_work_profile_icon_color"
                android:layout_marginStart="@dimen/gearhead_padding_2"
                android:layout_marginEnd="@dimen/gearhead_padding_3"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/TextAppearance.Coolwalk.Body3.Notification"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_1.5x"
            android:maxLines="1"
            android:drawablePadding="@dimen/gearhead_padding_2"
            android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_count"
            app:layout_constraintStart_toStartOf="@+id/title_container"
            app:layout_constraintTop_toBottomOf="@+id/title_container"/>
        <com.google.android.apps.auto.components.ui.text.CountIndicatorTextView
            android:textAppearance="@style/TextAppearance.Boardwalk.Body3"
            android:gravity="center"
            android:id="@+id/item_count"
            android:background="@drawable/message_count_background"
            android:layout_width="@dimen/count_indicator_view_single_digit_width"
            android:layout_height="@dimen/count_indicator_view_height"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </android.support.constraint.ConstraintLayout>
    <View
        android:id="@+id/action_area_divider"
        android:background="#3effffff"
        android:layout_width="@dimen/gearhead_hun_action_area_divider_width"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"/>
    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
        android:layout_gravity="end|center_vertical"
        android:id="@+id/secondary_action_button"
        android:visibility="gone"
        android:layout_width="@dimen/gearhead_coolwalk_hun_button_width"
        android:layout_height="@dimen/gearhead_coolwalk_hun_button_height"
        android:layout_marginEnd="@dimen/gearhead_hun_button_container_start_end_margin"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@android:color/white"/>
    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/close_button"
        android:layout_width="@dimen/gearhead_hun_button_size"
        android:layout_height="@dimen/gearhead_hun_button_size"
        app:icon="@drawable/gs_close_fill1_vd_theme_40"
        app:iconTint="@android:color/white"
        style="@style/Widget.Gearhead.Coolwalk.Button.IconButton.NoInset"/>
</LinearLayout>
