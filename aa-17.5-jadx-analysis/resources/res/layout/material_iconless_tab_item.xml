<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stateListAnimator="@animator/tab_animator">
    <FrameLayout
        android:gravity="center"
        android:background="@drawable/iconless_tab_indicator_background"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateTabIconlessIndicatorHeight"
        android:paddingStart="@dimen/padding_p1"
        android:paddingEnd="@dimen/padding_p1">
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/tab_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="?attr/textAppearanceBodySmall"/>
    </FrameLayout>
</LinearLayout>
