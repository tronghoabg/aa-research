<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/gearheadCfAppBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/app_bar_space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"/>
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <android.support.constraint.Guideline
            android:orientation="vertical"
            android:id="@+id/message_left_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="@dimen/message_left_position_fraction"/>
        <android.support.constraint.Guideline
            android:orientation="vertical"
            android:id="@+id/message_right_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="@dimen/message_right_position_fraction"/>
        <ProgressBar
            android:id="@+id/loading_spinner"
            android:visibility="gone"
            android:layout_width="@dimen/loading_spinner_size"
            android:layout_height="@dimen/loading_spinner_size"
            android:indeterminateDrawable="@drawable/music_buffering"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/message_left_guideline"
            app:layout_constraintRight_toRightOf="@+id/message_right_guideline"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/message_icon"
            android:visibility="gone"
            android:layout_width="@dimen/no_content_icon_size"
            android:layout_height="@dimen/no_content_icon_size"
            android:layout_marginBottom="@dimen/no_content_icon_margin_bottom"
            android:src="@drawable/quantum_gm_ic_warning_amber_vd_theme_24"
            android:alpha="@dimen/message_text_alpha"
            app:layout_constraintBottom_toTopOf="@+id/message_text_container"
            app:layout_constraintLeft_toLeftOf="@+id/message_left_guideline"
            app:layout_constraintRight_toRightOf="@+id/message_right_guideline"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <FrameLayout
            android:id="@+id/message_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/message_left_guideline"
            app:layout_constraintRight_toRightOf="@+id/message_right_guideline"
            app:layout_constraintTop_toBottomOf="@+id/message_icon">
            <TextView
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/message_text"
                android:background="@drawable/gearhead_no_content_text_container_focus_background"
                android:paddingLeft="@dimen/message_text_padding_horizontal"
                android:paddingTop="@dimen/message_text_padding_vertical"
                android:paddingRight="@dimen/message_text_padding_horizontal"
                android:paddingBottom="@dimen/message_text_padding_vertical"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="@dimen/message_text_alpha"
                style="@style/TextAppearance.Boardwalk.Body3"/>
        </FrameLayout>
    </android.support.constraint.ConstraintLayout>
</LinearLayout>
