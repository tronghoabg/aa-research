<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:layout_width="?attr/templateCardContentContainerDefaultWidth"
    android:layout_height="0dp"
    android:layout_marginStart="?attr/templateCardContentContainerStartMargin"
    app:layout_constraintHeight_default="wrap"
    app:layout_constraintHeight_min="?attr/templateCardContentContainerMinHeight"
    app:layout_constraintVertical_bias="0"
    style="?attr/templateCardContentContainerStyle">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/header_container"
            layout="@layout/card_header_layout"/>
        <View
            android:background="?attr/templateDividerColor"
            android:layout_width="match_parent"
            android:layout_height="?attr/templateDividerThickness"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/debug_toggle_container"
            android:padding="@dimen/template_padding_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0809de"
                android:tint="?attr/templateMessageDefaultIconTint"
                android:layout_marginEnd="@dimen/template_padding_1"/>
            <Switch
                android:id="@+id/debug_toggle"
                android:focusable="true"
                android:layout_width="?attr/templateToggleWidth"
                android:layout_height="?attr/templateToggleHeight"/>
        </LinearLayout>
        <include
            android:id="@+id/action_strip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/template_edge_column_margin"
            layout="@layout/action_strip_view_full_template"/>
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout
                android:id="@+id/park_only_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/message_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/progress_container"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_width="?attr/templateMessageIconSize"
                        android:layout_height="?attr/templateMessageIconSize"
                        android:layout_marginHorizontal="@dimen/template_padding_3">
                        <ProgressBar
                            android:layout_gravity="center"
                            android:id="@+id/progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="?attr/templateLoadingSpinnerStyle"/>
                    </FrameLayout>
                    <ImageView
                        android:id="@+id/message_icon"
                        android:visibility="gone"
                        android:layout_width="?attr/templateMessageIconSizeForMapContentTemplate"
                        android:layout_height="?attr/templateMessageIconSizeForMapContentTemplate"
                        android:layout_marginTop="@dimen/template_padding_3"
                        android:layout_marginHorizontal="@dimen/template_padding_3"/>
                    <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
                        android:layout_gravity="center"
                        android:id="@+id/message_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="@drawable/no_content_view_focus_ring_legacy"
                        android:layout_marginHorizontal="@dimen/template_padding_3"
                        android:layout_marginVertical="@dimen/template_padding_1"
                        style="?attr/templateMessageTitleTextStyle"/>
                    <View
                        android:id="@+id/row_action_list_divider"
                        android:background="?attr/templateDividerColor"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/templateDividerThickness"/>
                    <com.google.android.apps.auto.components.apphost.view.widgets.common.ActionButtonListView
                        android:id="@+id/action_button_list_view"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/template_padding_1"
                        app:equalWidthButtons="true"
                        layout="@layout/action_button_list_view"/>
                    <include
                        android:id="@+id/action_button_list_view_stacked"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/template_padding_3"
                        layout="@layout/action_button_list_view_stacked"/>
                </LinearLayout>
            </com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout>
        </FrameLayout>
        <ScrollView
            android:layout_gravity="top"
            android:id="@+id/stack_trace_container"
            android:background="?attr/templateDebugMessageBackgroundColor"
            android:padding="@dimen/template_padding_1"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_4"
            android:layout_marginBottom="@dimen/template_padding_1"
            android:layout_marginStart="@dimen/template_width_keyline_2"
            android:layout_marginEnd="@dimen/template_width_keyline_2">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/stack_trace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?attr/templateMessageDebugTextStyle"/>
            </HorizontalScrollView>
        </ScrollView>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.BleedingCardView>
