<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/car_header"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/car_mic_underlay"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:animateLayoutChanges="true"
        android:paddingStart="@dimen/gearhead_sdk_drawer_header_menu_button_size">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/car_drawer_title_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/car_drawer_title"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                style="@style/GearheadSdkTitle.Light"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:gravity="center_vertical"
            android:id="@+id/car_search_box"
            android:background="@color/search_box_card"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/transparent">
            <FrameLayout
                android:id="@+id/car_search_box_contents"
                android:background="@color/search_box_card"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="false">
                <FrameLayout
                    android:id="@+id/car_search_box_google_logo_container"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp">
                    <ImageView
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/car_search_box_google_logo"
                        android:paddingTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tint="@color/search_box_text_secondary"
                        android:tintMode="src_in"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/car_search_box_superg_logo"
                        android:layout_width="@dimen/gearhead_sdk_list_item_icon_size"
                        android:layout_height="@dimen/gearhead_sdk_list_item_icon_size"
                        android:scaleType="center"/>
                    <com.google.android.apps.auto.components.support.CarRestrictedEditText
                        android:textColor="@color/search_box_text_primary"
                        android:textColorHint="@color/search_box_text_secondary"
                        android:gravity="center_vertical"
                        android:id="@+id/car_search_box_edit_text"
                        android:background="@null"
                        android:focusableInTouchMode="false"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:imeOptions="actionSearch"
                        android:textSelectHandle="@drawable/gearhead_sdk_empty"
                        android:textCursorDrawable="@null"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/GearheadSdkTitle.Light"/>
                    <FrameLayout
                        android:id="@+id/car_search_box_end_view"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <ImageView
        android:id="@+id/car_drawer_button"
        android:background="@drawable/gearhead_sdk_header_button_background"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:scaleType="center"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/car_mic_button"
        android:background="@drawable/gearhead_sdk_header_button_background"
        android:focusable="false"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:scaleType="center"/>
</FrameLayout>
