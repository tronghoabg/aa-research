<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/search_bar"
    android:background="@drawable/search_bar_background"
    android:focusable="false"
    android:layout_width="0dp"
    android:layout_height="?attr/templateEditTextHeight"
    android:foreground="@drawable/search_bar_focus_ring"
    android:baselineAligned="false"
    android:layout_weight="1">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/edit_text"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="@drawable/search_bar_focus_ring"
        android:baselineAligned="false"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/padding_p3">
        <ImageView
            android:id="@+id/leading_icon"
            android:focusable="false"
            android:layout_width="?attr/templateEditTextMicrophoneWidth"
            android:layout_height="?attr/templateEditTextMicrophoneWidth"
            android:src="@drawable/gs_search_vd_theme_24"
            android:tint="?attr/colorOnSurfaceVariant"/>
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/ThemeOverlay.Template.Search.Material"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/padding_p3"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxBackgroundMode="none"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="?attr/templateFocusStrokeWidthFocused"
            app:hintEnabled="false">
            <com.google.android.apps.auto.components.apphost.signin.MaterialCarRestrictedEditText
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColorHint="?attr/colorOnSurface"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/car_restricted_edit_text"
                android:padding="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/search_hint"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:paddingStart="0dp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/microphone"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:foreground="@drawable/search_bar_focus_ring"
        android:baselineAligned="false"
        android:paddingHorizontal="@dimen/padding_p3">
        <ImageView
            android:focusable="false"
            android:layout_width="?attr/templateEditTextMicrophoneWidth"
            android:layout_height="?attr/templateEditTextMicrophoneWidth"
            android:src="@drawable/gs_mic_vd_theme_24"
            android:tint="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>
</LinearLayout>
