<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/hats_survey_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hats_survey_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24sp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/hats_survey_logo"
            android:layout_width="18sp"
            android:layout_height="18sp"
            android:src="@drawable/ic_android_auto_flat_logo"/>
        <TextView
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/car_hats_app_name"
            android:layout_centerVertical="true"
            android:textAlignment="center"
            android:layout_marginStart="8sp"
            android:layout_toEndOf="@+id/hats_survey_logo"
            android:lineHeight="20sp"/>
    </RelativeLayout>
    <TextView
        android:textSize="22sp"
        android:id="@+id/hats_survey_thank_you"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16sp"
        android:layout_marginBottom="32sp"
        android:text="@string/car_hats_survey_thank_you"
        android:layout_below="@+id/hats_survey_header"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:lineHeight="24sp"/>
    <ImageView
        android:id="@+id/hats_survey_illustration"
        android:background="@android:color/transparent"
        android:layout_width="260sp"
        android:layout_height="190sp"
        android:src="@drawable/ic_hats_survey_background"
        android:layout_below="@+id/hats_survey_thank_you"
        android:layout_centerHorizontal="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:id="@+id/hats_survey_parent"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
