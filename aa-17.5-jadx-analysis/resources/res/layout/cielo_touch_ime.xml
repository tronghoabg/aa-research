<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.apps.auto.sdk.ui.FocusClusterLayout
        android:gravity="bottom|center_horizontal"
        android:id="@+id/keyboard_layout"
        android:paddingTop="@dimen/gm3_keyboard_shadow_size"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gm3_keyboard_shadow_size"
        app:forceFieldType="multimoveModal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/cielo_ime_max_width">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/keyboard_parent"
            android:background="@drawable/coolwalk_projection_keyboard_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.projection.gearhead.input.ProjectionKeyboardLayout
                android:layout_gravity="center"
                android:id="@+id/keyboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Keyboard"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Gearhead.KeyboardOverlay"
                android:layout_gravity="center"
                android:id="@+id/lockout_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/park_to_use_keyboard"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/use_phone_keyboard_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="@style/TextAppearance.Gearhead.KeyboardOverlay"
                android:layout_gravity="center"
                android:id="@+id/use_phone_keyboard_overlay_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_on_phone"/>
        </FrameLayout>
    </com.google.android.apps.auto.sdk.ui.FocusClusterLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
