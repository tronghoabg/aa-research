<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <FrameLayout
        android:id="@+id/web_view_container"
        android:focusable="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <WebView
            android:layout_gravity="top"
            android:id="@+id/web_view_layout"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateHeaderHeight"
        android:baselineAligned="false">
        <com.google.android.apps.auto.components.apphost.basewidgets.action.ui.MaterialActionButtonView
            android:id="@+id/back_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_p3"/>
        <include
            android:id="@+id/back_action_strip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/template_edge_column_margin"
            layout="@layout/action_strip_view_full_template"/>
    </LinearLayout>
</FrameLayout>
