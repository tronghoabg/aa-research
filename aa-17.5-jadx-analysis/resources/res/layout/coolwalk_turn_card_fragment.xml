<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/click_target"
        android:background="?android:attr/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/gearhead_coolwalk_rectangle_with_rounded_corners_focus_background"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/progress_indicator"
            android:background="@drawable/turn_card_widget_background"
            android:padding="@dimen/progress_bar_padding"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:layout_width="@dimen/turn_card_progress_bar_icon_size"
                android:layout_height="@dimen/turn_card_progress_bar_icon_size"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/gearhead_progress_spinner"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/turn_card_app_icon_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/turn_card_app_icon"
                android:background="@drawable/android_auto_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <android.support.constraint.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/turn_card_content_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/step_view_container"
                android:background="@drawable/turn_card_widget_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/travel_estimate_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <include
                    android:id="@+id/detailed_navigation_step_view"
                    layout="@layout/detailed_navigation_step_view"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/travel_estimate_container"
                android:background="?android:attr/colorBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_view_container">
                <include
                    android:id="@+id/navigation_travel_estimate_view"
                    layout="@layout/navigation_travel_estimate_view"/>
            </LinearLayout>
        </android.support.constraint.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
