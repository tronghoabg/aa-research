<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <include
            android:layout_width="0dp"
            android:layout_height="?attr/templateHeaderHeight"
            android:layout_weight="1"
            layout="@layout/full_screen_header_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/debug_toggle_container"
            android:padding="@dimen/template_padding_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0809de"
                android:tint="?attr/templateMessageDefaultIconTint"
                android:layout_marginEnd="@dimen/template_padding_1"/>
            <Switch
                android:id="@+id/debug_toggle"
                android:focusable="true"
                android:layout_width="?attr/templateToggleWidth"
                android:layout_height="?attr/templateToggleHeight"/>
        </LinearLayout>
        <include
            android:id="@+id/action_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/template_edge_column_margin"
            layout="@layout/action_strip_view_full_template"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout
            android:id="@+id/park_only_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/message_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/progress_container"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="?attr/templateMessageIconSize"
                    android:layout_height="?attr/templateMessageIconSize">
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="?attr/templateLoadingSpinnerStyle"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/message_icon"
                    android:visibility="gone"
                    android:layout_width="?attr/templateMessageIconSize"
                    android:layout_height="?attr/templateMessageIconSize"/>
                <com.google.android.apps.auto.components.apphost.view.widgets.common.CarTextView
                    android:layout_gravity="center"
                    android:id="@+id/message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/template_padding_4"
                    android:foreground="@drawable/no_content_view_focus_ring_legacy"
                    style="?attr/templateMessageTitleTextStyle"/>
                <View
                    android:id="@+id/row_action_list_divider"
                    android:background="?attr/templateDividerColor"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/templateDividerThickness"/>
                <include
                    android:id="@+id/action_button_list_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/template_padding_5"
                    layout="@layout/action_button_list_view"/>
            </LinearLayout>
        </com.google.android.apps.auto.components.apphost.view.widgets.common.ContentModerationWrapperLayout>
    </FrameLayout>
    <ScrollView
        android:layout_gravity="top"
        android:id="@+id/stack_trace_container"
        android:background="?attr/templateDebugMessageBackgroundColor"
        android:padding="@dimen/template_padding_1"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_padding_4"
        android:layout_marginBottom="@dimen/template_padding_1"
        android:layout_marginStart="@dimen/template_width_keyline_2"
        android:layout_marginEnd="@dimen/template_width_keyline_2">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/stack_trace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/templateMessageDebugTextStyle"/>
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
