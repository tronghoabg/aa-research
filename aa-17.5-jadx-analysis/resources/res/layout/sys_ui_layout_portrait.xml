<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/contentInset_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/contentInset_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/contentInset_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/contentInset_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/rail"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/contentInset_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="0dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/contentInset_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="0dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/contentInset_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="0dp"/>
        <View
            android:id="@+id/map"
            android:background="#00ffff"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
            app:layout_constraintRight_toRightOf="@+id/contentInset_right"
            app:layout_constraintTop_toTopOf="@+id/contentInset_top">
            <tag
                android:value="true"
                android:id="@+id/accepts_casted_window_insets"/>
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="@integer/widescreen_maps_maps_compat_group"
                android:id="@+id/grouped_primary"/>
        </View>
        <View
            android:id="@+id/map_compat"
            android:background="#00274b"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/dashboard_spacer"
            app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
            app:layout_constraintRight_toRightOf="@+id/contentInset_right"
            app:layout_constraintTop_toTopOf="@+id/contentInset_top">
            <tag
                android:value="true"
                android:id="@+id/accepts_casted_window_insets"/>
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="@integer/widescreen_maps_maps_compat_group"
                android:id="@+id/grouped"/>
        </View>
        <View
            android:id="@+id/map_ime"
            android:background="#ffe0b0ff"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="@dimen/car_ime_height"
            app:layout_constraintBottom_toBottomOf="@+id/map"
            app:layout_constraintLeft_toLeftOf="@+id/map"
            app:layout_constraintRight_toRightOf="@+id/map">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
        <Space
            android:id="@+id/dashboard_spacer"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
            app:layout_constraintRight_toRightOf="@+id/contentInset_right"/>
        <View
            android:id="@+id/dashboard"
            android:background="#202930"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/dashboard_spacer"
            app:layout_constraintLeft_toLeftOf="@+id/dashboard_spacer"
            app:layout_constraintRight_toRightOf="@+id/dashboard_spacer"
            app:layout_constraintTop_toTopOf="@+id/dashboard_spacer">
            <tag
                android:value="true"
                android:id="@+id/casts_window_insets_displacing_decoration"/>
            <tag
                android:value="horizontal"
                android:id="@+id/arguments"/>
        </View>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/activity_space_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <View
            android:id="@+id/activity"
            android:background="#ff4444"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
            app:layout_constraintRight_toRightOf="@+id/contentInset_right"
            app:layout_constraintTop_toBottomOf="@+id/activity_space_divider">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="true"
                android:id="@+id/casts_window_insets_displacing_decoration"/>
            <tag
                android:value="@integer/activity_group_maps_main"
                android:id="@+id/grouped_primary"/>
        </View>
        <View
            android:id="@+id/notification_center"
            android:background="#ffff9900"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toRightOf="@+id/activity"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="true"
                android:id="@+id/casts_window_insets_displacing_decoration"/>
        </View>
        <View
            android:id="@+id/demand"
            android:background="#ff44ff44"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/map"
            app:layout_constraintRight_toRightOf="@+id/map"
            app:layout_constraintTop_toTopOf="@+id/map"/>
        <View
            android:id="@+id/assistant_immersive_fullscreen"
            android:background="#ffffb7d4"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toRightOf="@+id/activity"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
            <tag
                android:value="true"
                android:id="@+id/casts_window_insets_displacing_decoration"/>
        </View>
        <View
            android:id="@+id/notification"
            android:background="#99ff44ff"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="1dp"
            android:layout_weight="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/map"
            app:layout_constraintRight_toRightOf="@+id/map"
            app:layout_constraintTop_toTopOf="@+id/map"/>
        <View
            android:id="@+id/integrated_overlay"
            android:background="#ff4444"
            android:paddingLeft="@dimen/coolwalk_gutter_padding"
            android:paddingTop="@dimen/coolwalk_gutter_padding"
            android:paddingRight="@dimen/coolwalk_gutter_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/activity"
            app:layout_constraintLeft_toLeftOf="@+id/activity"
            app:layout_constraintRight_toRightOf="@+id/activity"
            app:layout_constraintTop_toTopOf="@+id/activity">
            <tag
                android:value="true"
                android:id="@+id/rounded_corners"/>
        </View>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/immersive"
        android:background="#ffa500"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"
        app:layout_constraintTop_toTopOf="@+id/contentInset_top">
        <tag
            android:value="true"
            android:id="@+id/rounded_corners"/>
        <tag
            android:value="true"
            android:id="@+id/casts_window_insets_displacing_decoration"/>
        <tag
            android:value="true"
            android:id="@+id/accepts_casted_window_insets"/>
        <tag
            android:value="@integer/activity_group_maps_main"
            android:id="@+id/grouped"/>
    </View>
    <View
        android:id="@+id/immersive_toolbar"
        android:background="#613baf"
        android:layout_width="0dp"
        android:layout_height="@dimen/immersive_toolbar_height"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"
        app:layout_constraintTop_toTopOf="@+id/contentInset_top"/>
    <View
        android:id="@+id/immersive_toolbar_bottom_scrim"
        android:background="#613baf"
        android:layout_width="0dp"
        android:layout_height="@dimen/immersive_toolbar_bottom_scrim_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"/>
    <Space
        android:id="@+id/rail_spacer"
        android:layout_width="0dp"
        android:layout_height="@dimen/rail_height"
        app:layout_constraintBottom_toBottomOf="@+id/contentInset_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/rail"
        android:background="#ff111111"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/contentInset_bottom"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"
        app:layout_constraintTop_toTopOf="@+id/rail_spacer">
        <tag
            android:value="true"
            android:id="@+id/casts_window_insets_displacing_decoration"/>
    </View>
    <View
        android:id="@+id/demand_rail"
        android:background="#ff999d8e"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rail"
        app:layout_constraintLeft_toLeftOf="@+id/rail"
        app:layout_constraintRight_toRightOf="@+id/rail"
        app:layout_constraintTop_toTopOf="@+id/rail"/>
    <View
        android:id="@+id/ime"
        android:background="#ff383b3a"
        android:paddingLeft="@dimen/coolwalk_gutter_padding"
        android:paddingRight="@dimen/coolwalk_gutter_padding"
        android:layout_width="0dp"
        android:layout_height="@dimen/car_ime_height"
        app:layout_constraintBottom_toTopOf="@+id/rail_spacer"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right">
        <tag
            android:value="true"
            android:id="@+id/rounded_corners"/>
    </View>
    <View
        android:id="@+id/frx"
        android:background="#aa987654"
        android:paddingLeft="@dimen/coolwalk_gutter_padding"
        android:paddingTop="@dimen/coolwalk_gutter_padding"
        android:paddingRight="@dimen/coolwalk_gutter_padding"
        android:paddingBottom="@dimen/coolwalk_gutter_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/contentInset_bottom"
        app:layout_constraintLeft_toLeftOf="@+id/contentInset_left"
        app:layout_constraintRight_toRightOf="@+id/contentInset_right"
        app:layout_constraintTop_toTopOf="@+id/contentInset_top">
        <tag
            android:value="true"
            android:id="@+id/rounded_corners"/>
    </View>
    <View
        android:id="@+id/fullscreen"
        android:background="#aa123456"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/rounded_corner_mask"
        android:background="#7f55b1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
