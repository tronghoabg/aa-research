<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.layout.KeyEventDispatchingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/notification_center_background"
        android:background="?attr/colorSurfaceDim"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.apps.auto.sdk.ui.PagedListView
        android:id="@+id/paged_list_view"
        android:paddingTop="@dimen/gearhead_baseline_grid_2x"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:inertialScrollingEnabled="true"
        app:listMaxWidth="0dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/no_notifications_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.Boardwalk.Body1"
            android:id="@+id/no_notifications_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_notifications"
            android:maxLines="1"/>
        <com.google.android.apps.auto.components.coolwalk.compose.viewcompat.CarButton
            android:label="@string/close_notification_center"
            android:layout_gravity="center"
            android:id="@+id/close_icon"
            android:paddingLeft="@dimen/gearhead_baseline_grid_5x"
            android:paddingRight="@dimen/gearhead_baseline_grid_5x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gearhead_baseline_grid_3x"
            app:carButtonType="tonal"/>
    </LinearLayout>
</com.google.android.apps.auto.components.system.layout.KeyEventDispatchingFrameLayout>
