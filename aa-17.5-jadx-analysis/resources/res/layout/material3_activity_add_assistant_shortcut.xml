<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">
    <include layout="@layout/material3_toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/add_assistant_shortcut_screen_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="center"
                android:id="@+id/icon_bg"
                android:layout_width="@dimen/add_assistant_shortcut_icon_bg_width"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:minHeight="@dimen/add_assistant_shortcut_icon_bg_height"
                style="@style/Widget.GoogleMaterial3.CardView.Elevated">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="@dimen/add_assistant_shortcut_icon_size"
                        android:layout_height="@dimen/add_assistant_shortcut_icon_size"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.27"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="center"
                        android:id="@+id/icon_circular_crop_container"
                        android:clipToPadding="false"
                        android:layout_width="@dimen/launcher_app_settings_icon_diameter"
                        android:layout_height="@dimen/launcher_app_settings_icon_diameter"
                        android:layout_marginTop="@dimen/add_assistant_shortcut_badge_margin_top"
                        android:layout_marginStart="@dimen/add_assistant_shortcut_badge_margin_start"
                        app:cardCornerRadius="@dimen/launcher_app_settings_badge_background_diameter"
                        app:layout_constraintStart_toStartOf="@+id/icon"
                        app:layout_constraintTop_toTopOf="@+id/icon"
                        app:strokeWidth="0dp"
                        style="@style/Widget.GoogleMaterial3.CardView.Filled">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_gravity="center"
                            android:id="@+id/badge_background"
                            android:layout_width="@dimen/launcher_app_settings_assistant_action_badge_diameter"
                            android:layout_height="@dimen/launcher_app_settings_assistant_action_badge_diameter"
                            app:cardBackgroundColor="@color/coolwalk_white"
                            app:cardCornerRadius="@dimen/launcher_app_settings_assistant_action_badge_radius"
                            app:strokeWidth="0dp"
                            style="@style/Widget.GoogleMaterial3.CardView.Filled"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/badge"
                            android:padding="3dp"
                            android:layout_width="@dimen/launcher_app_settings_assistant_action_badge_diameter"
                            android:layout_height="@dimen/launcher_app_settings_assistant_action_badge_diameter"
                            android:src="@drawable/ic_assistant_logo"
                            android:tint="@color/black"/>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textSize="@dimen/add_assistant_shortcut_label_text_size"
                        android:textColor="?android:attr/textColorPrimary"
                        android:ellipsize="end"
                        android:id="@+id/icon_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_assistant_shortcut_icon_label_margin_top"
                        android:maxWidth="@dimen/add_assistant_shortcut_label_max_width"
                        android:text="@string/settings_customize_add_assistant_shortcut_label_placeholder"
                        android:maxLines="1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/icon"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/query_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/add_assistant_shortcut_top_margin_top"
                android:hint="@string/settings_customize_add_assistant_shortcut_query_hint"
                android:layout_marginStart="@dimen/add_assistant_shortcut_side_margin"
                android:layout_marginEnd="@dimen/add_assistant_shortcut_side_margin"
                app:helperText="@string/settings_customize_add_assistant_shortcut_query_helper_text"
                app:helperTextEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/label_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/add_assistant_shortcut_top_margin_top"
                android:hint="@string/settings_customize_add_assistant_shortcut_label_hint"
                android:layout_marginStart="@dimen/add_assistant_shortcut_side_margin"
                android:layout_marginEnd="@dimen/add_assistant_shortcut_side_margin"
                app:helperText="@string/settings_customize_add_assistant_shortcut_label_helper_text"
                app:helperTextEnabled="true"
                app:placeholderText="@string/settings_customize_add_assistant_shortcut_label_placeholder">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>
            <FrameLayout
                android:id="@+id/test_wrapper"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_customize_add_assistant_shortcut_activity_test_query">
                <com.google.android.material.button.MaterialButton
                    android:gravity="center"
                    android:id="@+id/test"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/add_assistant_shortcut_test_btn_margin_top"
                    android:minHeight="@dimen/add_assistant_shortcut_add_btn_height"
                    android:text="@string/settings_customize_add_assistant_shortcut_activity_test_query"
                    android:layout_marginStart="@dimen/add_assistant_shortcut_side_margin"
                    app:icon="@drawable/ic_assistant_logo"
                    style="@style/Widget.GoogleMaterial3.Button.TonalButton.Icon"/>
            </FrameLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/add_assistant_shortcut_add_btn_margin_top"
                android:minHeight="@dimen/add_assistant_shortcut_add_btn_height"
                android:text="@string/settings_customize_add_assistant_shortcut_add_button"
                android:layout_marginStart="@dimen/add_assistant_shortcut_side_margin"
                app:icon="@drawable/ic_add_shortcut"
                style="@style/Widget.GoogleMaterial3.Button.Icon"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/example_queries_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/add_assistant_shortcut_header_top_margin"
                android:text="@string/settings_customize_add_assistant_shortcut_launcher_icon_title"
                android:layout_marginStart="@dimen/add_assistant_shortcut_side_margin"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/example_queries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/add_assistant_shortcut_example_queries_top_margin"
                android:text="@string/settings_customize_add_assistant_example_queries"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="@dimen/add_assistant_shortcut_side_margin"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
