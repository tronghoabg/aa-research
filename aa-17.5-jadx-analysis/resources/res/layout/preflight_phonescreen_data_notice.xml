<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:expandedTitleTextAppearance="?attr/collapsingToolbarLayoutLargeStyle"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:titleTextAppearance="?attr/textAppearanceDisplaySmall"
                android:elevation="@dimen/gm3_scrolling_toolbar_elevation"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/gs_arrow_back_vd_theme_24"
                app:title="@string/data_notice_title"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/subtitle"
                android:paddingTop="@dimen/gm3_subtitle_padding_top"
                android:paddingBottom="@dimen/gm3_subtitle_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gm3_frx_preinstalled_apps_permissions_header_body"
                android:paddingStart="@dimen/gm3_subtitle_padding_start"
                android:paddingEnd="@dimen/gm3_subtitle_padding_end"/>
            <include
                android:id="@+id/data_charges"
                layout="@layout/phonescreen_data_notice_entry"/>
            <include
                android:id="@+id/phone_to_car"
                layout="@layout/phonescreen_data_notice_entry"/>
            <include
                android:id="@+id/car_to_phone"
                layout="@layout/phonescreen_data_notice_entry"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
