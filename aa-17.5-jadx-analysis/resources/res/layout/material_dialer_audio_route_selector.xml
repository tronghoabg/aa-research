<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@android:color/transparent"
    android:layout_width="@dimen/material_dialer_audio_route_selector_button_width"
    android:layout_height="@dimen/material_dialer_audio_route_selector_button_height"
    android:paddingStart="@dimen/padding_p1"
    android:paddingEnd="@dimen/padding_p1">
    <ImageButton
        android:layout_gravity="start|center_vertical"
        android:id="@+id/dialer_audio_route_button"
        android:layout_width="@dimen/material_dialer_audio_route_button_size"
        android:layout_height="@dimen/material_dialer_audio_route_button_size"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/dialer_audio_route_chevron"
        android:layout_width="@dimen/material_dialer_audio_route_selector_drop_down_size"
        android:layout_height="@dimen/material_dialer_audio_route_selector_drop_down_size"
        android:src="@drawable/gs_arrow_drop_down_vd_theme_24"/>
</FrameLayout>
