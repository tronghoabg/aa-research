<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primary_action_container_background"
    android:background="?attr/gearheadCardFill"
    android:addStatesFromChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/primary_action_container_ripple"
        android:background="@drawable/stream_item_suggest_action_container_stroke_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/primary_action_container"
        android:background="?attr/gearheadCardForeground"
        android:paddingTop="@dimen/common_car_card_margin_top_bottom"
        android:paddingBottom="@dimen/common_car_card_margin_top_bottom"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="@dimen/common_card_height">
        <FrameLayout
            android:id="@+id/left_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_stream_item_primary_action_icon_top_margin"
            android:layout_marginStart="@dimen/common_keyline_1">
            <ImageView
                android:id="@+id/primary_action_icon"
                android:layout_width="@dimen/common_drawer_row_small_icon_height_width"
                android:layout_height="@dimen/common_drawer_row_small_icon_height_width"
                android:tint="@color/gearhead_sdk_tint"/>
            <ImageView
                android:id="@+id/primary_image"
                android:visibility="gone"
                android:layout_width="@dimen/common_drawer_row_icon_height_width"
                android:layout_height="@dimen/common_drawer_row_icon_height_width"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/primary_icon_flair"
                android:background="@drawable/notification_small_icon_bg"
                android:padding="@dimen/common_drawer_small_icon_flair_padding"
                android:visibility="gone"
                android:layout_width="@dimen/common_drawer_small_icon_flair_height_width"
                android:layout_height="@dimen/common_drawer_small_icon_flair_height_width"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_keyline_2"
            android:layout_marginEnd="@dimen/common_keyline_1">
            <TextView
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/CommonCardBody1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/secondary_text_icon_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/un_secondary_text_icon_margin"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/CommonCardBody2"/>
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:id="@+id/text2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/CommonCardBody2"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_stream_item_primary_action_icon_top_margin"
            android:layout_marginStart="@dimen/common_stream_item_right_icon_margin_start"
            android:layout_marginEnd="@dimen/common_keyline_1">
            <ImageView
                android:id="@+id/small_icon"
                android:visibility="gone"
                android:layout_width="@dimen/common_drawer_row_icon_height_width"
                android:layout_height="@dimen/common_drawer_row_icon_height_width"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/small_icon_flair"
                android:background="@drawable/notification_small_icon_bg"
                android:padding="@dimen/common_drawer_small_icon_flair_padding"
                android:visibility="gone"
                android:layout_width="@dimen/common_drawer_small_icon_flair_height_width"
                android:layout_height="@dimen/common_drawer_small_icon_flair_height_width"
                android:scaleType="centerInside"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/expanded_card_divider"
        android:background="@color/gearhead_sdk_list_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/common_keyline_2"/>
</FrameLayout>
