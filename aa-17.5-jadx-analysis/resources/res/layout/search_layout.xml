<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/header_layout"
            android:layout_width="wrap_content"
            android:layout_height="?attr/templateHeaderHeight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/full_screen_header_layout"/>
        <RelativeLayout
            android:id="@+id/search_wrapper"
            android:background="?attr/templateEditTextRoundedCornerBackground"
            android:layout_width="0dp"
            android:layout_height="?attr/templateEditTextHeight"
            android:layout_marginStart="@dimen/template_padding_3"
            android:layout_marginEnd="@dimen/template_padding_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/action_strip"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/header_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="?attr/templateSearchBarMaxWidth">
            <com.google.android.apps.auto.components.support.CarRestrictedEditText
                android:id="@+id/search_box"
                android:background="?attr/templateEditTextRoundedCornerBackground"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawablePadding="@dimen/template_padding_2"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textSelectHandle="@drawable/empty"
                android:textCursorDrawable="@null"
                android:drawableStart="?attr/templateSearchBarIcon"
                android:paddingStart="@dimen/template_padding_1"
                android:layout_toStartOf="@+id/microphone"
                android:layout_alignParentStart="true"
                style="?attr/templateEditTextStyle"/>
            <FrameLayout
                android:id="@+id/microphone"
                android:background="?attr/templateEditTextRoundedCornerBackground"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="?attr/templateEditTextMicrophoneContainerWidth"
                android:layout_height="?attr/templateEditTextMicrophoneContainerHeight"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/template_padding_1"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="?attr/templateEditTextMicrophoneWidth"
                    android:layout_height="?attr/templateEditTextMicrophoneWidth"
                    android:src="0x7f080968"/>
            </FrameLayout>
        </RelativeLayout>
        <include
            android:id="@+id/action_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/template_edge_column_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/action_strip_view_full_template"/>
    </android.support.constraint.ConstraintLayout>
    <include
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_padding_1"
        android:layout_below="@+id/header_container"
        layout="@layout/content_view"/>
</RelativeLayout>
