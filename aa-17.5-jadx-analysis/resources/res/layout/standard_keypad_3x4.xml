<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.sdk.ui.FocusClusterLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:forceFieldType="multimoveModal">
    <include
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        layout="@layout/standard_keypad_locked_overlay"/>
    <GridLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="4"
        android:columnCount="3"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="false"
        android:alignmentMode="alignBounds">
        <ImageButton
            android:id="@+id/one"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonOne"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/two"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonTwo"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/three"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonThree"
            android:layout_marginEnd="0dp"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/four"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonFour"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/five"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonFive"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/six"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonSix"
            android:layout_marginEnd="0dp"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/seven"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonSeven"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/eight"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonEight"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/nine"
            android:layout_marginBottom="@dimen/dialpad_keypad_button_margin_bottom"
            android:src="?attr/gearheadDialerButtonNine"
            android:layout_marginEnd="0dp"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/star"
            android:layout_marginBottom="0dp"
            android:src="?attr/gearheadDialerButtonAsterisk"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/zero"
            android:layout_marginBottom="0dp"
            android:src="?attr/gearheadDialerButtonZero"
            android:layout_marginEnd="@dimen/dialpad_keypad_button_margin_end"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
        <ImageButton
            android:id="@+id/pound"
            android:layout_marginBottom="0dp"
            android:src="?attr/gearheadDialerButtonPound"
            android:layout_marginEnd="0dp"
            style="@style/Widget.Boardwalk.Button.Dialpad"/>
    </GridLayout>
</com.google.android.apps.auto.sdk.ui.FocusClusterLayout>
