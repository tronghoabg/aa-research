<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.LinearLayoutCompat
        android:gravity="end"
        android:orientation="vertical"
        android:paddingLeft="@dimen/app_quality_tester_inner_padding"
        android:paddingTop="@dimen/app_quality_tester_inner_padding"
        android:paddingRight="@dimen/app_quality_tester_inner_padding"
        android:paddingBottom="@dimen/app_quality_tester_inner_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Spinner
            android:id="@+id/component_name_spinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_quality_tester_package_spinner_height"/>
        <Button
            android:id="@+id/start_test_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_quality_tester_test_button_height"
            android:layout_marginTop="@dimen/app_quality_tester_vertical_layout_item_margin"
            android:text="@string/app_quality_test_button_label"
            app:cornerRadius="@dimen/app_quality_tester_views_corner_radius"/>
        <View
            android:background="@color/boardwalk_blue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_quality_tester_divider_height"
            android:layout_marginTop="@dimen/app_quality_tester_vertical_layout_item_margin"
            android:layout_marginBottom="@dimen/app_quality_tester_vertical_layout_item_margin"/>
        <android.support.v7.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/package_indicator_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_quality_tester_vertical_layout_item_margin"
                android:text="@string/app_quality_test_package_indicator"
                style="@style/TextAppearance.AppCompat.Body2"/>
            <View
                android:layout_width="@dimen/app_quality_tester_inner_padding"
                android:layout_height="0dp"/>
            <TextView
                android:id="@+id/component_name_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_quality_tester_vertical_layout_item_margin"
                style="@style/TextAppearance.AppCompat.Body2"/>
        </android.support.v7.widget.LinearLayoutCompat>
        <android.support.v7.widget.RecyclerView
            android:id="@+id/reports_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_quality_tester_vertical_layout_item_margin"/>
    </android.support.v7.widget.LinearLayoutCompat>
</android.support.constraint.ConstraintLayout>
