<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/CompanionAppCard">
    <RelativeLayout
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_alignBottom="@+id/bottom_spacing"
            android:layout_alignParentTop="true"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_alignParentTop="true"
            style="@style/CompanionAppCardTitle"/>
        <TextView
            android:id="@+id/body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title"
            style="@style/CompanionAppCardBody"/>
        <Space
            android:id="@+id/bottom_spacing"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_below="@+id/body"/>
        <Button
            android:id="@+id/action_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bottom_spacing"
            style="@style/CompanionAppCardActionButton"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
