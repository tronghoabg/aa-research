<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/content"
    android:background="?android:attr/selectableItemBackground"
    android:paddingTop="@dimen/frx_row_margin"
    android:paddingBottom="@dimen/frx_row_margin"
    android:layout_width="match_parent"
    android:layout_height="@dimen/companion_settings_row_height">
    <ImageView
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0809d8"
        android:tint="@color/frx_dialog_image_tint"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/car_frx_text_separation_margin"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/device_name"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_centerVertical="true"
        style="@style/TextAppearance.FrxDialogBodySmall"/>
    <CheckBox
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/device_selected"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/car_frx_text_separation_margin"
        android:checked="false"
        android:maxLines="1"
        android:layout_centerVertical="true"/>
</LinearLayout>
