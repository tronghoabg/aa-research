<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/scroll_activity_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:background="?attr/colorSurfaceDim"
        android:fadingEdgeLength="@dimen/car_frx_scroll_fading_edge_length"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:requiresFadingEdge="vertical"/>
    <FrameLayout
        android:id="@+id/button_bar_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.support.constraint.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/button_bar"
            android:background="?attr/colorSurfaceDim"
            android:paddingTop="@dimen/gm3_button_bar_vertical_margin"
            android:paddingBottom="@dimen/gm3_button_bar_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/gm3_button_bar_horizontal_margin"
            android:paddingEnd="@dimen/gm3_button_bar_horizontal_margin">
            <com.google.android.material.button.MaterialButton
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:gravity="center"
                android:id="@+id/secondary_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permissions_settings"
                android:singleLine="false"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/left_button_start_text_padding"
                android:paddingEnd="@dimen/left_button_start_text_padding"
                android:layout_toStartOf="@+id/accept_button"
                android:layout_alignParentStart="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/materialButtonOutlinedStyle"/>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:gravity="center"
                android:id="@+id/accept_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permissions_ok"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </android.support.constraint.ConstraintLayout>
    </FrameLayout>
</LinearLayout>
