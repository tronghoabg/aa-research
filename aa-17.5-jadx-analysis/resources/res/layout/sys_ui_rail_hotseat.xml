<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/rail_hotseat_container"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.google.android.apps.auto.components.system.facetbar.hotseat.RailHotseatItemView
        android:id="@+id/hotseat_one"
        android:layout_width="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:layout_height="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:checkable="false"
        app:iconTint="@null"/>
    <com.google.android.apps.auto.components.system.facetbar.hotseat.RailHotseatItemView
        android:id="@+id/hotseat_two"
        android:layout_width="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:layout_height="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:checkable="false"
        app:iconTint="@null"/>
    <com.google.android.apps.auto.components.system.facetbar.hotseat.RailHotseatItemView
        android:id="@+id/hotseat_three"
        android:layout_width="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:layout_height="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:checkable="false"
        app:iconTint="@null"/>
    <com.google.android.apps.auto.components.system.facetbar.hotseat.RailHotseatItemView
        android:id="@+id/hotseat_four"
        android:layout_width="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:layout_height="@dimen/coolwalk_rail_dock_icon_touch_target_size"
        android:checkable="false"
        app:iconTint="@null"/>
</LinearLayout>
