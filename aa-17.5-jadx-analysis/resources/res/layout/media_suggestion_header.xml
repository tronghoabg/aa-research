<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.system.focus.NextFocusForwardHandlingLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_suggestions_header_focus_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/media_suggestions_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/gearhead_baseline_grid_10.5x">
        <android.support.constraint.Guideline
            android:orientation="horizontal"
            android:id="@+id/header_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/gearhead_padding_3"/>
        <android.support.constraint.Guideline
            android:orientation="vertical"
            android:id="@+id/header_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/gearhead_padding_3"/>
        <android.support.constraint.Guideline
            android:orientation="vertical"
            android:id="@+id/header_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/gearhead_padding_3"/>
        <android.support.constraint.Guideline
            android:orientation="horizontal"
            android:id="@+id/header_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/gearhead_padding_3"/>
        <ImageView
            android:id="@+id/assistant_icon"
            android:layout_width="@dimen/dashboard_media_recommendation_assistant_attribution_logo_size"
            android:layout_height="@dimen/dashboard_media_recommendation_assistant_attribution_logo_size"
            android:src="@drawable/ic_assistant_logo"
            android:tint="?attr/colorOnSurface"
            android:alpha="0"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/header_bottom"
            app:layout_constraintStart_toEndOf="@+id/header_start"
            app:layout_constraintTop_toTopOf="@+id/header_top"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/for_you_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/for_you_text"
            android:layout_marginStart="@dimen/dashboard_media_recommendation_assistant_attribution_margin"
            app:layout_constraintBottom_toBottomOf="@+id/header_bottom"
            app:layout_constraintStart_toEndOf="@+id/assistant_icon"
            app:layout_constraintTop_toTopOf="@+id/header_top"
            style="@style/Widget.Gearhead.Coolwalk.TextView.Title"/>
        <ImageView
            android:id="@+id/navigation_forward_icon"
            android:visibility="invisible"
            android:layout_width="@dimen/dashboard_media_header_forward_arrow_icon_size"
            android:layout_height="@dimen/dashboard_media_header_forward_arrow_icon_size"
            android:src="@drawable/quantum_gm_ic_arrow_forward_ios_vd_theme_24"
            android:tint="?attr/colorOnSurface"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/gearhead_baseline_grid_4x"
            app:layout_constraintBottom_toBottomOf="@+id/header_bottom"
            app:layout_constraintStart_toEndOf="@+id/for_you_text"
            app:layout_constraintTop_toTopOf="@+id/header_top"/>
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.apps.auto.components.coolwalk.focusring.TappableRegion
                android:id="@+id/media_suggestions_tappable_header"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nextFocusForward="@+id/page_indicator_container"
                app:focusRingInset="@dimen/gearhead_padding_0"
                style="@style/Widget.Dashboard.PrimaryTarget"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    </android.support.constraint.ConstraintLayout>
</com.google.android.apps.auto.components.system.focus.NextFocusForwardHandlingLayout>
