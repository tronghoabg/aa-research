<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_apps"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:overScrollMode="ifContentScrolls">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/bottom_sheet_text_color"
            android:gravity="center"
            android:id="@+id/bs_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bottom_sheet_illustration_top_margin"
            android:layout_marginBottom="@dimen/bottom_sheet_title_bottom_margin"/>
        <ImageView
            android:id="@+id/bs_illustration"
            android:background="@color/bottom_sheet_illustration_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bottom_sheet_illustration_top_margin"
            android:layout_marginBottom="@dimen/bottom_sheet_illustration_bottom_margin"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/bottom_sheet_side_margin"
            android:paddingRight="@dimen/bottom_sheet_side_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/bottom_sheet_text_color"
                android:gravity="center"
                android:id="@+id/bs_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/bottom_sheet_apps_layout_bottom_margin"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/bs_buttons"
                android:paddingLeft="@dimen/bottom_sheet_side_margin"
                android:paddingRight="@dimen/bottom_sheet_side_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="@color/bottom_sheet_decline_button_text"
                    android:gravity="center"
                    android:id="@+id/bs_decline_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/bottom_sheet_apps_layout_button_height"
                    android:layout_marginEnd="@dimen/bottom_sheet_margin_between_buttons"
                    style="@style/Widget.GoogleMaterial.Button.TextButton"/>
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="@color/bottom_sheet_accept_button_text"
                    android:gravity="center"
                    android:id="@+id/bs_accept_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/bottom_sheet_apps_layout_button_height"
                    app:backgroundTint="@color/bottom_sheet_accept_button_tint"
                    style="@style/Widget.GoogleMaterial.Button"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottom_sheet_apps_layout_button_bottom_margin"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
