<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet_select_aa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bs_illustration"
        android:background="@color/bottom_sheet_illustration_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_illustration_bottom_margin"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textColor="@color/bottom_sheet_text_color"
        android:gravity="center"
        android:id="@+id/bs_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_sheet_tap_head_unit_text_side_margin"
        android:layout_marginRight="@dimen/bottom_sheet_tap_head_unit_text_side_margin"
        android:layout_marginBottom="@dimen/bottom_sheet_tap_head_unit_text_bottom_margin"/>
</LinearLayout>
