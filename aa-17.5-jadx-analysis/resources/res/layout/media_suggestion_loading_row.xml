<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_suggestion_loading_row_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="0px"
    android:layout_weight="1">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/loading_album_art"
        android:background="@drawable/dashboard_media_album_art_loading_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dashboard_media_recommendation_album_art_margin_vertical_top"
        android:layout_marginBottom="@dimen/dashboard_media_recommendation_album_art_margin_vertical_bottom"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/dashboard_media_recommendation_album_art_margin_start"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_max="@dimen/dashboard_media_recommendation_max_album_art_size"
        app:layout_constraintHeight_min="@dimen/dashboard_media_recommendation_default_album_art_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/dashboard_media_recommendation_max_album_art_size"
        app:layout_constraintWidth_min="@dimen/dashboard_media_recommendation_default_album_art_size"
        app:shapeAppearanceOverlay="@style/DashAlbumArtShapeAppearance"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/centered_text_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dashboard_card_title_margin_start"
        android:layout_marginEnd="@dimen/gearhead_padding_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/loading_album_art"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/media_suggestion_loading_title"
            android:background="@drawable/dashboard_media_loading_title_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dashboard_media_recommendation_loading_text_height"
            android:layout_marginBottom="@dimen/gearhead_padding_2"
            style="@style/TextAppearance.Gearhead.Coolwalk.Body3"/>
        <TextView
            android:id="@+id/media_suggestion_loading_subtitle"
            android:background="@drawable/dashboard_media_loading_title_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dashboard_media_recommendation_loading_text_height"
            android:layout_marginEnd="@dimen/dashboard_media_recommendation_loading_subtitle_end_margin"
            style="@style/TextAppearance.Gearhead.Coolwalk.Body3"/>
    </LinearLayout>
</android.support.constraint.ConstraintLayout>
