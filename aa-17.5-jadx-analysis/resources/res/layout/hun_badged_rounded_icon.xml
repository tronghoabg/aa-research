<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="@dimen/gearhead_hun_badge_icon_elevation">
    <androidx.cardview.widget.CardView
        android:id="@+id/large_icon_rounded_container"
        android:layout_width="@dimen/gearhead_hun_badged_icon_large_icon_size"
        android:layout_height="@dimen/gearhead_hun_badged_icon_large_icon_size"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/large_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inset="0dp"/>
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:id="@+id/small_icon_border"
        android:layout_width="@dimen/gearhead_hun_badged_icon_small_icon_container_size"
        android:layout_height="@dimen/gearhead_hun_badged_icon_small_icon_container_size"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/small_icon"
            android:layout_width="@dimen/gearhead_hun_badged_icon_small_icon_size"
            android:layout_height="@dimen/gearhead_hun_badged_icon_small_icon_size"
            style="@style/Widget.Notification.Badge"/>
    </FrameLayout>
</RelativeLayout>
