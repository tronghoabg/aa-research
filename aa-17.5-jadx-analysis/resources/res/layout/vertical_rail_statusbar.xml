<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/status_bar_card_wrapper"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.apps.auto.components.coolwalk.card.CoolwalkCardView
        android:id="@+id/status_bar_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gearhead_padding_1"
        style="@style/Widget.Coolwalk.Card.StatusBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/status_bar_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/rail_coolwalk_vertical_status_bar_margin">
            <LinearLayout
                android:id="@+id/icon_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/status_bar_icons_item_margin"
                android:paddingHorizontal="@dimen/status_bar_icons_padding_vertical"
                app:layout_constraintBottom_toTopOf="@+id/clock"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginBottom="@dimen/status_bar_icons_padding_vertical">
                <FrameLayout
                    android:id="@+id/signal_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/cell_info_overlay"
                        android:layout_width="@dimen/rail_coolwalk_signal_overlay_width_vertical"
                        android:layout_height="@dimen/signal_overlay_icon_size_vertical"
                        android:tint="?attr/colorOnSurface"
                        android:importantForAccessibility="no"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/cell_signal"
                        android:layout_width="@dimen/status_bar_icon_size"
                        android:layout_height="@dimen/status_bar_icon_size"
                        android:tint="?attr/colorOnSurface"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/battery_level"
                    android:paddingTop="@dimen/status_bar_battery_vertical_padding"
                    android:paddingBottom="@dimen/status_bar_battery_vertical_padding"
                    android:layout_width="@dimen/status_bar_icon_size"
                    android:layout_height="@dimen/status_bar_icon_size"
                    android:importantForAccessibility="no"
                    android:paddingStart="@dimen/status_bar_battery_horizontal_padding"
                    android:paddingEnd="@dimen/status_bar_battery_horizontal_padding"/>
            </LinearLayout>
            <com.google.android.apps.auto.components.system.statusbar.GhTextClock
                android:id="@+id/clock"
                android:layout_marginTop="@dimen/status_bar_icons_item_margin"
                android:layout_marginBottom="@dimen/status_bar_icons_item_margin"
                android:lines="1"
                android:autoSizeTextType="uniform"
                android:paddingHorizontal="0dp"
                app:layout_constraintBottom_toTopOf="@+id/notification_count_wrapper"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icon_row"
                app:layout_goneMarginBottom="0dp"
                style="@style/Widget.Gearhead.Coolwalk.Rail.StatusBarTextClock"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/notification_count_wrapper"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/status_bar_icons_item_margin"
                android:layout_marginBottom="@dimen/status_bar_icons_item_margin"
                app:layout_constraintBottom_toTopOf="@+id/dnd_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clock"
                app:layout_goneMarginTop="@dimen/rail_coolwalk_status_bar_notification_goneMarginTop">
                <com.google.android.apps.auto.components.ui.text.CountIndicatorTextView
                    android:id="@+id/notification_count"
                    android:visibility="gone"
                    android:layout_width="@dimen/status_bar_small_notification_badge_size"
                    android:layout_height="@dimen/status_bar_small_notification_badge_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/Widget.Gearhead.Coolwalk.TextView.StatusBarBadgeCount"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/dnd_icon"
                android:visibility="gone"
                android:layout_width="@dimen/status_bar_dnd_vertical_icon_size"
                android:layout_height="@dimen/status_bar_dnd_vertical_icon_size"
                android:layout_marginTop="@dimen/status_bar_icons_item_margin"
                android:layout_marginBottom="@dimen/status_bar_icons_item_margin"
                android:src="@drawable/gs_do_not_disturb_on_vd_theme_24"
                android:tint="?attr/colorOnSurface"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clock"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.apps.auto.components.coolwalk.card.CoolwalkCardView>
</FrameLayout>
