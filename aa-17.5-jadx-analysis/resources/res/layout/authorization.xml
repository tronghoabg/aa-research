<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <com.google.android.material.button.MaterialButton
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:layout_gravity="end"
            android:id="@+id/exit_button"
            android:paddingLeft="@dimen/authorization_dialog_material_button_horizontal_padding"
            android:paddingRight="@dimen/authorization_dialog_material_button_horizontal_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
            android:text="@string/authorization_exit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/materialButtonOutlinedStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
            <TextView
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_horizontal"
                android:id="@+id/dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/authorization_dialog_title_bottom_margin"
                android:text="@string/preflight_intro_title"
                android:drawableTop="@drawable/android_auto_gm3_logo"
                android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
            <TextView
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_horizontal"
                android:id="@+id/dialog_car_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/bottom_sheet_logo_and_prompt_padding"/>
            <TextView
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_horizontal"
                android:id="@+id/dialog_body_tos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/bottom_sheet_logo_and_prompt_padding"/>
            <TextView
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_horizontal"
                android:id="@+id/dialog_body_car_authorization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/bottom_sheet_logo_and_prompt_padding"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
            android:layout_marginBottom="@dimen/bottom_sheet_layout_padding">
            <androidx.constraintlayout.helper.widget.Flow
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="manage_button, continue_button"
                app:flow_horizontalStyle="spread_inside"
                app:flow_verticalGap="@dimen/authorization_dialog_button_margin"
                app:flow_wrapMode="chain"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:id="@+id/manage_button"
                android:paddingLeft="@dimen/authorization_dialog_material_button_horizontal_padding"
                android:paddingRight="@dimen/authorization_dialog_material_button_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tos_manage"
                style="?attr/materialButtonOutlinedStyle"/>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:id="@+id/continue_button"
                android:paddingLeft="@dimen/authorization_dialog_material_button_horizontal_padding"
                android:paddingRight="@dimen/authorization_dialog_material_button_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/authorization_continue"
                style="?attr/materialIconButtonFilledStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
