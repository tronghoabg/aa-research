<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_suggestion_row_layout"
    android:layout_width="match_parent"
    android:layout_height="0px"
    android:layout_weight="1">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/album_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dashboard_media_recommendation_album_art_margin_vertical_top"
        android:layout_marginBottom="@dimen/dashboard_media_recommendation_album_art_margin_vertical_bottom"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/dashboard_media_recommendation_album_art_margin_start"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_max="@dimen/dashboard_media_recommendation_max_album_art_size"
        app:layout_constraintHeight_min="@dimen/dashboard_media_recommendation_default_album_art_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/dashboard_media_recommendation_max_album_art_size"
        app:layout_constraintWidth_min="@dimen/dashboard_media_recommendation_default_album_art_size"
        app:shapeAppearanceOverlay="@style/DashAlbumArtShapeAppearance"/>
    <Space
        android:id="@+id/source_badge_spacer"
        android:layout_width="@dimen/dashboard_card_badge_offset"
        android:layout_height="@dimen/dashboard_card_badge_offset"
        app:layout_constraintStart_toEndOf="@+id/album_art"
        app:layout_constraintTop_toBottomOf="@+id/album_art"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/source_badge"
        android:layout_width="@dimen/dashboard_media_recommendation_badge_size"
        android:layout_height="@dimen/dashboard_media_recommendation_badge_size"
        app:layout_constraintBottom_toBottomOf="@+id/source_badge_spacer"
        app:layout_constraintEnd_toEndOf="@+id/source_badge_spacer"
        style="@style/Widget.Dashboard.Badge"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/media_suggestion_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dashboard_card_title_margin_start"
        android:layout_marginEnd="@dimen/gearhead_padding_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/album_art"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.Gearhead.Coolwalk.Body3"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.apps.auto.components.coolwalk.focusring.TappableRegion
            android:id="@+id/primary_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:focusRingInsetLeft="@dimen/gearhead_padding_0"
            app:focusRingInsetRight="@dimen/gearhead_padding_0"
            style="@style/Widget.Dashboard.PrimaryTarget"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
</android.support.constraint.ConstraintLayout>
