<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/notification_info"
    android:paddingLeft="@dimen/notification_new_info_horizontal_padding"
    android:paddingRight="@dimen/notification_new_info_horizontal_padding"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="200dp">
    <include
        android:layout_width="@dimen/notification_new_info_icon_size"
        android:layout_height="@dimen/notification_new_info_icon_size"
        layout="@layout/badged_icon"/>
    <TextView
        android:textAppearance="@style/TextAppearanceBody1"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textAppearance="@style/CommonCardBody2"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"/>
    <TextView
        android:textAppearance="@style/CommonCardBody2"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/text2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
