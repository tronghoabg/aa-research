<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/android_auto_icon_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auxiliary_fallback_icon_top_margin"
        android:layout_marginBottom="@dimen/auxiliary_fallback_icon_bottom_margin"/>
    <TextView
        android:textSize="@dimen/auxiliary_fallback_text_size"
        android:textColor="@color/boardwalk_white"
        android:gravity="center"
        android:id="@+id/aux_content_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auxiliary_fallback_text_side_margin"
        android:layout_marginEnd="@dimen/auxiliary_fallback_text_side_margin"/>
</LinearLayout>
