<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/gearhead_sdk_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gearhead_sdk_list_item_height"
    android:foreground="?attr/gearheadSearchSuggestionForeground"
    android:elevation="2dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/gearheadSearchSuggestionBackground"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:id="@+id/icon"
            android:visibility="gone"
            android:layout_width="@dimen/gearhead_sdk_list_item_icon_size_small"
            android:layout_height="@dimen/gearhead_sdk_list_item_icon_size_small"
            android:scaleType="centerCrop"
            android:layout_marginEnd="36dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/GearheadSdkBody1"/>
            <TextView
                android:id="@+id/subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/GearheadSdkBody2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:id="@+id/metadata_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:id="@+id/extra1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/GearheadSdkBody2"/>
            <TextView
                android:id="@+id/extra2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/GearheadSdkBody2"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
