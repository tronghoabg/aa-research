<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="?android:attr/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@dimen/speedbump_background_alpha"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/speedbump_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/speedbump_drawable"
            android:background="@drawable/speedbump_background"
            android:layout_width="@dimen/speedbump_width"
            android:layout_height="@dimen/speedbump_height"
            android:layout_marginBottom="@dimen/speedbump_margin_bottom"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <ProgressBar
                android:id="@+id/progress_bar"
                android:background="@drawable/speedbump_background"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/speedbump_progress_bar"
                android:layout_alignParentBottom="true"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
        </RelativeLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/lockout_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speedbump_lockout_message"
            android:layout_alignTop="@+id/speedbump_drawable"
            android:layout_alignBottom="@+id/speedbump_drawable"
            android:layout_alignStart="@+id/speedbump_drawable"
            android:layout_alignEnd="@+id/speedbump_drawable"
            style="@style/TextAppearance.Gearhead.Speedbump"/>
    </RelativeLayout>
</FrameLayout>
