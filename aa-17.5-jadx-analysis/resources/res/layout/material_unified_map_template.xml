<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/focus_frame"
        android:background="@null"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/minimized_focus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/pan_overlay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/pan_overlay"/>
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/templateMapWithContentCardStartMargin"
        android:layout_marginVertical="@dimen/padding_p2"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/template_card_content_container_max_height"
        app:layout_constraintHorizontal_bias="?attr/templateMapWithContentCardHorizontalBias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="?attr/templateMapWithContentCardVerticalBias"
        app:layout_constraintWidth_max="@dimen/template_card_content_container_max_width"
        app:layout_constraintWidth_min="@dimen/template_card_content_container_default_width"
        app:layout_constraintWidth_percent="?attr/templateMapWithContentCardWidthFraction">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/padding_p4"
            app:cardElevation="3dp"/>
    </LinearLayout>
    <com.google.android.apps.auto.components.apphost.view.presenters.navigation.minimized.MinimizedTurnCardView
        android:id="@+id/minimized_turn_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_p2"
        android:layout_marginStart="@dimen/padding_p1"
        android:layout_marginEnd="@dimen/padding_p2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.apps.auto.components.apphost.basewidgets.action.MaterialActionStripView
        android:orientation="horizontal"
        android:id="@+id/horizontal_floating_actions"
        android:paddingBottom="@dimen/padding_p0"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_p2"
        android:layout_marginEnd="@dimen/padding_p2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.apps.auto.components.apphost.basewidgets.action.MaterialActionStripView
        android:orientation="vertical"
        android:id="@+id/vertical_floating_actions"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/padding_p2"
        android:paddingStart="@dimen/padding_p0"
        android:layout_marginEnd="@dimen/padding_p2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
