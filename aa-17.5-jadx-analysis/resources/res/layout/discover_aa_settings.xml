<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/material_grey_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="48dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@mipmap/product_logo_android_auto_round_launcher_color_48"
                android:contentDescription="@string/car_app_name"/>
            <TextView
                android:textSize="28sp"
                android:textColor="@color/material_grey_900"
                android:id="@+id/discover_aa_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/material_grey_700"
                    android:id="@+id/car_setup_discover_nav"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_margin="8dp"
                    android:text="@string/car_setup_discover_navigation"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/quantum_ic_directions_vd_theme_24"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/material_grey_700"
                    android:id="@+id/car_setup_discover_media"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_margin="8dp"
                    android:text="@string/car_setup_discover_media"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/quantum_ic_headset_vd_theme_24"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/material_grey_700"
                    android:id="@+id/car_setup_discover_messaging"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_margin="8dp"
                    android:text="@string/car_setup_discover_messaging"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/quantum_ic_message_vd_theme_24"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/material_grey_700"
                    android:id="@+id/car_setup_discover_voice_control"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_margin="8dp"
                    android:text="@string/car_setup_discover_voice_control"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/quantum_ic_mic_vd_theme_24"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/discover_aa_divider"
            android:showDividers="middle|beginning">
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/material_teal_500"
                android:gravity="start|center_vertical"
                android:id="@+id/car_setup_discover_get_app"
                android:background="@drawable/discover_aa_rippleable"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/car_setup_get_the_app"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/material_teal_500"
                android:gravity="start|center_vertical"
                android:id="@+id/car_setup_discover_learn_more"
                android:background="@drawable/discover_aa_rippleable"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/common_learn_more"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
