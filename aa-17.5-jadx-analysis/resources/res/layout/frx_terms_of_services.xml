<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/carFrxBackgroundColor"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingBottom="@dimen/car_margin_medium"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tos_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="@string/terms_of_service_title"
        style="@style/TextAppearance.FrxTitle"/>
    <TextView
        android:textColorLink="@color/frx_link_color"
        android:id="@+id/tos_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_text_spacing"
        android:text="@string/frx_tos"
        android:layout_below="@+id/tos_header"
        style="@style/TextAppearance.FrxAppDescription"/>
    <TextView
        android:id="@+id/data_notice_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_frx_margin"
        android:text="@string/data_notice_title"
        android:layout_below="@+id/tos_body"
        style="@style/TextAppearance.FrxTitle"/>
    <TextView
        android:textColorLink="@color/frx_link_color"
        android:id="@+id/data_notice_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_text_spacing"
        android:text="@string/data_notice_content"
        android:layout_below="@+id/data_notice_header"
        style="@style/TextAppearance.FrxAppDescription"/>
</RelativeLayout>
