<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/suggestion_1_icon"
        android:layout_width="@dimen/navsuggestions_icon_size"
        android:layout_height="@dimen/navsuggestions_icon_size"
        android:layout_margin="@dimen/navsuggestions_icon_margin"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_1_name"
        app:layout_constraintEnd_toEndOf="@+id/suggestion_1_tap_target_container"
        app:layout_constraintStart_toStartOf="@+id/suggestion_1_tap_target_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/suggestion_1_name_area"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_name_line_height"/>
    <Space
        android:id="@+id/suggestion_1_subtext_area"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_subtext_line_height"/>
    <TextView
        android:id="@+id/suggestion_1_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gearhead_padding_1"
        android:layout_marginStart="0dp"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_1_subtext"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toBottomOf="@+id/suggestion_1_icon"/>
    <TextView
        android:id="@+id/suggestion_1_subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
        app:layout_constraintTop_toBottomOf="@+id/suggestion_1_name"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/suggestion_1_tap_target_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/suggestion_divider"
        android:background="?attr/colorOutline"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="@dimen/navsuggestions_divider_alpha"/>
    <ImageView
        android:id="@+id/suggestion_2_icon"
        android:visibility="gone"
        android:layout_width="@dimen/navsuggestions_icon_size"
        android:layout_height="@dimen/navsuggestions_icon_size"
        android:layout_margin="@dimen/navsuggestions_icon_margin"/>
    <Space
        android:id="@+id/suggestion_2_name_area"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_name_line_height"/>
    <Space
        android:id="@+id/suggestion_2_subtext_area"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/navsuggestions_subtext_line_height"/>
    <TextView
        android:id="@+id/suggestion_2_name"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/suggestion_2_subtext"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/suggestion_2_tap_target_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</android.support.constraint.ConstraintLayout>
