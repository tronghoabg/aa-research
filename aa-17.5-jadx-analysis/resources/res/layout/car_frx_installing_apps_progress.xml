<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/carFrxBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@color/car_frx_scroll_shadow"
        android:fadingEdgeLength="@dimen/car_frx_scroll_fading_edge_length"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/carFrxBackgroundColor"
            android:paddingLeft="@dimen/car_frx_margin_edge"
            android:paddingTop="@dimen/car_frx_margin"
            android:paddingRight="@dimen/car_frx_margin_edge"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/apps_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/car_frx_title_margin_bottom"
                style="@style/TextAppearance.FrxTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/new_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/car_frx_title_margin_bottom"
                style="@style/TextAppearance.FrxSmallTitle.Cakewalk.Phone"/>
            <TextView
                android:gravity="center"
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="448dp"
                android:maxLines="100"
                style="@style/TextAppearance.FrxBody"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
