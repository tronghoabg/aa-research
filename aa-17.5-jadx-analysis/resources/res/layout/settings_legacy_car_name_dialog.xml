<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/settings_dialog_horizontal_padding"
    android:paddingEnd="@dimen/settings_dialog_horizontal_padding">
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_dialog_text_top_margin"
        android:layout_marginBottom="4dp">
        <EditText
            android:enabled="false"
            android:id="@+id/manufacturer_text"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/settings_dialog_disabled_text_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/untitled"
            android:hint="@string/manufacturer"
            android:inputType="text"
            android:paddingStart="@dimen/settings_dialog_disabled_text_padding"
            android:paddingEnd="@dimen/settings_dialog_disabled_text_padding"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_dialog_text_top_margin"
        android:layout_marginBottom="10dp">
        <EditText
            android:id="@+id/name_text"
            android:paddingTop="@dimen/settings_dialog_text_top_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/untitled"
            android:hint="@string/name"
            android:selectAllOnFocus="true"
            android:inputType="text"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
