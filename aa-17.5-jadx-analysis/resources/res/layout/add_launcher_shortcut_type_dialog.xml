<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/add_shortcut_dialog_content_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/contact_icon"
        android:src="0x7f0804ef"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AddShortcutTypeSelectionDialogIcon"/>
    <TextView
        android:id="@+id/call_shortcut"
        android:text="@string/settings_customize_add_shortcut_dialog_option_contact"
        app:layout_constraintBottom_toBottomOf="@+id/contact_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/contact_icon"
        app:layout_constraintTop_toTopOf="@+id/contact_icon"
        style="@style/AddShortcutTypeSelectionDialogLabel"/>
    <View
        android:id="@+id/call_shortcut_click_target"
        app:layout_constraintBottom_toTopOf="@+id/assistant_icon"
        app:layout_constraintEnd_toEndOf="@+id/call_shortcut"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/contact_icon"
        style="@style/AddShortcutTypeSelectionDialogClickTarget"/>
    <ImageView
        android:id="@+id/assistant_icon"
        android:layout_marginTop="@dimen/add_shortcut_dialog_assistant_icon_top_margin"
        android:layout_marginBottom="@dimen/add_shortcut_dialog_assistant_icon_bottom_margin"
        android:src="@drawable/ic_assistant_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_shortcut"
        style="@style/AddShortcutTypeSelectionDialogIcon"/>
    <TextView
        android:id="@+id/assistant_shortcut"
        android:layout_width="0dp"
        android:text="@string/settings_customize_add_shortcut_dialog_option_assistant"
        android:singleLine="false"
        app:layout_constraintBottom_toBottomOf="@+id/assistant_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/assistant_icon"
        app:layout_constraintTop_toTopOf="@+id/assistant_icon"
        style="@style/AddShortcutTypeSelectionDialogLabel"/>
    <View
        android:id="@+id/assistant_shortcut_click_target"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/assistant_shortcut"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contact_icon"
        style="@style/AddShortcutTypeSelectionDialogClickTarget"/>
</androidx.constraintlayout.widget.ConstraintLayout>
