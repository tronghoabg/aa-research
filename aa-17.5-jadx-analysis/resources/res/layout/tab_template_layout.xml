<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <View
        android:id="@+id/header_shim"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="-20dp"/>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <com.google.android.apps.auto.components.apphost.view.widgets.common.HeaderView
            android:id="@+id/header_view"
            android:focusable="false"
            android:descendantFocusability="afterDescendants"
            android:layout_width="wrap_content"
            android:layout_height="?attr/templateHeaderHeight"
            android:paddingStart="@dimen/template_edge_column_margin"
            app:isCard="false"/>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.TransitionSafeTabLayout
            android:theme="@style/Theme.MaterialComponents.NoActionBar.Bridge"
            android:id="@+id/tab_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabBackground="@drawable/tab_background"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="0dp"
            app:tabMode="fixed"
            app:tabRippleColor="@color/google_transparent"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/content_container"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/progress_container"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="?attr/templateMessageIconSize"
            android:layout_height="?attr/templateMessageIconSize"
            style="?attr/templateLoadingSpinnerStyle"/>
    </FrameLayout>
</LinearLayout>
