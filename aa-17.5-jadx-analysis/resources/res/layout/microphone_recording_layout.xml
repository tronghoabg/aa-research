<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/add_scrim">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline"/>
    <view
        android:id="@+id/microphone_recording_bar_container"
        android:background="@drawable/progress_bar_container"
        android:focusable="true"
        android:layout_width="@dimen/app_host_audio_progress_bar_container_width"
        android:layout_height="@dimen/app_host_audio_progress_bar_container_height"
        android:layout_marginBottom="@dimen/app_host_audio_progress_bar_container_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        class="com.android.car.libraries.apphost.view.MicrophoneRecordingView$RecordingBarContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
