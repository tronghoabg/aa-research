<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.GridView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/template_padding_1"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/progress_container"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/templateLoadingSpinnerStyle"/>
    </FrameLayout>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/list_no_items_text"
        android:background="@drawable/no_content_view_focus_ring"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/templateNoContentPaddingHorizontal"
        android:paddingVertical="?attr/templateNoContentPaddingVertical"
        style="?attr/templateGridEmptyTextStyle"/>
    <com.google.android.apps.auto.components.apphost.view.widgets.common.GridPagedListView
        android:id="@+id/grid_paged_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:inertialScrollingEnabled="true"
        style="?attr/templateGridStyle"/>
</com.google.android.apps.auto.components.apphost.view.widgets.common.GridView>
