<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <include
        android:id="@+id/touch_dialpad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/cal_standard_dialpad_view"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <include
            android:layout_width="0dp"
            android:layout_height="?attr/templateHeaderHeight"
            android:layout_weight="1"
            layout="@layout/full_screen_header_layout"/>
    </LinearLayout>
</FrameLayout>
