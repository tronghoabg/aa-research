<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.MaterialRowContainerViewRowImpl xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:markerAppearance="?attr/templateListMarkerAppearance">
    <com.google.android.material.divider.MaterialDivider
        android:layout_gravity="top"
        android:id="@+id/row_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="?attr/templateDividerColor"
        app:dividerInsetEnd="?attr/templateRowDividerHorizontalPadding"
        app:dividerInsetStart="?attr/templateRowDividerHorizontalPadding"/>
    <com.google.android.apps.auto.components.apphost.view.widgets.common.MaterialRowView
        android:orientation="vertical"
        android:id="@+id/row_view_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.apps.auto.components.apphost.view.widgets.common.RowViewPrimaryContentContainer
                android:id="@+id/row_view_primary_content_container"
                android:background="?attr/templateRowBackground"
                android:paddingTop="@dimen/padding_p3"
                android:paddingBottom="@dimen/padding_p3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="?attr/templateRowMinHeight"
                android:layout_weight="1"
                android:paddingHorizontal="?attr/templateRowHorizontalPadding">
                <androidx.cardview.widget.CardView
                    android:layout_gravity="top"
                    android:id="@+id/marker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="?attr/templateRowMarkerMinSize"
                    android:minHeight="?attr/templateRowMarkerMinSize"
                    android:layout_marginEnd="@dimen/template_padding_1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/marker_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/row_image_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/row_image"
                            android:visibility="gone"
                            android:layout_width="?attr/templateRowIconSize"
                            android:layout_height="?attr/templateRowIconSize"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="?attr/templateRowImageRightMargin"
                            app:strokeColor="@null"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/row_text_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="?attr/templateRowTextHorizontalPadding"
                        android:paddingEnd="?attr/templateRowTextHorizontalPadding">
                        <include
                            android:id="@+id/row_view_title"
                            layout="@layout/row_view_title"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/new_row_decoration_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginStart="@dimen/template_padding_4">
                        <TextView
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/new_row_decoration_text"
                            android:background="@drawable/row_decoration_background"
                            android:paddingLeft="?attr/templateRowDecorationPadding"
                            android:paddingRight="?attr/templateRowDecorationPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="?attr/templateRowDecorationHeight"
                            android:minWidth="?attr/templateRowDecorationWidth"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:backgroundTint="?attr/templateRowDecorationBackgroundColor"
                            style="?attr/templateRowDecorationTextStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/row_toggle_container"
                        android:focusable="false"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="?attr/templateRowSelectionContainerHeight"
                        android:layout_marginStart="@dimen/template_padding_4">
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_gravity="center"
                            android:id="@+id/row_toggle"
                            android:focusable="false"
                            android:layout_width="?attr/templateToggleWidth"
                            android:layout_height="?attr/templateToggleHeight"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/row_caret_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/row_caret"
                            android:layout_width="?attr/templateRowIconSize"
                            android:layout_height="?attr/templateRowIconSize"
                            android:src="@drawable/gs_navigate_next_vd_theme_24"
                            android:scaleType="fitXY"
                            android:tint="?attr/templateRowCaretIconTint"
                            android:layout_marginStart="@dimen/template_padding_4"
                            android:layout_marginEnd="@dimen/template_padding_1"
                            android:tintMode="src_in"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/row_radio_button_container"
                        android:focusable="false"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="?attr/templateRowSelectionContainerHeight"
                        android:layout_marginStart="@dimen/template_padding_4"
                        android:layout_marginEnd="@dimen/template_padding_3">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/row_radio_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.apps.auto.components.apphost.view.widgets.common.RowViewPrimaryContentContainer>
            <FrameLayout
                android:id="@+id/row_view_secondary_content_container"
                android:background="?attr/templateRowBackground"
                android:paddingTop="@dimen/template_padding_2"
                android:paddingBottom="@dimen/template_padding_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="?attr/templateRowMinHeight"
                android:paddingEnd="?attr/templateRowHorizontalPadding">
                <include layout="@layout/row_view_secondary_action_full_list"/>
            </FrameLayout>
        </LinearLayout>
        <com.google.android.apps.auto.components.apphost.view.widgets.common.ActionButtonListView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/row_action_button_list_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:equalWidthButtons="true"/>
    </com.google.android.apps.auto.components.apphost.view.widgets.common.MaterialRowView>
</com.google.android.apps.auto.components.apphost.view.widgets.common.MaterialRowContainerViewRowImpl>
