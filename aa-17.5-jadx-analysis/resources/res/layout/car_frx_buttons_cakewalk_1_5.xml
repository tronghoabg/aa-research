<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button_bar"
    android:background="?attr/carFrxBackgroundColor"
    android:paddingTop="@dimen/cakewalk_button_bar_vertical_margin"
    android:paddingBottom="@dimen/cakewalk_button_bar_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/cakewalk_button_bar_start_padding"
    android:paddingEnd="@dimen/cakewalk_button_bar_end_padding">
    <Button
        android:gravity="start|center_vertical"
        android:id="@+id/left_button"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/left_button_start_text_padding"
        android:paddingEnd="@dimen/left_button_start_text_padding"
        android:layout_alignParentStart="true"
        style="@style/CarFrxButton.Cakewalk.Phone.Cancel"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        style="@style/CarFrxButton.Cakewalk.Phone.Continue"/>
</RelativeLayout>
