<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/badged_icon_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="@dimen/gearhead_hun_badge_icon_elevation">
    <ImageView
        android:id="@+id/large_icon"
        android:layout_width="@dimen/gearhead_hun_badged_icon_large_icon_size"
        android:layout_height="@dimen/gearhead_hun_badged_icon_large_icon_size"/>
    <FrameLayout
        android:id="@+id/small_icon_border"
        android:layout_width="@dimen/gearhead_hun_badged_icon_small_icon_container_size"
        android:layout_height="@dimen/gearhead_hun_badged_icon_small_icon_container_size"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/small_icon"
            android:layout_width="@dimen/gearhead_hun_badged_icon_small_icon_size"
            android:layout_height="@dimen/gearhead_hun_badged_icon_small_icon_size"
            style="@style/Widget.Notification.Badge"/>
    </FrameLayout>
</RelativeLayout>
