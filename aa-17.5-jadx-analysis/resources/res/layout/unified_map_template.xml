<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Template.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/content_container"
        android:visibility="gone"
        layout="@layout/card_container"/>
    <include
        android:id="@+id/content_container_minimized"
        android:visibility="gone"
        layout="@layout/card_container_minimized"/>
    <include
        android:id="@+id/nav_card_container"
        android:visibility="gone"
        layout="@layout/responsive_turn_card_half_list_container"/>
    <FrameLayout
        android:id="@+id/focus_frame"
        android:background="@null"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/minimized_focus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/pan_overlay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/pan_overlay"/>
    <FrameLayout
        android:id="@+id/horizontal_floating_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/action_strip"
            layout="@layout/action_strip_view_floating"/>
    </FrameLayout>
    <include
        android:id="@+id/map_action_strip"
        layout="@layout/map_action_strip_view_floating"/>
</android.support.constraint.ConstraintLayout>
