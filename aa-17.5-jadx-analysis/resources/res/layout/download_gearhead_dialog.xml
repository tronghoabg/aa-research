<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
    android:filterTouchesWhenObscured="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="@dimen/dialog_margin_bottom"
        android:text="@string/car_setup_bottom_sheet_welcome_download_title"
        android:drawableTop="@drawable/android_auto_gm3_logo"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"
        android:layout_marginStart="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginEnd="@dimen/bottom_sheet_parent_layout_margin"/>
    <TextView
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_margin_top"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_illustration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_margin_top"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
        android:src="@drawable/phone_frx_default"
        android:adjustViewBounds="true"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/installing_progress_layout"
        android:layout_width="@dimen/bottom_sheet_download_layout_size"
        android:layout_height="@dimen/bottom_sheet_download_layout_size">
        <ImageView
            android:gravity="center"
            android:id="@+id/app_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/car_frx_install_icon"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <ProgressBar
            android:gravity="center"
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:max="100"
            android:indeterminate="false"
            android:indeterminateOnly="false"/>
    </FrameLayout>
    <TextView
        android:textAppearance="?attr/textAppearanceBody2"
        android:gravity="center"
        android:id="@+id/caption"
        android:paddingTop="@dimen/bottom_sheet_download_caption_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_parent_layout_margin"
        android:text="@string/car_setup_download_progress"/>
</LinearLayout>
