<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/QuNavigationDisclaimerDialog">
    <LinearLayout style="@style/QuNavigationDialogContent">
        <TextView
            android:id="@+id/disclaimer_title_text"
            android:text="@string/DISCLAIMER_TITLE"
            style="@style/QuNavigationDialogTitleTextBox"/>
        <TextView
            android:id="@+id/disclaimer_text"
            android:text="@string/DISCLAIMER"
            style="@style/QuNavigationDialogTextBox"/>
        <TextView
            android:id="@+id/legal_text_tab_indent"
            style="@style/QuNavigationDialogTextBoxTabIndent"/>
        <TextView
            android:id="@+id/legal_text"
            style="@style/QuNavigationDialogTextBoxAtEnd"/>
    </LinearLayout>
</ScrollView>
