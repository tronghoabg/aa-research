<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_error"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:overScrollMode="ifContentScrolls">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/bs_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/preflight_botttom_sheet_top_margin"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_1x"
            android:layout_marginStart="@dimen/bottom_sheet_side_margin"
            android:layout_marginEnd="@dimen/bottom_sheet_side_margin"
            style="@style/TextAppearance.FrxSmallTitle.Medium.Cakewalk.Phone"/>
        <TextView
            android:gravity="center"
            android:id="@+id/bs_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_3x"
            android:layout_marginStart="@dimen/bottom_sheet_side_margin"
            android:layout_marginEnd="@dimen/bottom_sheet_side_margin"
            style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
        <ImageView
            android:id="@+id/bs_illustration"
            android:background="@color/bottom_sheet_illustration_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gearhead_baseline_grid_3x"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</ScrollView>
