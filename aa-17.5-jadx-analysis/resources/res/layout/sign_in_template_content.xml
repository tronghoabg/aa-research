<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/templatePlainContentContainerStyle">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/sign_in_progress_bar"
        android:visibility="gone"
        android:layout_width="?attr/templateSignInProgressBarImageSize"
        android:layout_height="?attr/templateSignInProgressBarImageSize"
        style="?attr/templateLoadingSpinnerStyle"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/sign_in_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/instruction_text"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_1"
            android:foreground="@drawable/no_content_view_focus_ring_legacy"
            style="?attr/templateSignInInstructionTextStyle"/>
        <include
            android:id="@+id/provider_sign_in_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/templateActionHeight"
            android:layout_marginTop="@dimen/template_padding_4"
            layout="@layout/sign_in_button_view"/>
        <include
            android:id="@+id/input_sign_in_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_4"
            layout="@layout/input_sign_in_view"/>
        <include
            android:id="@+id/pin_sign_in_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/templateActionHeight"
            android:layout_marginTop="@dimen/template_padding_4"
            layout="@layout/pin_sign_in_view"/>
        <include
            android:id="@+id/qr_code_sign_in_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_2"
            layout="@layout/qr_code_sign_in_view"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/additional_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_3"
            layout="@layout/clickable_span_text_container"/>
        <include
            android:id="@+id/action_button_list_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_padding_5"
            layout="@layout/action_button_list_view"/>
    </LinearLayout>
</FrameLayout>
