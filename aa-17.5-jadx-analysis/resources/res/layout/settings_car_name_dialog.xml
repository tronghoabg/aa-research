<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/manufacturer_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_dialog_text_top_margin"
        android:layout_marginBottom="@dimen/settings_dialog_title_margin"
        android:layout_below="@android:id/title"
        android:paddingStart="@dimen/settings_dialog_horizontal_padding"
        android:paddingEnd="@dimen/settings_dialog_horizontal_padding">
        <EditText
            android:enabled="false"
            android:id="@+id/manufacturer_text"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/settings_dialog_text_top_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/untitled"
            android:hint="@string/manufacturer"
            android:inputType="text"
            android:paddingStart="@dimen/settings_dialog_disabled_text_padding"
            android:paddingEnd="@dimen/settings_dialog_disabled_text_padding"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/name_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_dialog_text_top_margin"
        android:layout_marginBottom="@dimen/settings_dialog_input_bottom_margin"
        android:layout_below="@+id/manufacturer_holder"
        android:paddingStart="@dimen/settings_dialog_horizontal_padding"
        android:paddingEnd="@dimen/settings_dialog_horizontal_padding">
        <EditText
            android:id="@+id/name_text"
            android:paddingTop="@dimen/settings_dialog_text_top_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/untitled"
            android:hint="@string/name"
            android:selectAllOnFocus="true"
            android:inputType="text"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Button
        android:id="@android:id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/ok"
        android:layout_below="@+id/name_holder"
        android:layout_alignParentEnd="true"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    <Button
        android:id="@android:id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:layout_alignTop="@android:id/button1"
        android:layout_toStartOf="@android:id/button1"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
</RelativeLayout>
