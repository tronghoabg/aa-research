<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/hun_view"
    android:background="@drawable/coolwalk_hun_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gearhead_hun_simple_height"
    android:layout_marginTop="@dimen/coolwalk_gearhead_hun_margin_top"
    android:baselineAligned="false"
    android:paddingStart="@dimen/hun_content_padding"
    android:paddingEnd="@dimen/hun_content_padding"
    android:layout_marginStart="@dimen/coolwalk_gearhead_hun_margin"
    android:layout_marginEnd="@dimen/coolwalk_gearhead_hun_margin">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/notification_info"
        android:background="@drawable/coolwalk_hun_rounded_left_ripple"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/gearhead_hun_badged_icon_large_icon_size"
            android:layout_height="@dimen/gearhead_hun_badged_icon_large_icon_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Coolwalk.Body1.Hun.Deprecated"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gearhead_baseline_grid_0.5x"
            android:maxLines="@integer/coolwalk_feedback_hun_view_title_max_lines"
            android:layout_marginStart="@dimen/gearhead_baseline_grid_3x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <FrameLayout
            android:background="@drawable/hun_rounded_left_focus_ring"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </android.support.constraint.ConstraintLayout>
    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
        android:layout_gravity="end|center_vertical"
        android:id="@+id/thumbs_up_button"
        android:layout_width="@dimen/gearhead_coolwalk_feedback_hun_button_size"
        android:layout_height="@dimen/gearhead_coolwalk_hun_button_height"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
        app:icon="0x7f08098b"
        app:iconPadding="0dp"/>
    <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
        android:layout_gravity="end|center_vertical"
        android:id="@+id/thumbs_down_button"
        android:layout_width="@dimen/gearhead_coolwalk_feedback_hun_button_size"
        android:layout_height="@dimen/gearhead_coolwalk_hun_button_height"
        android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
        app:icon="0x7f08098a"
        app:iconPadding="0dp"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/notification_close_button_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include layout="@layout/hun_close_button_legacy"/>
    </FrameLayout>
</LinearLayout>
