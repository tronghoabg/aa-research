<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.ui.actionpanel.ExpandingActionPanel xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expanding_action_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.ConstraintLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.constraint.Guideline
            android:orientation="horizontal"
            android:id="@+id/metadata_actions_separator_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="@dimen/action_panel_actions_top_fraction"/>
        <android.support.constraint.Guideline
            android:orientation="horizontal"
            android:id="@+id/actions_center_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="@dimen/action_panel_actions_center_fraction"/>
        <android.support.constraint.ConstraintLayout
            android:id="@+id/metadata_inset"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/metadata_actions_separator_guideline"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <android.support.constraint.Guideline
                android:orientation="vertical"
                android:id="@+id/metadata_left_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintGuide_percent="@dimen/action_panel_metadata_left_position_fraction"/>
            <android.support.constraint.Guideline
                android:orientation="vertical"
                android:id="@+id/metadata_right_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintGuide_percent="@dimen/action_panel_metadata_right_position_fraction"/>
            <android.support.constraint.Guideline
                android:orientation="horizontal"
                android:id="@+id/above_panel_holder_bottom_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintGuide_percent="@dimen/action_panel_seek_bar_overlap_fraction"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/metadata_holder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/app_bar_height"
                app:layout_constraintBottom_toTopOf="@+id/action_panel_above_panel_holder"
                app:layout_constraintLeft_toLeftOf="@+id/metadata_left_guideline"
                app:layout_constraintRight_toRightOf="@+id/metadata_right_guideline"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/action_panel_above_panel_holder"
                android:background="@color/transparent_black"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/metadata_holder"
                app:layout_constraintRight_toRightOf="@+id/metadata_holder"
                app:layout_constraintTop_toBottomOf="@+id/metadata_holder"/>
        </android.support.constraint.ConstraintLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:orientation="horizontal"
            android:id="@+id/action_shelf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/action_panel_secondary_shelf_bottom_margin"
            android:translationY="@dimen/action_panel_secondary_shelf_bottom_margin"
            android:elevation="@dimen/action_panel_button_elevation"
            app:alignContent="space_around"
            app:alignItems="center"
            app:flexWrap="wrap_reverse"
            app:justifyContent="space_evenly"
            app:layout_constraintBottom_toBottomOf="@+id/actions_center_guideline"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <FrameLayout
                android:id="@+id/custom_wrapper_1"
                android:background="?attr/gearheadActionPanelButtonBackground"
                android:addStatesFromChildren="true"
                android:layout_width="@dimen/action_panel_button_width_height"
                android:layout_height="@dimen/action_panel_button_width_height"
                android:foregroundGravity="center"/>
            <FrameLayout
                android:id="@+id/custom_wrapper_2"
                android:background="?attr/gearheadActionPanelButtonBackground"
                android:addStatesFromChildren="true"
                android:layout_width="@dimen/action_panel_button_width_height"
                android:layout_height="@dimen/action_panel_button_width_height"
                android:foregroundGravity="center"/>
            <FrameLayout
                android:id="@+id/custom_wrapper_3"
                android:background="?attr/gearheadActionPanelButtonBackground"
                android:addStatesFromChildren="true"
                android:layout_width="@dimen/action_panel_button_width_height"
                android:layout_height="@dimen/action_panel_button_width_height"
                android:foregroundGravity="center"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/custom_wrapper_4"
                android:background="?attr/gearheadActionPanelButtonBackground"
                android:addStatesFromChildren="true"
                android:layout_width="@dimen/action_panel_button_width_height"
                android:layout_height="@dimen/action_panel_button_width_height"
                android:foregroundGravity="center"/>
            <FrameLayout
                android:id="@+id/custom_wrapper_5"
                android:background="?attr/gearheadActionPanelButtonBackground"
                android:addStatesFromChildren="true"
                android:layout_width="@dimen/action_panel_button_width_height"
                android:layout_height="@dimen/action_panel_button_width_height"
                android:foregroundGravity="center"/>
            <FrameLayout
                android:id="@+id/custom_wrapper_6"
                android:background="?attr/gearheadActionPanelButtonBackground"
                android:addStatesFromChildren="true"
                android:layout_width="@dimen/action_panel_button_width_height"
                android:layout_height="@dimen/action_panel_button_width_height"
                android:foregroundGravity="center"/>
        </com.google.android.flexbox.FlexboxLayout>
        <RelativeLayout
            android:id="@+id/lower_action_bar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="@dimen/action_panel_button_elevation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/metadata_actions_separator_guideline">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Space
                    android:id="@+id/left_most_space"
                    android:visibility="gone"
                    android:layout_width="@dimen/action_panel_button_margin_space"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/left_most_wrapper"
                    android:background="?attr/gearheadActionPanelButtonBackground"
                    android:visibility="gone"
                    android:addStatesFromChildren="true"
                    android:layout_width="@dimen/action_panel_button_width_height"
                    android:layout_height="@dimen/action_panel_button_width_height"
                    android:foregroundGravity="center"/>
                <Space
                    android:layout_width="@dimen/action_panel_inter_button_space"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/left_wrapper"
                    android:background="?attr/gearheadActionPanelButtonBackground"
                    android:addStatesFromChildren="true"
                    android:layout_width="@dimen/action_panel_button_width_height"
                    android:layout_height="@dimen/action_panel_button_width_height"
                    android:foregroundGravity="center"/>
                <Space
                    android:layout_width="@dimen/action_panel_button_fab_space"
                    android:layout_height="match_parent"/>
                <com.google.android.apps.auto.components.ui.touch.TouchStealingFrameLayout
                    android:gravity="center"
                    android:id="@+id/prime_action_container"
                    android:background="?attr/gearheadPanelFabFocusBackground"
                    android:focusable="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="@dimen/action_panel_fab_width_height"
                    android:layout_height="@dimen/action_panel_fab_width_height"/>
                <Space
                    android:layout_width="@dimen/action_panel_button_fab_space"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/right_wrapper"
                    android:background="?attr/gearheadActionPanelButtonBackground"
                    android:addStatesFromChildren="true"
                    android:layout_width="@dimen/action_panel_button_width_height"
                    android:layout_height="@dimen/action_panel_button_width_height"
                    android:foregroundGravity="center"/>
                <Space
                    android:layout_width="@dimen/action_panel_inter_button_space"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/right_most_wrapper"
                    android:background="?attr/gearheadActionPanelButtonBackground"
                    android:visibility="gone"
                    android:addStatesFromChildren="true"
                    android:layout_width="@dimen/action_panel_button_width_height"
                    android:layout_height="@dimen/action_panel_button_width_height"
                    android:foregroundGravity="center"/>
                <Space
                    android:id="@+id/right_most_space"
                    android:visibility="gone"
                    android:layout_width="@dimen/action_panel_button_margin_space"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:id="@+id/action_panel_scrim"
            android:background="@drawable/un_expanding_action_panel_scrim_gradient"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="@dimen/action_panel_scrim_elevation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </android.support.constraint.ConstraintLayout>
</com.google.android.apps.auto.components.ui.actionpanel.ExpandingActionPanel>
