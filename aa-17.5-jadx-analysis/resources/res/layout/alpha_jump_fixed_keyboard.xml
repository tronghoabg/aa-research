<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.sdk.ui.FocusClusterLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:forceFieldType="multimoveModal">
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/fixed_keyboard_margin_bottom"
        android:layout_marginStart="@dimen/gearhead_sdk_card_margin"
