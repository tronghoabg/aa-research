<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.view.widgets.common.RowContainerViewActionListImpl xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:markerAppearance="?attr/templateListMarkerAppearance">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:paddingTop="@dimen/template_padding_2"
        android:paddingBottom="@dimen/template_padding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/templateRowMinHeight"
        android:paddingStart="?attr/templateRowHorizontalPadding"
        android:paddingEnd="?attr/templateRowHorizontalPadding">
        <FrameLayout
            android:gravity="start"
            android:id="@+id/container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.view.widgets.common.RowContainerViewActionListImpl>
