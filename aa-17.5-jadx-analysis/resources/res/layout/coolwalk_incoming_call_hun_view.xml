<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/hun_view"
    android:background="@drawable/coolwalk_hun_background"
    android:padding="@dimen/hun_content_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hun_height"
    android:layout_marginTop="@dimen/coolwalk_gearhead_hun_margin_top"
    android:layout_marginStart="@dimen/coolwalk_gearhead_hun_margin"
    android:layout_marginEnd="@dimen/coolwalk_gearhead_hun_margin">
    <include
        android:layout_width="@dimen/gearhead_hun_badged_icon_size"
        android:layout_height="@dimen/gearhead_hun_badged_icon_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/hun_badged_rounded_icon"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Coolwalk.Body1.Hun.Deprecated"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/hun_text_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Boardwalk.Body3.Hun2"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/primary_action_button_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/hun_button_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/secondary_action_button_container"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/primary_action_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Hun.Button.Action.Colored.AcceptCall"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/secondary_action_button_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/hun_button_height"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tertiary_action_button_container"
        app:layout_constraintStart_toEndOf="@+id/primary_action_button_container">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/secondary_action_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Hun.Button.Action.Colored.DeclineCall"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
        android:id="@+id/tertiary_action_button_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/hun_button_height"
        android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondary_action_button_container">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/tertiary_action_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Notification.Button.Tonal"/>
    </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
</android.support.constraint.ConstraintLayout>
