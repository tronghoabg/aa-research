<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/settings_details_large_icon_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/car_frx_app_item_size"
            android:layout_height="@dimen/car_frx_app_item_size"
            android:layout_marginBottom="@dimen/settings_details_large_icon_bottom_padding">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/launcher_app_settings_icon_outline"
                android:tint="@color/background_floating_material_dark"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/car_frx_small_icon_size"
                android:layout_height="@dimen/car_frx_small_icon_size"
                android:src="@drawable/ic_car_24"
                android:tint="@android:color/white"/>
        </FrameLayout>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/car_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/settings_details_large_title_bottom_padding"
            style="@style/TextAppearance.CompanionIntro.Title"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/buttons_row"
            android:background="@drawable/car_details_buttons_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_details_buttons_row_height"
            android:layout_marginStart="@dimen/settings_details_button_bar_margin"
            android:layout_marginEnd="@dimen/settings_details_button_bar_margin">
            <Button
                android:textColor="@android:color/black"
                android:layout_gravity="center"
                android:id="@+id/delete_button"
                android:background="@android:color/transparent"
                android:paddingTop="@dimen/settings_details_buttons_top_padding"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/forget_label"
                android:drawableTop="@drawable/quantum_gm_ic_delete_vd_theme_24"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/settings_details_buttons_outside_padding"
                android:layout_marginEnd="@dimen/settings_details_buttons_inside_padding"
                android:drawableTint="@color/black"
                style="@style/TextAppearance.CompanionSettingsLabel"/>
            <View
                android:background="@android:color/white"
                android:layout_width="@dimen/settings_details_buttons_divider_width"
                android:layout_height="match_parent"/>
            <Button
                android:textColor="@android:color/black"
                android:layout_gravity="center"
                android:id="@+id/rename_button"
                android:background="@android:color/transparent"
                android:paddingTop="@dimen/settings_details_buttons_top_padding"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/rename_label"
                android:drawableTop="0x7f0804fc"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/settings_details_buttons_outside_padding"
                android:layout_marginEnd="@dimen/settings_details_buttons_inside_padding"
                android:drawableTint="@android:color/black"
                style="@style/TextAppearance.CompanionSettingsLabel"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
