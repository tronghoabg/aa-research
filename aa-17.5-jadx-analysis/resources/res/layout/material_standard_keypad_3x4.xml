<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.sdk.ui.FocusClusterLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:forceFieldType="multimoveModal">
    <include
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        layout="@layout/standard_keypad_locked_overlay"/>
    <GridLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rowCount="4"
        android:columnCount="3"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="false"
        android:alignmentMode="alignBounds">
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/one"
            app:primaryText="@string/dialpad_one_primary_text"
            app:secondaryDrawable="@drawable/gs_voicemail_vd_theme_24"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/two"
            app:primaryText="@string/dialpad_two_primary_text"
            app:secondaryText="@string/dialpad_two_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/three"
            app:primaryText="@string/dialpad_three_primary_text"
            app:secondaryText="@string/dialpad_three_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/four"
            app:primaryText="@string/dialpad_four_primary_text"
            app:secondaryText="@string/dialpad_four_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/five"
            app:primaryText="@string/dialpad_five_primary_text"
            app:secondaryText="@string/dialpad_five_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/six"
            app:primaryText="@string/dialpad_six_primary_text"
            app:secondaryText="@string/dialpad_six_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/seven"
            app:primaryText="@string/dialpad_seven_primary_text"
            app:secondaryText="@string/dialpad_seven_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/eight"
            app:primaryText="@string/dialpad_eight_primary_text"
            app:secondaryText="@string/dialpad_eight_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/nine"
            app:primaryText="@string/dialpad_nine_primary_text"
            app:secondaryText="@string/dialpad_nine_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/star"
            app:primaryText="@string/dialpad_star_primary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/zero"
            app:primaryText="@string/dialpad_zero_primary_text"
            app:secondaryText="@string/dialpad_zero_secondary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
        <com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialDialpadKey
            android:id="@+id/pound"
            app:primaryText="@string/dialpad_pound_primary_text"
            style="@style/Widget.Gearhead.Button.Material.Dialpad"/>
    </GridLayout>
</com.google.android.apps.auto.sdk.ui.FocusClusterLayout>
