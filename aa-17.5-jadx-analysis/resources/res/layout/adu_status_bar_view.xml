<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/car_mic_underlay"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:animateLayoutChanges="true"
        android:paddingStart="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:elevation="@dimen/appdecor_status_bar_elevation">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/car_drawer_title_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/header_app_icon_view"
                android:visibility="gone"
                android:layout_width="@dimen/gearhead_sdk_body_1_size"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:layout_marginEnd="@dimen/gearhead_sdk_standard_margin"
                android:elevation="@dimen/appdecor_status_bar_elevation"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/car_drawer_title"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                style="@style/GearheadSdkTitle"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:gravity="center_vertical"
            android:id="@+id/car_search_box"
            android:focusable="false"
            android:layout_width="@dimen/gearhead_sdk_app_layout_search_box_small_width"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="0"
            app:cardBackgroundColor="@color/search_box_card">
            <FrameLayout
                android:id="@+id/car_search_box_contents"
                android:background="?attr/gearheadSearchBoxFocusBackground"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="false">
                <FrameLayout
                    android:id="@+id/car_search_box_hint_container"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp">
                    <TextView
                        android:textColor="@color/search_box_text_secondary"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/car_search_box_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appdecor_search_box_hint"
                        style="@style/GearheadSdkTitle"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/car_search_box_edit_text_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/car_search_box_icon"
                        android:layout_width="@dimen/appdecor_icon_size"
                        android:layout_height="@dimen/appdecor_icon_size"
                        android:scaleType="fitCenter"
                        android:layout_marginStart="12dp"/>
                    <com.google.android.apps.auto.components.support.CarRestrictedEditText
                        android:textColor="@color/search_box_text_primary"
                        android:textColorHint="@color/search_box_text_secondary"
                        android:gravity="center_vertical"
                        android:id="@+id/car_search_box_edit_text"
                        android:background="@null"
                        android:focusableInTouchMode="false"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/appdecor_search_box_hint"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:imeOptions="actionSearch"
                        android:textSelectHandle="@drawable/gearhead_sdk_empty"
                        android:textCursorDrawable="@null"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/GearheadSdkTitle"/>
                    <FrameLayout
                        android:id="@+id/car_search_box_end_view"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/car_drawer_button_frame"
        android:background="?attr/gearheadHeaderButtonBackground"
        android:addStatesFromChildren="true"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_menu_button_size">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/car_drawer_button"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
            android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
            android:scaleType="center"
            android:elevation="@dimen/appdecor_status_bar_elevation"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/search_exit_button"
        android:background="?attr/gearheadHeaderButtonBackground"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:src="0x7f080505"
        android:scaleType="center"
        android:elevation="@dimen/appdecor_status_bar_elevation"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/car_mic_button"
        android:background="?attr/gearheadHeaderButtonBackground"
        android:focusable="false"
        android:layout_width="@dimen/gearhead_sdk_drawer_header_menu_button_size"
        android:layout_height="@dimen/gearhead_sdk_drawer_header_height"
        android:src="@drawable/ic_mic_enabled_white"
        android:scaleType="center"
        android:elevation="@dimen/appdecor_status_bar_elevation"/>
</merge>
