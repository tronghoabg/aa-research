<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/material3_ripple"
    android:paddingTop="@dimen/launcher_app_settings_add_shortcut_row_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add_shortcut"
        android:layout_marginStart="@dimen/launcher_app_settings_row_start_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_customize_add_launcher_shortcut_button"
        android:paddingStart="@dimen/launcher_app_settings_row_icon_to_text_padding"
        android:paddingEnd="@dimen/launcher_app_settings_row_spacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/description"
        android:paddingTop="@dimen/launcher_app_settings_add_shortcut_description_padding_top"
        android:paddingBottom="@dimen/launcher_app_settings_add_shortcut_description_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_customize_add_launcher_shortcut_button_description_call_and_assistant"
        android:paddingStart="@dimen/launcher_app_settings_row_icon_to_text_padding"
        android:paddingEnd="@dimen/launcher_app_settings_row_spacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/label"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
    <View
        android:id="@+id/section_separator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/CompanionAppSeparator"/>
</android.support.constraint.ConstraintLayout>
