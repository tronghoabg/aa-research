<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:expandedTitleTextAppearance="?attr/collapsingToolbarLayoutLargeStyle"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:titleTextAppearance="?attr/textAppearanceDisplaySmall"
                android:elevation="@dimen/gm3_scrolling_toolbar_elevation"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/gs_arrow_back_vd_theme_24"
                app:title="@string/frx_preinstalled_apps_permissions_title"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/subtitle"
                android:paddingTop="@dimen/gm3_subtitle_padding_top"
                android:paddingBottom="@dimen/gm3_subtitle_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gm3_frx_preinstalled_apps_permissions_header_body"
                android:paddingStart="@dimen/gm3_subtitle_padding_start"
                android:paddingEnd="@dimen/gm3_subtitle_padding_end"/>
            <RelativeLayout
                android:id="@+id/lock_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/lock_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_lock_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_padding_end"
                    android:layout_toStartOf="@+id/lock_allow_switch"
                    android:layout_toEndOf="@+id/lock_icon">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/lock_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_lock_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/lock_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_lock_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/lock_allow_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/microphone_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/microphone_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_mic_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/microphone_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/microphone_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_microphone_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/microphone_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_microphone_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/location_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/location_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_location_on_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_padding_end"
                    android:layout_toStartOf="@+id/location_allow_weather"
                    android:layout_toEndOf="@+id/location_icon">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/location_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_location_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/location_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_location_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/location_allow_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/phone_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/phone_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_mic_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/phone_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/phone_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_phone_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/phone_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_phone_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/call_log_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/call_log_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_phone_callback_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/call_log_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/call_log_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_call_log_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/call_log_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_call_log_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/sms_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/sms_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_phone_callback_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/sms_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/sms_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_sms_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/sms_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_sms_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/contact_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/contact_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_phone_callback_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/contact_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/contact_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_contacts_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/contact_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_contacts_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/calendar_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/calendar_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_calendar_month_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/calendar_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/calendar_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_calendar_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/calendar_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_calendar_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/assistant_notification_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/assistant_notification_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_lock_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_padding_end"
                    android:layout_toStartOf="@+id/assistant_notification_switch"
                    android:layout_toEndOf="@+id/assistant_notification_icon">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/assistant_notification_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_assistant_notification_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/assistant_notification_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_assistant_notification_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/assistant_notification_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/assistant_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/assistant_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_google_assistant_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/assistant_icon"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/assistant_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_assistant_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/assistant_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_assistant_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/cross_profile_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/cross_profile_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_location_on_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_padding_end"
                    android:layout_toStartOf="@+id/cross_profile_switch"
                    android:layout_toEndOf="@+id/cross_profile_icon">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/cross_profile_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_cross_profile_name"
                        style="?attr/textAppearanceTitleLarge"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/cross_profile_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_cross_profile_description"
                        style="?attr/textAppearanceTitleSmall"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/cross_profile_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/footer_container"
                android:paddingTop="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:paddingBottom="@dimen/gm3_scrolling_element_padding_top_and_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                android:paddingEnd="@dimen/gm3_scrolling_element_padding_end">
                <ImageView
                    android:id="@+id/footer_icon"
                    android:layout_width="@dimen/gm3_scrolling_element_icon_size"
                    android:layout_height="@dimen/gm3_scrolling_element_icon_size"
                    android:src="@drawable/gs_info_vd_theme_24"
                    android:adjustViewBounds="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/footer_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cakewalk_1_75_apps_permissions_footer_description"
                    android:paddingStart="@dimen/gm3_scrolling_element_padding_start"
                    android:paddingEnd="@dimen/gm3_scrolling_element_text_no_padding_end"
                    android:layout_toEndOf="@+id/footer_icon"
                    android:layout_alignParentEnd="true"
                    style="?attr/textAppearanceTitleSmall"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
