<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center"
        android:background="@drawable/dot_indicator_background"
        android:layout_width="@dimen/cluster_activity_indicator_container_view_width"
        android:layout_height="@dimen/cluster_activity_indicator_container_view_height"
        android:rotation="90"
        android:paddingStart="@dimen/cluster_dot_indicator_container_view_padding"
        android:paddingEnd="@dimen/cluster_dot_indicator_container_view_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.tabs.TabLayout
            android:enabled="false"
            android:layout_gravity="center"
            android:id="@+id/dotdotdot"
            android:background="@android:color/transparent"
            android:layout_width="@dimen/cluster_activity_indicator_view_width"
            android:layout_height="@dimen/cluster_activity_indicator_view_height"
            app:tabBackground="@drawable/dot_indicator"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabPaddingEnd="@dimen/cluster_dot_indicator_view_padding"
            app:tabPaddingStart="@dimen/cluster_dot_indicator_view_padding"/>
    </FrameLayout>
</android.support.constraint.ConstraintLayout>
