<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/gearhead_sdk_masked_ripple_background"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gearhead_sdk_list_item_height_small">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/icon_container"
        android:visibility="visible"
        android:layout_width="@dimen/gearhead_sdk_list_item_icon_size"
        android:layout_height="@dimen/gearhead_sdk_list_item_icon_size"
        android:layout_marginRight="40dp">
        <ImageView
            android:id="@+id/icon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:singleLine="true"
        android:layout_weight="1"
        style="@style/GearheadSdkBody1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:ellipsize="end"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="275dp"
            android:singleLine="true"
            style="@style/GearheadSdkCaption"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/right_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"/>
    </LinearLayout>
</LinearLayout>
