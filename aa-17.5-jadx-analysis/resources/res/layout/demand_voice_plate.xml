<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/demand_space_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/display_cutout_padding"
        android:background="?attr/gearheadAssistantPlateColor"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/third_party_logo_container"
        android:background="@color/demand_space_third_party_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/demand_space_third_party_header_height">
        <ImageView
            android:id="@+id/third_party_logo_icon"
            android:layout_width="@dimen/demand_space_3p_logo_width"
            android:layout_height="@dimen/demand_space_3p_logo_height"
            android:layout_margin="@dimen/demand_space_3p_logo_margin"/>
        <TextView
            android:gravity="center"
            android:id="@+id/third_party_logo_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/CommonCardBody2"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/demand_space_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <View
            android:id="@+id/backdrop"
            android:background="?attr/gearheadAssistantPlateColor"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/demand_space_content_elevation"/>
        <FrameLayout
            android:id="@+id/action_plate_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/demand_space_content_elevation"/>
        <com.google.android.libraries.gsa.logoview.LogoView
            android:layout_gravity="center_horizontal"
            android:id="@+id/logo_view"
            android:background="@drawable/demand_space_logo_background"
            android:focusable="true"
            android:layout_width="@dimen/demand_space_voice_plate_logo_width"
            android:layout_height="@dimen/demand_space_voice_plate_logo_height"
            android:elevation="@dimen/demand_space_content_elevation"/>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/hint_text"
            android:paddingTop="@dimen/demand_space_hint_padding_top"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/common_keyline_1"
            android:paddingEnd="@dimen/common_keyline_1"
            android:elevation="@dimen/demand_space_content_elevation"
            style="@style/GearheadSdkBody2"/>
        <ImageButton
            android:id="@+id/exit_button"
            android:background="@drawable/demand_space_button_background"
            android:padding="@dimen/demand_space_button_padding"
            android:visibility="gone"
            android:layout_width="@dimen/demand_space_button_width_height"
            android:layout_height="@dimen/demand_space_button_width_height"
            android:src="@drawable/ic_close"
            android:scaleType="fitCenter"
            android:tint="@color/gearhead_sdk_tint"
            android:elevation="@dimen/demand_space_content_elevation"/>
        <com.google.android.apps.auto.components.ui.image.MorphingCaretIconImageButton
            android:layout_gravity="end"
            android:id="@+id/caret_button"
            android:background="@drawable/demand_space_button_background"
            android:padding="@dimen/demand_space_button_padding"
            android:visibility="gone"
            android:layout_width="@dimen/demand_space_button_width_height"
            android:layout_height="@dimen/demand_space_button_width_height"
            android:src="@drawable/ic_morphing_caret"
            android:scaleType="fitCenter"
            android:tint="@color/gearhead_sdk_tint"
            android:elevation="@dimen/demand_space_content_elevation"/>
    </FrameLayout>
</LinearLayout>
