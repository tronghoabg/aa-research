<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:id="@+id/row_action_container"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/template_padding_1"
    android:paddingEnd="0dp">
    <LinearLayout
        android:layout_gravity="top"
        android:id="@+id/row_action_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/template_row_action_height"
        android:minWidth="@dimen/template_row_action_minimum_width"
        android:paddingStart="@dimen/template_padding_3"
        android:paddingEnd="@dimen/template_padding_3">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/row_action_button_icon"
            android:layout_width="?attr/templateRowActionIconSize"
            android:layout_height="?attr/templateRowActionIconSize"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24sp"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/row_action_button_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="66dp"
            android:maxLines="1"
            android:layout_marginStart="@dimen/template_padding_2"
            style="?attr/templateRowSecondaryActionTextStyle"/>
    </LinearLayout>
</LinearLayout>
