<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/illustration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/rating_prompt_enjoy"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <TextView
        android:textColor="@color/gearhead_sdk_grey_600"
        android:id="@+id/body_text"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rating_prompt_dialog_text_main"
        android:lineSpacingMultiplier="1.2"
        style="@style/TextAppearance.MediumTitle"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:textColor="@color/gearhead_sdk_light_blue_600"
            android:id="@+id/no_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minWidth="64dp"
            android:text="@string/rating_prompt_dialog_action_no"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            style="@android:style/Widget.Material.Button.Borderless"/>
        <Button
            android:textColor="@color/gearhead_sdk_light_blue_600"
            android:id="@+id/yes_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minWidth="64dp"
            android:text="@string/rating_prompt_dialog_action_yes"
            android:textAllCaps="true"
            android:layout_marginEnd="8dp"
            style="@android:style/Widget.Material.Button.Borderless"/>
    </LinearLayout>
</LinearLayout>
