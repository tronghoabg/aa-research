<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:background="?attr/carFrxBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="?attr/carFrxWelcomeColor"
            android:paddingTop="@dimen/car_frx_cakewalk_top_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/car_frx_small_icon_size"
                android:layout_height="@dimen/car_frx_small_icon_size"
                android:layout_marginBottom="@dimen/car_frx_app_icon_margin"
                style="@style/CarFrxAndroidAutoIconStyle"/>
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_frx_margin"
                android:layout_marginRight="@dimen/car_frx_margin"
                style="@style/TextAppearance.FrxTitle.Cakewalk.Phone"/>
            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/car_frx_app_icon_margin"
                style="@style/TextAppearance.FrxBody.Cakewalk.Phone"/>
            <ImageView
                android:id="@+id/illustration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/car_frx_margin"
                android:layout_marginTop="@dimen/car_frx_margin_big"
                android:layout_marginRight="@dimen/car_frx_margin"
                android:adjustViewBounds="true"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
