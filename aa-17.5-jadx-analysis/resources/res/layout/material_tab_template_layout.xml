<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/ThemeOverlay.Template.Tab.Material"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/templatePlainContentContainerStyle">
    <com.google.android.apps.auto.components.apphost.tab.MaterialTabHeaderView
        android:id="@+id/header_view"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="?attr/templateHeaderHeight"/>
    <FrameLayout
        android:id="@+id/content_container"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/progress_container"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="?attr/templateRowMinHeight">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
    </FrameLayout>
</LinearLayout>
