<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/permission_usage_car_prompt_id"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/gearhead_baseline_grid_5x"
    android:layout_marginEnd="@dimen/gearhead_baseline_grid_5x">
    <TextView
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Boardwalk.Body1"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_baseline_grid_1x"/>
    <TextView
        android:textColor="@color/boardwalk_gradient_white_72"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/explanation_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Boardwalk.Body3"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/gearhead_baseline_grid_6x"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/approve_button"
            android:background="@drawable/permission_button_colored_background"
            android:paddingLeft="@dimen/gearhead_baseline_grid_4x"
            android:paddingRight="@dimen/gearhead_baseline_grid_4x"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/gearhead_baseline_grid_7x"
            android:foreground="@drawable/permission_button_focus_ring"
            android:minWidth="@dimen/permission_button_min_width">
            <TextView
                android:textAppearance="@style/TextAppearance.Boardwalk.Body3.Medium"
                android:textColor="@color/boardwalk_white"
                android:layout_gravity="center"
                android:id="@+id/approve_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permission_usage_prompt_ok_button"
                android:maxLines="1"/>
        </FrameLayout>
        <Space
            android:layout_width="@dimen/gearhead_baseline_grid_4x"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/deny_button"
            android:background="@drawable/permission_button_bordered_nonfilled_background"
            android:paddingLeft="@dimen/gearhead_baseline_grid_4x"
            android:paddingRight="@dimen/gearhead_baseline_grid_4x"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/gearhead_baseline_grid_7x"
            android:foreground="@drawable/permission_button_focus_ring"
            android:minWidth="@dimen/permission_button_min_width">
            <TextView
                android:textAppearance="@style/TextAppearance.Boardwalk.Body3.Medium"
                android:textColor="@color/boardwalk_white"
                android:layout_gravity="center"
                android:id="@+id/deny_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permission_usage_prompt_not_now_button"
                android:maxLines="1"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
