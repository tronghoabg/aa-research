<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginTop="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="5dp"
        android:text="@string/car_setup_bottom_sheet_welcome_download_title"
        android:drawableTop="@drawable/android_auto_gm3_logo"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
    <TextView
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginTop="@dimen/dialog_marginTop"
        android:layout_marginRight="@dimen/bottom_sheet_parent_layout_margin"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
        android:text="@string/car_setup_bottom_sheet_welcome_download_body"
        android:drawablePadding="@dimen/bottom_sheet_logo_and_prompt_padding"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_layout_padding"
        android:scaleType="fitCenter"
        android:max="100"
        android:indeterminate="false"
        android:indeterminateOnly="false"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody2"
        android:gravity="center_horizontal"
        android:id="@+id/caption"
        android:paddingTop="@dimen/bottom_sheet_apps_layout_download_caption_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_apps_layout_caption_bottom_margin"
        android:text="@string/car_setup_starting_progress"/>
</LinearLayout>
