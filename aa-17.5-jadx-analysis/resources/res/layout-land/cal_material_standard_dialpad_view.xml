<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialStandardDialpadView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialpad_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:paddingBottom="@dimen/padding_p4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:paddingHorizontal="@dimen/padding_p5">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_gravity="top"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/material_standard_keypad_3x4"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:background="?attr/colorOutlineVariant"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:layout_marginHorizontal="@dimen/padding_p5"/>
        <com.google.android.apps.auto.sdk.ui.FocusClusterLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:requestFocusDescendantFocusability="afterDescendants">
            <RelativeLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/padding_p6"
                    android:layout_alignParentTop="true">
                    <include layout="@layout/material_standard_dialed_number_container"/>
                </FrameLayout>
                <com.google.android.apps.auto.components.apphost.basewidgets.action.ui.MaterialActionButtonView
                    android:layout_gravity="center"
                    android:id="@+id/call"
                    android:focusable="true"
                    android:clickable="true"
                    android:addStatesFromChildren="true"
                    android:layout_width="@dimen/material_dialpad_call_width"
                    android:layout_height="@dimen/material_dialpad_call_height"
                    android:layout_marginBottom="@dimen/padding_p4"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </com.google.android.apps.auto.sdk.ui.FocusClusterLayout>
    </LinearLayout>
</com.google.android.apps.auto.components.apphost.telecom.dialpad.MaterialStandardDialpadView>
