<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/menu_action_developer_settings"
        android:key="action_developer_settings">
        <CheckBoxPreference
            android:title="@string/settings_connection_wireless_title"
            android:key="enable_wireless_projection"/>
        <Preference
            android:title="@string/app_quality_tester"
            android:key="app_quality_tester"/>
        <ListPreference
            android:entries="@array/car_app_mode_labels"
            android:title="@string/car_app_mode"
            android:key="car_app_mode"
            android:summary="%s"
            android:dialogTitle="@string/car_app_mode"/>
        <Preference
            android:title="@string/car_share_screenshot"
            android:key="car_share_screenshot"/>
        <CheckBoxPreference
            android:title="@string/car_save_video"
            android:key="car_save_video"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_dump_screenshot"
            android:key="car_dump_screenshot"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_save_audio"
            android:key="car_save_audio"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_save_mic"
            android:key="car_save_mic"
            android:defaultValue="false"/>
        <ListPreference
            android:entries="@array/car_audio_codec_labels"
            android:title="@string/car_audio_codec"
            android:key="car_audio_codec"
            android:summary="%s"
            android:dialogTitle="@string/car_audio_codec"/>
        <Preference
            android:title="@string/developer_settings_clear_all_data"
            android:key="car_clear_data"/>
        <Preference
            android:title="@string/reset_usb_port"
            android:key="reset_usb_port"/>
        <Preference
            android:title="@string/reset_usb_gadget"
            android:key="reset_usb_gadget"/>
        <Preference
            android:title="@string/reset_usb_roles"
            android:key="reset_usb_roles"/>
        <Preference
            android:title="@string/reset_usb_function"
            android:key="reset_usb_function"/>
        <CheckBoxPreference
            android:title="@string/car_force_logging"
            android:key="car_force_logging"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_collect_gps_data"
            android:key="car_collect_gps_data"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_disable_anr_monitoring"
            android:key="car_disable_anr_monitoring"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_enable_audio_latency_dump"
            android:key="car_enable_audio_latency_dump"
            android:defaultValue="false"/>
        <ListPreference
            android:entries="@array/car_video_resolution_labels"
            android:title="@string/car_video_resolution"
            android:key="car_video_resolution"
            android:summary="%s"
            android:dialogTitle="@string/car_video_resolution"/>
        <CheckBoxPreference
            android:title="@string/allow_unknown_sources"
            android:key="allow_unknown_sources"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/debug_overlay_enabled"
            android:key="debug_overlay_enabled"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/input_config_enabled"
            android:key="input_config_enabled"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_enable_gal_snoop"
            android:key="car_enable_gal_snoop"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/car_failure_injection_enabled"
            android:key="failure_injection_enabled"
            android:defaultValue="false"/>
        <Preference
            android:title="@string/clear_tos"
            android:key="clear_tos"/>
        <CheckBoxPreference
            android:title="@string/cal_beta_features_enabled"
            android:key="cal_beta_features_enabled"
            android:defaultValue="false"/>
        <PreferenceScreen
            android:title="@string/car_gal_snoop_options"
            android:key="car_gal_snoop_options">
            <EditTextPreference
                android:singleLine="true"
                android:digits="0123456789"
                android:title="@string/car_gal_snoop_buffer_size"
                android:key="car_gal_snoop_buffer_size"
                android:defaultValue="100"
                android:inputType="numberDecimal"/>
            <CheckBoxPreference
                android:title="@string/car_gal_snoop_log_video_ack"
                android:key="car_gal_snoop_log_video_ack"
                android:defaultValue="false"/>
            <CheckBoxPreference
                android:title="@string/car_gal_snoop_log_media_ack"
                android:key="car_gal_snoop_log_media_ack"
                android:defaultValue="false"/>
            <CheckBoxPreference
                android:title="@string/car_gal_snoop_log_guidance_ack"
                android:key="car_gal_snoop_log_guidance_ack"
                android:defaultValue="false"/>
        </PreferenceScreen>
        <PreferenceScreen
            android:title="@string/car_touchpad_tuning"
            android:key="touchpad_tuning">
            <SeekBarPreference
                android:max="10"
                android:title="@string/car_touchpad_base_fraction"
                android:key="touchpad_base_fraction"
                android:defaultValue="6"
                android:min="1"/>
            <SeekBarPreference
                android:max="15"
                android:title="@string/car_touchpad_min_size_mm"
                android:key="touchpad_min_size_mm"
                android:defaultValue="4"
                android:min="0"/>
            <SeekBarPreference
                android:max="15"
                android:title="@string/car_touchpad_multimove_penalty_mm"
                android:key="touchpad_multimove_penalty_mm"
                android:defaultValue="4"
                android:min="0"/>
        </PreferenceScreen>
    </PreferenceCategory>
</PreferenceScreen>
