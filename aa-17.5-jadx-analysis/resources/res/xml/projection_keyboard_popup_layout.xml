<?xml version="1.0" encoding="utf-8"?>
<Keyboard
    keyHeight="@dimen/projection_keyboard_key_height"
    keyHorizontalMargin="@dimen/projection_keyboard_key_horizontal_margin"
    keyVerticalMargin="@dimen/projection_keyboard_key_vertical_margin"
    keyWidth="@dimen/projection_keyboard_key_width">
    <Row>
        <Key
            codes="@integer/keycode_close_popup_keyboard"
            id="@+id/key_close_popup"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_arrow_back"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_1"
            keySpan="@integer/projection_keyboard_popup_key_span_9"/>
        <Key
            codes="@integer/keycode_external_keyboard"
            id="@+id/key_external"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_external"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_2"
            keySpan="@integer/projection_keyboard_popup_key_span_2"
            keyWidth="@dimen/projection_keyboard_popup_double_empty_key_width"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_1"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_2"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_3"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_4"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_5"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_6"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_3"
            keySpan="@integer/projection_keyboard_popup_key_span_3"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_4"
            keySpan="@integer/projection_keyboard_popup_key_span_2"
            keyWidth="@dimen/projection_keyboard_popup_double_empty_key_width"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_7"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_8"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_9"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_10"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_11"/>
        <Key
            codes="@integer/keycode_populate_replacement_key"
            id="@+id/key_popup_12"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_5"
            keySpan="@integer/projection_keyboard_popup_key_span_2"
            keyWidth="@dimen/projection_keyboard_popup_double_empty_key_width"/>
        <Key
            codes="@integer/keycode_mode_change"
            id="@+id/key_globe"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_globe"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_shift"
            id="@+id/key_shift"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_shift"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_6"
            keySpan="@integer/projection_keyboard_popup_key_span_9"/>
        <Key
            codes="@integer/keycode_delete"
            id="@+id/key_backspace"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_backspace"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_hide_keyboard"
            id="@+id/key_close"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_hide"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_7"
            keySpan="@integer/projection_keyboard_popup_key_span_2"
            keyWidth="@dimen/projection_keyboard_popup_double_empty_key_width"/>
        <Key
            codes="@integer/keycode_space"
            id="@+id/key_space"
            keyBackground="@drawable/gearhead_key_spacebar_focus_background"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_spacebar"
            keySpan="@integer/projection_keyboard_spacebar_span"
            keyWidth="@dimen/projection_keyboard_spacebar_width"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_8"
            keySpan="@integer/projection_keyboard_popup_key_span_2"
            keyWidth="@dimen/projection_keyboard_popup_double_empty_key_width"/>
        <Key
            codes="@integer/keycode_done"
            id="@+id/key_search"/>
    </Row>
</Keyboard>
