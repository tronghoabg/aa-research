<?xml version="1.0" encoding="utf-8"?>
<Keyboard
    keyHeight="@dimen/projection_keyboard_key_height"
    keyHorizontalMargin="@dimen/projection_keyboard_key_horizontal_margin"
    keySpan="@integer/projection_keyboard_staggered_key_span"
    keyVerticalMargin="@dimen/projection_keyboard_key_vertical_margin"
    keyWidth="@dimen/projection_keyboard_key_width">
    <Row>
        <Key
            id="@+id/key_1"
            keyLabel="1"/>
        <Key
            id="@+id/key_2"
            keyLabel="2"/>
        <Key
            id="@+id/key_3"
            keyLabel="3"/>
        <Key
            id="@+id/key_4"
            keyLabel="4"/>
        <Key
            id="@+id/key_5"
            keyLabel="5"/>
        <Key
            id="@+id/key_6"
            keyLabel="6"/>
        <Key
            id="@+id/key_7"
            keyLabel="7"/>
        <Key
            id="@+id/key_8"
            keyLabel="8"/>
        <Key
            id="@+id/key_9"
            keyLabel="9"/>
        <Key
            id="@+id/key_0"
            keyLabel="0"/>
        <Key
            codes="@integer/keycode_external_keyboard"
            id="@+id/key_external"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_external"/>
    </Row>
    <Row>
        <Key
            id="@+id/key_q"
            keyLabel="q"/>
        <Key
            id="@+id/key_w"
            keyLabel="w"/>
        <Key
            id="@+id/key_e"
            keyLabel="e"
            keyPopupCharacters="@string/alternates_for_e"/>
        <Key
            id="@+id/key_r"
            keyLabel="r"/>
        <Key
            id="@+id/key_t"
            keyLabel="t"/>
        <Key
            id="@+id/key_y"
            keyLabel="y"
            keyPopupCharacters="@string/alternates_for_y"/>
        <Key
            id="@+id/key_u"
            keyLabel="u"
            keyPopupCharacters="@string/alternates_for_u"/>
        <Key
            id="@+id/key_i"
            keyLabel="i"
            keyPopupCharacters="@string/alternates_for_i"/>
        <Key
            id="@+id/key_o"
            keyLabel="o"
            keyPopupCharacters="@string/alternates_for_o"/>
        <Key
            id="@+id/key_p"
            keyLabel="p"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_1"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_2"
            keySpan="@integer/projection_keyboard_default_key_span"
            keyWidth="@dimen/projection_keyboard_half_key_width"/>
        <Key
            id="@+id/key_a"
            keyLabel="a"
            keyPopupCharacters="@string/alternates_for_a"/>
        <Key
            id="@+id/key_s"
            keyLabel="s"
            keyPopupCharacters="@string/alternates_for_s"/>
        <Key
            id="@+id/key_d"
            keyLabel="d"/>
        <Key
            id="@+id/key_f"
            keyLabel="f"/>
        <Key
            id="@+id/key_g"
            keyLabel="g"/>
        <Key
            id="@+id/key_h"
            keyLabel="h"/>
        <Key
            id="@+id/key_j"
            keyLabel="j"/>
        <Key
            id="@+id/key_k"
            keyLabel="k"/>
        <Key
            id="@+id/key_l"
            keyLabel="l"
            keyPopupCharacters="@string/alternates_for_l"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_3"
            keySpan="@integer/projection_keyboard_default_key_span"
            keyWidth="@dimen/projection_keyboard_half_key_width"/>
        <Key
            codes="@integer/keycode_mode_change"
            id="@+id/key_globe"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_globe"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_shift"
            id="@+id/key_shift"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_shift"/>
        <Key
            id="@+id/key_z"
            keyLabel="z"
            keyPopupCharacters="@string/alternates_for_z"/>
        <Key
            id="@+id/key_x"
            keyLabel="x"/>
        <Key
            id="@+id/key_c"
            keyLabel="c"
            keyPopupCharacters="@string/alternates_for_c"/>
        <Key
            id="@+id/key_v"
            keyLabel="v"/>
        <Key
            id="@+id/key_b"
            keyLabel="b"/>
        <Key
            id="@+id/key_n"
            keyLabel="n"
            keyPopupCharacters="@string/alternates_for_n"/>
        <Key
            id="@+id/key_m"
            keyLabel="m"/>
        <Key
            id="@+id/key_exclamation"
            keyLabel="!"/>
        <Key
            id="@+id/key_question_mark"
            keyLabel="?"/>
        <Key
            codes="@integer/keycode_delete"
            id="@+id/key_backspace"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_backspace"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_hide_keyboard"
            id="@+id/key_close"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_hide"/>
        <Key
            codes="@integer/keycode_symbols_switch"
            id="@+id/key_symbols"
            keyLabel="=&lt;"/>
        <Key
            id="@+id/key_comma"
            keyLabel=","/>
        <Key
            codes="@integer/keycode_space"
            id="@+id/key_space"
            keyBackground="@drawable/gearhead_key_spacebar_focus_background"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_spacebar"
            keySpan="@integer/projection_keyboard_staggered_spacebar_span"
            keyWidth="@dimen/projection_keyboard_spacebar_width"/>
        <Key
            id="@+id/key_period"
            keyLabel="."/>
        <Key
            id="@+id/key_dash"
            keyLabel="-"/>
        <Key
            codes="@integer/keycode_done"
            id="@+id/key_search"/>
    </Row>
</Keyboard>
