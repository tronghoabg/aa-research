<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.projection.gearhead.companion.settings.Material3MorrisAnnouncePreference
        android:id="@+id/morris_announce"
        android:key="morris_announce_key"
        app:singleLineTitle="false"/>
    <Preference
        android:title="@string/generate_bug_report"
        android:key="key_generate_bug_report"
        app:iconSpaceReserved="false"/>
    <PreferenceCategory
        android:title="@string/settings_connection_settings_title"
        android:key="key_settings_connection_category"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <Preference
            android:layout="@layout/material3_preference_text_only"
            android:title="@string/settings_connection_car_title_no_connection"
            android:key="key_settings_connection_car"
            app:isPreferenceVisible="false"
            app:singleLineTitle="false"/>
        <com.google.android.projection.gearhead.companion.settings.Material3CarPreferenceButton
            android:key="key_settings_connection_connect_a_car"
            app:buttonText="@string/settings_connection_connect_a_car_button"
            app:singleLineTitle="false"/>
        <Preference
            android:title="@string/settings_connection_previously_connected_cars_title"
            android:key="key_settings_connection_cars"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_connection_wireless_title"
            android:key="key_settings_connection_wireless_enable"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_wireless_projection_enable"
            android:key="key_settings_wireless_projection_enable"
            android:summary="@string/settings_wireless_projection_enable_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <Preference
            android:title="@string/settings_connection_help_title"
            android:key="key_settings_connection_help"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:enabled="false"
            android:title="@string/settings_connection_enable_troubleshooter_feedback_title"
            android:key="key_settings_connection_enable_troubleshooter_feedback"
            android:summary="@string/settings_connection_enable_troubleshooter_feedback_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_startup_settings_title"
        android:key="key_settings_startup_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <ListPreference
            android:persistent="false"
            android:entries="@array/settings_initial_focus_mode_labels"
            android:id="@+id/settings_initial_focus_mode_preference"
            android:title="@string/settings_initial_focus_title"
            android:key="key_settings_initial_focus_mode"
            android:summary="%s"
            android:shouldDisableView="true"
            android:dialogTitle="@string/settings_initial_focus_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <com.google.android.projection.gearhead.companion.settings.Material3StartWhileLockedPreference
            android:title="@string/settings_connection_allowed_while_locked_title"
            android:key="key_settings_allow_connection_while_locked"
            android:summary="@string/settings_connection_allowed_while_locked_description"
            android:defaultValue="@bool/settings_allow_connection_while_locked_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_legacy_autoplay_media_title"
            android:key="key_settings_autoplay_media"
            android:summary="@string/settings_legacy_autoplay_media_description"
            android:defaultValue="@bool/settings_legacy_autoplay_media_default"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_display_settings_title"
        android:key="key_settings_display_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <Preference
            android:title="@string/settings_customize_app_launcher_title"
            android:key="key_settings_customize_app_launcher"
            android:summary="@string/settings_customize_app_launcher_description"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <Preference
            android:persistent="false"
            android:title=""
            android:key="key_settings_customize_earth"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <EditTextPreference
            android:persistent="false"
            android:title=""
            android:key="key_settings_native_app_dpi"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_show_rail_widget"
            android:key="key_settings_show_rail_widget"
            android:summary="@string/settings_show_rail_widget_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_assistant_settings_title"
        android:key="key_settings_assistant_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <Preference
            android:title="@string/settings_hotword_title"
            android:key="key_settings_hotword"
            android:summary="@string/settings_hotword_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <Preference
            android:title="@string/settings_assistant_title"
            android:key="key_settings_assistant"
            android:summary="@string/settings_assistant_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_gemini_share_precise_location_title"
            android:key="key_settings_gemini_share_precise_location"
            android:summary="@string/settings_gemini_share_precise_location_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_maps_settings_title"
        android:key="key_settings_maps_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <ListPreference
            android:persistent="false"
            android:entries="@array/settings_day_night_mode_labels"
            android:id="@+id/settings_day_night_mode_preference"
            android:title="@string/settings_day_night_mode_title"
            android:key="key_settings_day_night_mode"
            android:summary="%s"
            android:shouldDisableView="true"
            android:dialogTitle="@string/settings_day_night_mode_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_messaging_title"
        android:key="key_settings_notifications_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_notifications_title"
            android:key="key_settings_messaging_notifications_enabled"
            android:defaultValue="@bool/settings_messaging_notifications_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_group_notifications_title"
            android:key="key_settings_messaging_group_notifications"
            android:defaultValue="@bool/settings_messaging_group_notifications_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_text_preview_title"
            android:key="key_settings_messaging_visual_preview_enabled"
            android:defaultValue="@bool/settings_messaging_visual_preview_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_autoplay_title"
            android:key="key_settings_autoplay_messages"
            android:defaultValue="@bool/settings_autoplay_messages_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_notification_sound_title"
            android:key="key_settings_no_notification_sound"
            android:defaultValue="@bool/settings_no_notification_sound_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_notification_sound_title"
            android:key="key_settings_notification_chime_enabled"
            android:defaultValue="@bool/settings_notification_chime_enable_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_messaging_summarization_title"
            android:key="key_settings_show_message_summarization"
            android:summary="@string/settings_messaging_summarization_summary"
            android:defaultValue="@bool/settings_show_message_summarization_default"
            android:singleLineTitle="false"
            app:iconSpaceReserved="false"/>
        <SwitchPreferenceCompat
            android:id="@+id/settings_messaging_allow_notification_data_sharing_agsa_preference"
            android:title="@string/settings_messaging_allow_notification_data_sharing_agsa_title"
            android:key="key_settings_messaging_allow_notification_data_sharing_agsa"
            android:summary="@string/settings_messaging_notification_data_sharing_summary"
            android:defaultValue="@bool/settings_messaging_allow_notification_data_sharing_agsa_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_advanced_settings_title"
        android:key="key_settings_advanced_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <ListPreference
            android:persistent="false"
            android:entries="@array/settings_edit_driver_position_labels"
            android:id="@+id/settings_edit_driver_position_preference"
            android:title="@string/settings_edit_driver_position_title"
            android:key="key_settings_driver_position"
            android:summary="%s"
            android:shouldDisableView="true"
            android:dialogTitle="@string/settings_edit_driver_position_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <ListPreference
            android:persistent="false"
            android:entries="@array/settings_dashboard_alignment_labels"
            android:id="@+id/settings_edit_dashboard_alignment_preference"
            android:title="@string/settings_driver_aligned_dashboard"
            android:key="key_settings_driver_aligned_dashboard"
            android:summary="%s"
            android:shouldDisableView="true"
            android:dialogTitle="@string/settings_driver_aligned_dashboard"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_work_profile_support_title"
            android:key="key_work_profile_support"
            android:summary="@string/settings_work_profile_support_description"
            android:defaultValue="@bool/settings_work_profile_support_default"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_about_category_title"
        android:key="key_settings_about_category"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">
        <Preference
            android:title="@string/settings_privacy_policy_title"
            android:key="key_settings_privacy_policy"
            android:summary="@string/settings_privacy_policy_description"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <Preference
            android:title="@string/settings_legal_title"
            android:key="key_settings_legal"
            android:summary="@string/settings_legal_description"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
        <com.google.android.projection.gearhead.companion.settings.Material3VersionPreference
            android:title="@string/settings_about_version"
            android:key="key_settings_version"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"/>
    </PreferenceCategory>
</PreferenceScreen>
