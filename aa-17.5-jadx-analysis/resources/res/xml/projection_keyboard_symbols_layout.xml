<?xml version="1.0" encoding="utf-8"?>
<Keyboard
    keyHeight="@dimen/projection_keyboard_key_height"
    keyHorizontalMargin="@dimen/projection_keyboard_key_horizontal_margin"
    keyVerticalMargin="@dimen/projection_keyboard_key_vertical_margin"
    keyWidth="@dimen/projection_keyboard_key_width">
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_1"/>
        <Key
            id="@+id/key_symbol_1"
            keyLabel="@"/>
        <Key
            id="@+id/key_symbol_2"
            keyLabel="#"/>
        <Key
            id="@+id/key_symbol_3"
            keyLabel="$"/>
        <Key
            id="@+id/key_symbol_4"
            keyLabel="_"/>
        <Key
            id="@+id/key_symbol_5"
            keyLabel="&amp;"/>
        <Key
            id="@+id/key_symbol_6"
            keyLabel="-"/>
        <Key
            id="@+id/key_symbol_7"
            keyLabel="+"/>
        <Key
            id="@+id/key_symbol_8"
            keyLabel="/"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_2"/>
        <Key
            codes="@integer/keycode_external_keyboard"
            id="@+id/key_external"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_external"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_3"/>
        <Key
            id="@+id/key_symbol_9"
            keyLabel="("/>
        <Key
            id="@+id/key_symbol_10"
            keyLabel=")"/>
        <Key
            id="@+id/key_symbol_11"
            keyLabel="*"/>
        <Key
            id="@+id/key_symbol_12"
            keyLabel="&quot;"/>
        <Key
            id="@+id/key_symbol_13"
            keyLabel="&apos;"/>
        <Key
            id="@+id/key_symbol_14"
            keyLabel=":"/>
        <Key
            id="@+id/key_symbol_15"
            keyLabel=";"/>
        <Key
            id="@+id/key_symbol_16"
            keyLabel="!"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_4"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_5"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_6"/>
        <Key
            id="@+id/key_symbol_17"
            keyLabel="?"/>
        <Key
            id="@+id/key_symbol_18"
            keyLabel="~"/>
        <Key
            id="@+id/key_symbol_19"
            keyLabel="`"/>
        <Key
            id="@+id/key_symbol_20"
            keyLabel="|"/>
        <Key
            id="@+id/key_symbol_21"
            keyLabel="^"/>
        <Key
            id="@+id/key_symbol_22"
            keyLabel="="/>
        <Key
            id="@+id/key_symbol_23"
            keyLabel="{"/>
        <Key
            id="@+id/key_symbol_24"
            keyLabel="}"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_7"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_8"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_9"/>
        <Key
            codes="@integer/keycode_backslash"
            id="@+id/key_symbol_25"
            keyLabel=""/>
        <Key
            id="@+id/key_symbol_26"
            keyLabel="%"/>
        <Key
            id="@+id/key_symbol_27"
            keyLabel="["/>
        <Key
            id="@+id/key_symbol_28"
            keyLabel="]"/>
        <Key
            id="@+id/key_symbol_29"
            keyLabel="£"/>
        <Key
            id="@+id/key_symbol_30"
            keyLabel="¥"/>
        <Key
            id="@+id/key_symbol_31"
            keyLabel="¢"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_10"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_11"/>
        <Key
            codes="@integer/keycode_delete"
            id="@+id/key_backspace"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_backspace"/>
    </Row>
    <Row>
        <Key
            codes="@integer/keycode_hide_keyboard"
            id="@+id/key_close"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_hide"/>
        <Key
            codes="@integer/keycode_symbols_switch"
            id="@+id/key_alpha"
            keyLabel="ABC"/>
        <Key
            id="@+id/key_less_than"
            keyLabel="&lt;"/>
        <Key
            codes="@integer/keycode_space"
            id="@+id/key_space"
            keyBackground="@drawable/gearhead_key_spacebar_focus_background"
            keyIcon="@drawable/ic_gearhead_projection_keyboard_spacebar"
            keySpan="@integer/projection_keyboard_spacebar_span"
            keyWidth="@dimen/projection_keyboard_spacebar_width"/>
        <Key
            id="@+id/key_greater_than"
            keyLabel="&gt;"/>
        <Key
            codes="@integer/keycode_non_focusable_empty_key"
            id="@+id/key_no_key_12"/>
        <Key
            codes="@integer/keycode_done"
            id="@+id/key_search"/>
    </Row>
</Keyboard>
