<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:interpolator="@android:interpolator/linear_out_slow_in"
        android:duration="@integer/notification_close_button_animation_scale_duration"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="@integer/notification_close_button_animation_start_delay"
        android:fromXScale="0.6"
        android:toXScale="1"
        android:fromYScale="0.6"
        android:toYScale="1"/>
    <rotate
        android:interpolator="@android:interpolator/linear_out_slow_in"
        android:duration="@integer/notification_close_button_animation_rotate_duration"
        android:fromDegrees="-45"
        android:toDegrees="0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="@integer/notification_close_button_animation_start_delay"/>
</set>
