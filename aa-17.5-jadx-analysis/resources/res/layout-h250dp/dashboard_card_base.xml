<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.auto.components.coolwalk.card.CoolwalkCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dash_card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/dash_card_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.constraint.Guideline
            android:orientation="horizontal"
            android:id="@+id/dashboard_card_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/dashboard_card_padding"/>
        <android.support.constraint.Guideline
            android:orientation="vertical"
            android:id="@+id/dashboard_card_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/dashboard_card_padding"/>
        <android.support.constraint.Guideline
            android:orientation="vertical"
            android:id="@+id/dashboard_card_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/dashboard_card_padding"/>
        <android.support.constraint.Guideline
            android:orientation="horizontal"
            android:id="@+id/dashboard_card_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/dashboard_card_padding"/>
        <Space
            android:id="@+id/icon_placement"
            android:layout_width="@dimen/dashboard_card_icon_size"
            android:layout_height="@dimen/dashboard_card_icon_size"
            app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
            app:layout_constraintTop_toTopOf="@+id/dashboard_card_top"/>
        <Space
            android:id="@+id/badge_spacer"
            android:layout_width="@dimen/dashboard_card_badge_offset"
            android:layout_height="@dimen/dashboard_card_badge_offset"
            app:layout_constraintStart_toEndOf="@+id/icon_placement"
            app:layout_constraintTop_toBottomOf="@+id/icon_placement"/>
        <Space
            android:id="@+id/badge_placement"
            android:layout_width="@dimen/dashboard_card_badge_size"
            android:layout_height="@dimen/dashboard_card_badge_size"
            app:layout_constraintBottom_toBottomOf="@+id/badge_spacer"
            app:layout_constraintEnd_toEndOf="@+id/badge_spacer"
            style="@style/Widget.Dashboard.Badge"/>
        <Space
            android:id="@+id/round_icon_badge_placement"
            android:layout_width="@dimen/dashboard_card_badge_size"
            android:layout_height="@dimen/dashboard_card_badge_size"
            app:layout_constraintBottom_toTopOf="@+id/badge_spacer"
            app:layout_constraintEnd_toStartOf="@+id/badge_spacer"
            style="@style/Widget.Dashboard.Badge"/>
        <Space
            android:id="@+id/text_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dashboard_card_title_margin_start"
            app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
            app:layout_constraintStart_toStartOf="@+id/dashboard_card_start"
            app:layout_constraintTop_toBottomOf="@+id/icon_placement"/>
        <com.google.android.apps.auto.components.ui.text.CountIndicatorTextView
            android:textSize="@dimen/boardwalk_body3_text_size"
            android:textColor="@color/boardwalk_white"
            android:gravity="center"
            android:id="@+id/item_count"
            android:background="@drawable/message_count_background"
            android:paddingLeft="@dimen/metadata_new_icon_numbered_padding"
            android:paddingRight="@dimen/metadata_new_icon_numbered_padding"
            android:visibility="gone"
            android:layout_width="@dimen/count_indicator_view_single_digit_width"
            android:layout_height="@dimen/count_indicator_view_height"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="?attr/bodyFontFamily"
            android:layout_marginStart="@dimen/gearhead_baseline_grid_2x"
            android:layout_marginEnd="@dimen/gearhead_baseline_grid_2x"
            app:layout_constraintEnd_toStartOf="@+id/close_button"
            app:layout_constraintTop_toTopOf="@+id/dashboard_card_top"/>
        <com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dashboard_card_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dashboard_card_top">
            <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
                android:id="@+id/close_button_inner"
                android:visibility="gone"
                android:layout_width="@dimen/gearhead_baseline_grid_8x"
                android:layout_height="@dimen/gearhead_baseline_grid_8x"
                app:icon="@drawable/ic_close"
                style="@style/Widget.Dashboard.Button.Close"/>
        </com.google.android.apps.auto.components.coolwalk.focusring.FocusInterceptor>
    </android.support.constraint.ConstraintLayout>
</com.google.android.apps.auto.components.coolwalk.card.CoolwalkCardView>
