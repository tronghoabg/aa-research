<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:color="?attr/colorOnSurface"
        android:alpha="@dimen/material_switch_thumb_tint_disabled_unchecked_opacity"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:color="?attr/colorSurface"
        android:alpha="@dimen/material_switch_thumb_tint_disabled_checked_opacity"/>
    <item
        android:state_checked="true"
        android:state_pressed="true"
        android:color="?attr/colorPrimaryContainer"/>
    <item
        android:state_checked="true"
        android:color="?attr/colorOnPrimary"/>
    <item
        android:state_pressed="true"
        android:color="?attr/colorOnSurfaceVariant"/>
    <item android:color="?attr/colorOnSurfaceVariant"/>
</selector>
