<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CompanionAppSettingsTheme" parent="@style/Theme.GoogleMaterial.Light.Bridge">
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
    </style>
    <style name="M3Style" parent="">
        <item name="android:background">@android:color/system_neutral1_900</item>
        <item name="contentScrim">@android:color/system_neutral1_800</item>
    </style>
    <style name="Theme.Gearhead.Settings.AlertDialog" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@android:color/system_neutral1_900</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.GoogleMaterial3</item>
        <item name="dialogCornerRadius">@dimen/gearhead_material3_rounded_corner_radius</item>
    </style>
    <style name="ThemeOverlay.Gearhead.M3.Settings" parent="@style/ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
    </style>
    <style name="ThemeOverlay.PhoneKeyboard.DynamicColors.DayNight" parent="@style/ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
    </style>
    <style name="Widget.PhoneKeyboard.SearchView" parent="@style/Widget.Material3.SearchView">
        <item name="backgroundTint">@android:color/system_neutral1_900</item>
    </style>
</resources>
