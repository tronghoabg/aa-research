<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/connect_car_fragment">
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.ConnectCarFragment"
        android:id="@+id/connect_car_fragment">
        <action
            android:id="@+id/action_connectCarFragment_to_chargeOnlyFragment"
            app:destination="@+id/charge_only_fragment"/>
    </fragment>
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.ChargeOnlyFragment"
        android:id="@+id/charge_only_fragment">
        <action
            android:id="@+id/action_chargeOnlyFragment_to_projectionFragment"
            app:destination="@+id/projection_fragment"/>
        <action
            android:id="@+id/action_chargeOnlyFragment_to_errorPageFragment"
            app:destination="@+id/error_page_fragment"/>
    </fragment>
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.ProjectionFragment"
        android:id="@+id/projection_fragment">
        <action
            android:id="@+id/action_projectionFragment_to_disableAdbFragment"
            app:destination="@+id/disable_adb_fragment"/>
        <action
            android:id="@+id/action_projectionFragment_to_projectionEstablishedFragment"
            app:destination="@+id/projection_established_fragment"/>
    </fragment>
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.DisableAdbFragment"
        android:id="@+id/disable_adb_fragment">
        <action
            android:id="@+id/action_disableAdbFragment_to_usbConfigFragment"
            app:destination="@+id/usb_config_fragment"/>
        <action
            android:id="@+id/action_disableAdbFragment_to_projectionEstablishedFragment"
            app:destination="@+id/projection_established_fragment"/>
    </fragment>
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.UsbConfigFragment"
        android:id="@+id/usb_config_fragment">
        <action
            android:id="@+id/action_usbConfigFragment_to_projectionEstablishedFragment"
            app:destination="@+id/projection_established_fragment"/>
        <action
            android:id="@+id/action_usbConfigFragment_to_errorPageFragment"
            app:destination="@+id/error_page_fragment"/>
    </fragment>
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.ProjectionEstablishedFragment"
        android:id="@+id/projection_established_fragment"/>
    <fragment
        android:label="name"
        android:name="com.google.android.apps.auto.components.settings.interactivetroubleshooter.ErrorPageFragment"
        android:id="@+id/error_page_fragment">
        <action
            android:id="@+id/action_errorPageFragment_to_connectCarFragment"
            app:destination="@+id/connect_car_fragment"/>
    </fragment>
</navigation>
