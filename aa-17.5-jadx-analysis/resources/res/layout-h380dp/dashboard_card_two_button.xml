<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/action_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:divider="@drawable/dashboard_divider_padding_3"
        android:showDividers="middle"
        app:layout_constraintBottom_toBottomOf="@+id/dashboard_card_bottom"
        app:layout_constraintEnd_toEndOf="@+id/dashboard_card_end"
        app:layout_constraintStart_toStartOf="@+id/dashboard_card_start">
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/action_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gearhead_baseline_grid_8x"/>
        <com.google.android.apps.auto.components.coolwalk.button.CoolwalkButton
            android:id="@+id/action_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gearhead_baseline_grid_8x"/>
    </LinearLayout>
</merge>
