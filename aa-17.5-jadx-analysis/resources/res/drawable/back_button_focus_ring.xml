<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="@dimen/template_back_focus_ring_inset">
    <selector>
        <item
            android:state_window_focused="true"
            android:state_hovered="true">
            <shape android:shape="oval">
                <stroke
                    android:width="?attr/templateFocusStrokeWidthHovered"
                    android:color="?attr/templateFocusAccentColor"/>
            </shape>
        </item>
        <item
            android:state_focused="true"
            android:state_window_focused="true">
            <shape android:shape="oval">
                <stroke
                    android:width="?attr/templateFocusStrokeWidthFocused"
                    android:color="?attr/templateFocusAccentColor"/>
            </shape>
        </item>
    </selector>
</inset>
