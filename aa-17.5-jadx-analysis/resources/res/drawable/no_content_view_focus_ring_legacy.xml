<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="@dimen/template_no_content_view_focus_ring_padding">
    <selector>
        <item
            android:state_window_focused="true"
            android:state_hovered="true">
            <shape android:shape="rectangle">
                <stroke
                    android:width="?attr/templateFocusStrokeWidthHovered"
                    android:color="?attr/templateFocusNoContentAccentColor"/>
                <corners android:radius="?attr/templateNoContentFocusCornerRadius"/>
            </shape>
        </item>
        <item
            android:state_focused="true"
            android:state_window_focused="true">
            <shape android:shape="rectangle">
                <stroke
                    android:width="?attr/templateFocusStrokeWidthFocused"
                    android:color="?attr/templateFocusNoContentAccentColor"/>
                <corners android:radius="?attr/templateNoContentFocusCornerRadius"/>
            </shape>
        </item>
    </selector>
</inset>
