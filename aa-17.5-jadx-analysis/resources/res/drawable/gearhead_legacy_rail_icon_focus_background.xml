<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/gearhead_legacy_facet_bar_icon_focus_lr_inset"
    android:insetRight="@dimen/gearhead_legacy_facet_bar_icon_focus_lr_inset">
    <ripple android:color="@color/gearhead_sdk_controller_ripple">
        <item
            android:gravity="center"
            android:id="@android:id/mask">
            <inset android:inset="@dimen/gearhead_focus_oval_ripple_inset">
                <shape android:shape="oval">
                    <solid android:color="@color/gearhead_controller_ripple_color_selector"/>
                </shape>
            </inset>
        </item>
        <item>
            <inset android:inset="@dimen/gearhead_rail_button_focus_inset">
                <selector>
                    <item
                        android:state_window_focused="true"
                        android:state_selected="true"
                        android:state_hovered="true">
                        <inset
                            android:drawable="@drawable/gearhead_ic_rail_focus_background_selected_hovered"
                            android:inset="@dimen/gearhead_focus_ring_stroke_width_negative_offset"/>
                    </item>
                    <item
                        android:state_focused="true"
                        android:state_window_focused="true"
                        android:state_selected="true"
                        android:drawable="@drawable/gearhead_ic_rail_focus_background_selected_focused"/>
                    <item
                        android:state_selected="false"
                        android:state_hovered="true">
                        <inset
                            android:drawable="@drawable/gearhead_ic_rail_focus_background_hovered"
                            android:inset="@dimen/gearhead_focus_ring_stroke_width_negative_offset"/>
                    </item>
                    <item
                        android:state_focused="true"
                        android:state_window_focused="true"
                        android:state_selected="false"
                        android:drawable="@drawable/gearhead_ic_rail_focus_background_focused"/>
                </selector>
            </inset>
        </item>
    </ripple>
</inset>
