<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:gearhead="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/pause_icon"
        android:drawable="@drawable/ic_pause_deprecated"
        gearhead:state_pause="true"/>
    <item
        android:id="@+id/stop_icon"
        android:drawable="@drawable/ic_stop_deprecated"
        gearhead:state_stop="true"/>
    <item
        android:id="@+id/play_icon"
        android:drawable="@drawable/ic_play_deprecated"
        gearhead:state_play="true"/>
    <item
        android:drawable="@drawable/ic_play_arrow_off"
        gearhead:state_disabled="true"/>
    <item
        android:id="@+id/default_play_button"
        android:drawable="@drawable/ic_play_deprecated"/>
    <transition
        android:drawable="@drawable/ic_playpause_animation_deprecated"
        android:toId="@+id/pause_icon"
        android:fromId="@+id/play_icon"/>
    <transition
        android:drawable="@drawable/ic_pauseplay_animation_deprecated"
        android:toId="@+id/play_icon"
        android:fromId="@+id/pause_icon"/>
    <transition
        android:drawable="@drawable/ic_stopplay_animation_deprecated"
        android:toId="@+id/play_icon"
        android:fromId="@+id/stop_icon"/>
    <transition
        android:drawable="@drawable/ic_playstop_animation_deprecated"
        android:toId="@+id/stop_icon"
        android:fromId="@+id/play_icon"/>
    <transition
        android:drawable="@drawable/ic_playpause_animation_deprecated"
        android:toId="@+id/pause_icon"
        android:fromId="@+id/default_play_button"/>
    <transition
        android:drawable="@drawable/ic_pauseplay_animation_deprecated"
        android:toId="@+id/default_play_button"
        android:fromId="@+id/pause_icon"/>
    <transition
        android:drawable="@drawable/ic_stopplay_animation_deprecated"
        android:toId="@+id/default_play_button"
        android:fromId="@+id/stop_icon"/>
    <transition
        android:drawable="@drawable/ic_playstop_animation_deprecated"
        android:toId="@+id/stop_icon"
        android:fromId="@+id/default_play_button"/>
</animated-selector>
