<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_window_focused="true"
        android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/gearhead_common_stream_focus_ring_corner_radius"/>
            <stroke
                android:width="@dimen/gearhead_card_focus_ring_stroke_width_hovered"
                android:color="@color/gearhead_focus_light_blue"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_window_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/gearhead_common_stream_focus_ring_corner_radius"/>
            <stroke
                android:width="@dimen/gearhead_card_focus_ring_stroke_width_focused"
                android:color="@color/gearhead_focus_light_blue"/>
        </shape>
    </item>
</selector>
