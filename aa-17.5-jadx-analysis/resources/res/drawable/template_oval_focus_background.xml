<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/templateRippleColor">
    <item
        android:gravity="center"
        android:id="@android:id/mask">
        <inset android:inset="@dimen/template_focus_oval_ripple_inset">
            <shape android:shape="oval">
                <solid android:color="@color/template_ripple_color_selector"/>
            </shape>
        </inset>
    </item>
    <item>
        <selector>
            <item
                android:state_window_focused="true"
                android:state_hovered="true">
                <shape android:shape="oval">
                    <stroke
                        android:width="?attr/templateFocusStrokeWidthHovered"
                        android:color="?attr/templateFocusAccentColor"/>
                </shape>
            </item>
            <item
                android:state_focused="true"
                android:state_window_focused="true">
                <shape android:shape="oval">
                    <stroke
                        android:width="?attr/templateFocusStrokeWidthFocused"
                        android:color="?attr/templateFocusAccentColor"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
