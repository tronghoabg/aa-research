                <bitmap android:src="0x7f080151"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080152"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080153"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080154"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080155"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080156"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080157"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080158"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f080159"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f08015a"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f08015b"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f08015c"/>
            </item>
        </animation-list>
    </transition>
    <transition
        android:toId="@+id/off"
        android:fromId="@+id/on">
        <animation-list>
            <item android:duration="15">
                <bitmap android:src="0x7f08013d"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f08013e"/>
            </item>
            <item android:duration="15">
                <bitmap android:src="0x7f08013f"/>
            </item>
            <item android:duration="15">
