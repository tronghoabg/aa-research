<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/gearhead_sdk_controller_ripple_night">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/boardwalk_elevation2"/>
            <corners android:radius="?attr/gearheadListItemCornerRadius"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/gearhead_controller_ripple_color_selector"/>
            <corners android:radius="?attr/gearheadListItemCornerRadius"/>
        </shape>
    </item>
    <item>
        <selector>
            <item
                android:state_window_focused="true"
                android:state_hovered="true">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/gearhead_focus_ring_stroke_width_hovered"
                        android:color="?attr/gearheadFocusAccentColor"/>
                    <corners android:radius="?attr/gearheadListItemCornerRadius"/>
                </shape>
            </item>
            <item
                android:state_focused="true"
                android:state_window_focused="true">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/gearhead_focus_ring_stroke_width_focused"
                        android:color="?attr/gearheadFocusAccentColor"/>
                    <corners android:radius="?attr/gearheadListItemCornerRadius"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
