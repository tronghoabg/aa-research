<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:state_window_focused="true">
        <ripple android:color="@color/gearhead_sdk_controller_ripple">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gearhead_controller_ripple_color_selector"/>
                    <corners android:radius="@dimen/gearhead_button_corner_radius"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple
            android:color="@color/gearhead_sdk_controller_ripple"
            android:radius="@dimen/seek_bar_ripple_radius"/>
    </item>
</selector>
