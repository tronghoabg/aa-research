<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:height="?attr/templateTabIconlessFocusRingHeight">
        <ripple android:color="?attr/templateRippleColor">
            <item
                android:gravity="center"
                android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="?attr/templateTabIndicatorRadius"/>
                    <solid android:color="@color/material_tab_ripple_color_selector"/>
                </shape>
            </item>
            <item>
                <selector>
                    <item
                        android:state_window_focused="true"
                        android:state_hovered="true">
                        <shape android:shape="rectangle">
                            <corners android:radius="?attr/templateTabIndicatorRadius"/>
                            <stroke
                                android:width="@dimen/template_focus_ring_stroke_width_hovered"
                                android:color="?attr/templateFocusAccentColor"/>
                        </shape>
                    </item>
                    <item
                        android:state_focused="true"
                        android:state_window_focused="true">
                        <shape android:shape="rectangle">
                            <corners android:radius="?attr/templateTabIndicatorRadius"/>
                            <stroke
                                android:width="@dimen/template_focus_ring_stroke_width_focused"
                                android:color="?attr/templateFocusAccentColor"/>
                        </shape>
                    </item>
                </selector>
            </item>
        </ripple>
    </item>
</layer-list>
