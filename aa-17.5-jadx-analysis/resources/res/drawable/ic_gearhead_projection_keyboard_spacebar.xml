<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset
            android:insetLeft="@dimen/projection_keyboard_spacebar_horizontal_margin"
            android:insetRight="@dimen/projection_keyboard_spacebar_horizontal_margin"
            android:insetTop="@dimen/projection_keyboard_spacebar_vertical_margin"
            android:insetBottom="@dimen/projection_keyboard_spacebar_vertical_margin">
            <shape android:shape="rectangle">
                <size
                    android:height="@dimen/projection_keyboard_spacebar_visual_height"
                    android:width="@dimen/projection_keyboard_spacebar_visual_width"/>
                <corners android:radius="@dimen/projection_keyboard_spacebar_rounding"/>
                <solid android:color="?attr/gearheadImeSpacebarColor"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="@dimen/projection_keyboard_spacebar_horizontal_margin"
            android:insetRight="@dimen/projection_keyboard_spacebar_horizontal_margin"
            android:insetTop="@dimen/projection_keyboard_spacebar_vertical_margin"
            android:insetBottom="@dimen/projection_keyboard_spacebar_vertical_margin">
            <shape android:shape="rectangle">
                <size
                    android:height="@dimen/projection_keyboard_spacebar_visual_height"
                    android:width="@dimen/projection_keyboard_spacebar_visual_width"/>
                <corners android:radius="@dimen/projection_keyboard_spacebar_rounding"/>
                <solid android:color="?attr/gearheadImeSpacebarPressedColor"/>
            </shape>
        </inset>
    </item>
</selector>
