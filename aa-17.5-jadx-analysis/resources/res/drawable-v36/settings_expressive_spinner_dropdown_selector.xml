            <shape android:shape="rectangle">
                <solid android:color="@android:color/white"/>
                <corners android:radius="@dimen/settingslib_expressive_radius_large2"/>
            </shape>
        </item>
    </ripple>
</com.google.android.material.focus.FocusRingDrawable>
