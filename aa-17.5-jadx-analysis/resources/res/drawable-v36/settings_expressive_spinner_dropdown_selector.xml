<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.focus.FocusRingDrawable xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    app:focusRingsEnabled="true"
    app:focusRingsInnerStrokeColor="@color/settingslib_materialColorOnSecondary"
    app:focusRingsOuterStrokeColor="@color/settingslib_materialColorSecondary">
    <ripple android:color="@color/settingslib_preference_ripple_color">
