<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/pl_bg_pill_surface"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:elevation="8dp"
    android:paddingHorizontal="18dp">
    <ImageButton
        android:id="@+id/pl_btn_prev"
        android:background="@drawable/pl_bg_pill_neutral"
        android:layout_width="@dimen/pl_touch_min"
        android:layout_height="@dimen/pl_touch_min"
        android:src="@drawable/pl_ic_skip_back"
        android:tint="@color/pl_text"
        android:contentDescription="@string/pl_prev_video"/>
    <ImageButton
        android:id="@+id/pl_btn_play"
        android:background="@drawable/pl_bg_pill_accent"
        android:layout_width="@dimen/pl_btn_play"
        android:layout_height="@dimen/pl_btn_play"
        android:src="@drawable/pl_ic_pause"
        android:tint="@color/pl_bg"
        android:contentDescription="@string/pl_play"
        android:layout_marginStart="14dp"/>
    <ImageButton
        android:id="@+id/pl_btn_next"
        android:background="@drawable/pl_bg_pill_neutral"
        android:layout_width="@dimen/pl_touch_min"
        android:layout_height="@dimen/pl_touch_min"
        android:src="@drawable/pl_ic_skip_forward"
        android:tint="@color/pl_text"
        android:contentDescription="@string/pl_next_video"
        android:layout_marginStart="14dp"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="14dp">
        <ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/pl_progress"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="1000"
            android:progressDrawable="@drawable/pl_progress_pill"
            style="?android:attr/progressBarStyleHorizontal"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/pl_progress_knob"
            android:background="@drawable/pl_bg_knob"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <com.carstream.tech.car.player.SeekArea
            android:id="@+id/pl_progress_touch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/pl_neutral_700"
        android:id="@+id/pl_text_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/pl_accent2_800"
        android:gravity="center"
        android:id="@+id/pl_chip_quality"
        android:background="@drawable/pl_bg_pill_accent_tint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/pl_touch_min"
        android:text="@string/pl_quality"
        android:layout_marginStart="14dp"
        android:paddingHorizontal="22dp"/>
    <ImageButton
        android:id="@+id/pl_btn_cc"
        android:background="@drawable/pl_bg_pill_accent2"
        android:layout_width="@dimen/pl_touch_min"
        android:layout_height="@dimen/pl_touch_min"
        android:src="@drawable/pl_ic_captions"
        android:tint="@color/pl_bg"
        android:contentDescription="@string/pl_captions"
        android:layout_marginStart="10dp"/>
    <ImageButton
        android:id="@+id/pl_btn_pip"
        android:background="@drawable/pl_bg_pill_neutral"
        android:layout_width="@dimen/pl_touch_min"
        android:layout_height="@dimen/pl_touch_min"
        android:src="@drawable/pl_ic_pip"
        android:tint="@color/pl_text"
        android:contentDescription="@string/pl_pip"
        android:layout_marginStart="10dp"/>
    <ImageButton
        android:id="@+id/pl_btn_fullscreen"
        android:background="@drawable/pl_bg_pill_neutral"
        android:padding="18dp"
        android:layout_width="@dimen/pl_touch_min"
        android:layout_height="@dimen/pl_touch_min"
        android:src="@drawable/ic_fullscreen_exit"
        android:tint="@color/pl_text"
        android:contentDescription="@string/pl_fullscreen"
        android:layout_marginStart="10dp"/>
</LinearLayout>
