<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/pl_on_dark"
        android:layout_gravity="end|bottom"
        android:id="@+id/pl_text_caption"
        android:background="@drawable/pl_bg_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:maxWidth="360dp"
        android:textAlignment="center"
        android:layout_marginEnd="@dimen/pl_gutter"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"/>
    <LinearLayout
        android:layout_gravity="start|bottom"
        android:orientation="vertical"
        android:background="@drawable/pl_bg_surface_card"
        android:padding="26dp"
        android:layout_width="@dimen/pl_card_w"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:elevation="12dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/pl_accent_700"
            android:id="@+id/pl_text_now_playing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:letterSpacing="0.14"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/pl_text"
            android:ellipsize="end"
            android:id="@+id/pl_text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxLines="2"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/pl_neutral_700"
            android:ellipsize="end"
            android:id="@+id/pl_text_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxLines="1"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="20dp">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/pl_progress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="1000"
                android:progressDrawable="@drawable/pl_progress_track"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.carstream.tech.car.player.SeekArea
                android:id="@+id/pl_progress_touch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/pl_neutral_700"
            android:id="@+id/pl_text_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageButton
                android:id="@+id/pl_btn_prev"
                android:background="@drawable/pl_bg_pill_outline"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/pl_ic_skip_back"
                android:tint="@color/pl_text"
                android:contentDescription="@string/pl_prev_video"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/pl_btn_play"
                android:background="@drawable/pl_bg_pill_accent"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/pl_ic_pause"
                    android:tint="@color/pl_bg"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pl_bg"
                    android:id="@+id/pl_text_play_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/pl_btn_next"
                android:background="@drawable/pl_bg_pill_outline"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/pl_ic_skip_forward"
                android:tint="@color/pl_text"
                android:contentDescription="@string/pl_next_video"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/pl_accent2_800"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/pl_chip_quality"
                android:background="@drawable/pl_bg_pill_accent_tint"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingHorizontal="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/pl_bg"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/pl_chip_cc"
                android:background="@drawable/pl_bg_pill_accent2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="10dp"/>
            <ImageButton
                android:id="@+id/pl_chip_pip"
                android:background="@drawable/pl_bg_pill_neutral"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/pl_ic_pip"
                android:tint="@color/pl_text"
                android:contentDescription="@string/pl_pip"
                android:layout_marginStart="6dp"/>
            <ImageButton
                android:id="@+id/pl_btn_fullscreen"
                android:background="@drawable/pl_bg_pill_neutral"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/pl_ic_fullscreen"
                android:tint="@color/pl_text"
                android:contentDescription="@string/pl_fullscreen"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
