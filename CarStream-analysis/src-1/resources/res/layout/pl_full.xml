<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/pl_frame_pip"
        android:background="@drawable/pl_bg_surface_card"
        android:visibility="gone"
        android:layout_width="@dimen/pl_pip_w"
        android:layout_height="@dimen/pl_pip_h"
        android:layout_marginTop="96dp"
        android:layout_marginStart="@dimen/pl_gutter"
        android:backgroundTint="@color/pl_neutral_900"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/pl_scrim_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="30dp"
        android:paddingVertical="26dp">
        <TextView
            android:textSize="19sp"
            android:textColor="@color/pl_on_dark"
            android:ellipsize="end"
            android:id="@+id/pl_text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/pl_on_dark_62"
            android:ellipsize="end"
            android:id="@+id/pl_text_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="14dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/pl_on_dark"
            android:gravity="center"
            android:id="@+id/pl_chip_quality"
            android:background="@drawable/pl_bg_pill_on_dark"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="14dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/pl_on_dark"
            android:gravity="center"
            android:id="@+id/pl_chip_cc"
            android:background="@drawable/pl_bg_pill_on_dark"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="14dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/pl_text_caption"
        android:textColor="@color/pl_on_dark"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pl_text_caption"
        android:background="@drawable/pl_bg_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="158dp"
        android:maxWidth="620dp"
        android:textAlignment="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/pl_card_up_next"
        android:background="@drawable/pl_bg_surface_card"
        android:padding="18dp"
        android:visibility="gone"
        android:layout_width="352dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="130dp"
        android:layout_marginEnd="@dimen/pl_gutter">
        <ImageView
            android:id="@+id/pl_image_up_next"
            android:background="@color/pl_accent2_100"
            android:layout_width="104dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/pl_accent_700"
                android:id="@+id/pl_text_up_next_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.12"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/pl_text"
                android:id="@+id/pl_text_up_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/pl_neutral_700"
                android:id="@+id/pl_text_up_next_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/pl_btn_up_next_dismiss"
            android:background="@drawable/pl_bg_pill_neutral"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/pl_ic_close"
            android:tint="@color/pl_neutral_700"
            android:contentDescription="@string/pl_pause"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/pl_scrim_bottom"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/pl_gutter">
        <com.carstream.tech.car.player.ChapterBarView
            android:id="@+id/pl_chapter_bar"
            android:layout_width="match_parent"
            android:layout_height="22dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <ImageButton
                android:id="@+id/pl_btn_prev"
                android:background="@drawable/pl_bg_pill_on_dark"
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min"
                android:src="@drawable/pl_ic_skip_back"
                android:tint="@color/pl_on_dark"
                android:contentDescription="@string/pl_prev_video"/>
            <ImageButton
                android:id="@+id/pl_btn_play"
                android:background="@drawable/pl_bg_pill_accent"
                android:layout_width="@dimen/pl_btn_play"
                android:layout_height="@dimen/pl_btn_play"
                android:src="@drawable/pl_ic_pause"
                android:tint="@color/pl_bg"
                android:contentDescription="@string/pl_play"
                android:layout_marginStart="12dp"/>
            <ImageButton
                android:id="@+id/pl_btn_next"
                android:background="@drawable/pl_bg_pill_on_dark"
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min"
                android:src="@drawable/pl_ic_skip_forward"
                android:tint="@color/pl_on_dark"
                android:contentDescription="@string/pl_next_video"
                android:layout_marginStart="12dp"/>
            <ImageButton
                android:id="@+id/pl_btn_mute"
                android:background="@drawable/pl_bg_pill_ghost"
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min"
                android:src="@drawable/pl_ic_volume"
                android:tint="@color/pl_on_dark"
                android:contentDescription="@string/pl_mute"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="@dimen/pl_text_body"
                android:textColor="@color/pl_on_dark_62"
                android:id="@+id/pl_text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/pl_on_dark_62"
                android:id="@+id/pl_text_chapter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <FrameLayout
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min">
                <ImageButton
                    android:id="@+id/pl_btn_cc"
                    android:background="@drawable/pl_bg_pill_ghost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/pl_ic_captions"
                    android:tint="@color/pl_on_dark"
                    android:contentDescription="@string/pl_captions"/>
                <View
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/pl_cc_underline"
                    android:background="@color/pl_accent_300"
                    android:layout_width="18dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="9dp"/>
            </FrameLayout>
            <ImageButton
                android:id="@+id/pl_btn_settings"
                android:background="@drawable/pl_bg_pill_ghost"
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min"
                android:src="@drawable/pl_ic_settings"
                android:tint="@color/pl_on_dark"
                android:contentDescription="@string/pl_settings"/>
            <ImageButton
                android:id="@+id/pl_btn_pip"
                android:background="@drawable/pl_bg_pill_ghost"
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min"
                android:src="@drawable/pl_ic_pip"
                android:tint="@color/pl_on_dark"
                android:contentDescription="@string/pl_pip"/>
            <ImageButton
                android:id="@+id/pl_btn_fullscreen"
                android:background="@drawable/pl_bg_pill_ghost"
                android:layout_width="@dimen/pl_touch_min"
                android:layout_height="@dimen/pl_touch_min"
                android:src="@drawable/pl_ic_fullscreen"
                android:tint="@color/pl_on_dark"
                android:contentDescription="@string/pl_fullscreen"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
